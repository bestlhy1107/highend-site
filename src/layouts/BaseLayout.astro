---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ConsultWidget from "../components/ConsultWidget.astro";
import { readSiteSettings } from "../lib/site-store";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "万禾留学",
  description = "高分出分 · 名师指导 · 留学申请一站式",
} = Astro.props as Props;

const site = await readSiteSettings();
const currentPath = Astro.url.pathname;
const bodyClass = currentPath === "/" ? "page-home" : "";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5f7" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class={bodyClass} data-path={currentPath}>
    <SiteHeader brand={site.companyName} currentPath={currentPath} />

    <div id="main">
      <slot />
    </div>

    <SiteFooter brand={site.companyName} />
    <ConsultWidget site={site} currentPath={currentPath} />
  </body>
</html>
