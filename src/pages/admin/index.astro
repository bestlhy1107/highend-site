---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { actions } from "astro:actions";

import { readSiteSettings } from "../../lib/site-store";
import { readTeachers } from "../../lib/teachers-store";
import { readServices } from "../../lib/services-store";
import { readExams } from "../../lib/exams-store";
import { readScores } from "../../lib/scores-store";
import { readLeads, type LeadRecord } from "../../lib/leads-store";
import { readStudyAbroadReviewQueue } from "../../lib/study-abroad-review-queue";
import { readStudyAbroadCatalogStats } from "../../lib/study-abroad-catalog-store";
import { readStudyAbroadCatalogSyncState } from "../../lib/study-abroad-catalog-sync";
import { getStudyAbroadSearchRuntimeStatus } from "../../lib/study-abroad-search";
import {
  readStudyAbroadAdmissionsCampaignCadence,
  readStudyAbroadAdmissionsCampaignCountryFocusTrend,
  readStudyAbroadAdmissionsCountryTargetPlans,
  readStudyAbroadAdmissionsCountryRecentActivity,
  readStudyAbroadAdmissionsCampaignCountryTrend,
  readStudyAbroadAdmissionsCampaignOutlook,
  readStudyAbroadAdmissionsCampaignSchedule,
  readStudyAbroadAdmissionsCampaignTrend,
} from "../../lib/study-abroad-admissions-sync";

const adminUser = await Astro.session?.get("adminUser");

if (!adminUser) {
  return Astro.redirect("/admin/login");
}

const site = await readSiteSettings();
const teachers = await readTeachers();
const services = await readServices();
const exams = await readExams();
const scores = await readScores();

let leads: LeadRecord[] = [];
let leadsError = "";

try {
  leads = await readLeads();
} catch (error) {
  console.error("[admin] Failed to read leads", error);
  leadsError =
    "咨询记录数据库连接失败，后台已暂时跳过线索读取。请检查生产环境 ASTRO_DB_APP_TOKEN / ASTRO_DB_REMOTE_URL 是否有效，并重启 PM2 更新环境变量。";
}

const schoolSearchQueue = await readStudyAbroadReviewQueue();
const studyAbroadCatalogStats = await readStudyAbroadCatalogStats();
const studyAbroadCatalogSyncState = await readStudyAbroadCatalogSyncState();
const studyAbroadSearchRuntime = getStudyAbroadSearchRuntimeStatus();
const studyAbroadCampaignOutlook = await readStudyAbroadAdmissionsCampaignOutlook({
  degree: "硕士",
});
const studyAbroadCampaignCadence = await readStudyAbroadAdmissionsCampaignCadence({
  degree: "硕士",
});
const studyAbroadCampaignSchedule = await readStudyAbroadAdmissionsCampaignSchedule({
  degree: "硕士",
});
const studyAbroadCampaignTrend = await readStudyAbroadAdmissionsCampaignTrend({
  degree: "硕士",
  days: 7,
});
const studyAbroadCampaignCountryTrend = await readStudyAbroadAdmissionsCampaignCountryTrend({
  degree: "硕士",
  days: 7,
});
const studyAbroadCampaignCountryFocusTrend =
  await readStudyAbroadAdmissionsCampaignCountryFocusTrend({
    degree: "硕士",
    days: 7,
    countryLimit: 3,
    focusLimit: 3,
  });
const studyAbroadCampaignCountryNames = Array.from(
  new Set([
    ...studyAbroadCampaignCountryTrend.countries.map((item) => item.country),
    ...studyAbroadCampaignCountryFocusTrend.countries.map((item) => item.country),
  ])
).filter(Boolean);
const studyAbroadCountryTargetPlans = await readStudyAbroadAdmissionsCountryTargetPlans({
  degree: "硕士",
  countries: studyAbroadCampaignCountryNames,
  limit: Math.max(studyAbroadCampaignCountryNames.length, 1),
  focusLimit: 6,
});
const studyAbroadCountryRecentActivity = await readStudyAbroadAdmissionsCountryRecentActivity({
  countries: studyAbroadCampaignCountryNames,
  limit: Math.max(studyAbroadCampaignCountryNames.length, 1),
});

const updateLeadResult = Astro.getActionResult(actions.updateLead);
const deleteLeadResult = Astro.getActionResult(actions.deleteLead);
const catalogSyncResult = Astro.getActionResult(actions.syncStudyAbroadCatalogSources);
const campaignCadenceResult = Astro.getActionResult(
  actions.executeStudyAbroadAdmissionsCampaignCadence
);
const countryTargetPlanResult = Astro.getActionResult(
  actions.executeStudyAbroadAdmissionsCountryTargetPlan
);
const admissionsSyncResult = Astro.getActionResult(actions.syncStudyAbroadAdmissionsSnapshots);

const updateLeadSuccess = updateLeadResult && !updateLeadResult.error ? updateLeadResult.data : null;
const deleteLeadSuccess = deleteLeadResult && !deleteLeadResult.error ? deleteLeadResult.data : null;
const catalogSyncSuccess =
  catalogSyncResult && !catalogSyncResult.error ? catalogSyncResult.data : null;
const campaignCadenceSuccess =
  campaignCadenceResult && !campaignCadenceResult.error ? campaignCadenceResult.data : null;
const countryTargetPlanSuccess =
  countryTargetPlanResult && !countryTargetPlanResult.error ? countryTargetPlanResult.data : null;
const admissionsSyncSuccess =
  admissionsSyncResult && !admissionsSyncResult.error ? admissionsSyncResult.data : null;

const STATUS_LABELS: Record<string, string> = {
  new: "未处理",
  contacted: "已联系",
  done: "已完成",
  invalid: "无效",
};

const APPOINTMENT_LABELS: Record<string, string> = {
  trial: "预约试听",
  consultation: "预约咨询",
};

const SOURCE_LABELS: Record<string, string> = {
  homepage: "官网首页",
  "school-finder": "选校页带入",
};

function normalizeLeadSource(value: string | null | undefined) {
  return String(value ?? "").trim() || "homepage";
}

function isSchoolFinderSummaryLead(lead: { source?: string; need?: string }) {
  const source = normalizeLeadSource(lead.source);
  const need = String(lead.need ?? "");
  return (
    source === "school-finder" ||
    need.includes("院校搜索咨询摘要") ||
    need.includes("搜索会话：") ||
    need.includes("一、当前搜索条件")
  );
}

function getLeadInsightTags(lead: { source?: string; need?: string }) {
  const tags: string[] = [];
  const source = normalizeLeadSource(lead.source);
  const need = String(lead.need ?? "");

  if (source === "school-finder") {
    tags.push("来自选校页");
  }

  if (isSchoolFinderSummaryLead(lead)) {
    tags.push("带搜索摘要");
  }

  if (need.includes("当前优先推荐项目")) {
    tags.push("含推荐项目");
  }

  if (need.includes("收藏学校：") || need.includes("收藏项目：")) {
    tags.push("含收藏偏好");
  }

  if (need.includes("当前对比项目：")) {
    tags.push("含项目对比");
  }

  return tags;
}

function startOfToday() {
  const now = new Date();
  return new Date(now.getFullYear(), now.getMonth(), now.getDate());
}

function startOfWeek() {
  const now = new Date();
  const day = now.getDay();
  const diff = day === 0 ? 6 : day - 1;
  const base = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  base.setDate(base.getDate() - diff);
  return base;
}

const todayStart = startOfToday();
const weekStart = startOfWeek();

const todayLeads = leads.filter((lead) => new Date(lead.createdAt) >= todayStart);
const weekLeads = leads.filter((lead) => new Date(lead.createdAt) >= weekStart);

const statusStats = {
  new: leads.filter((lead) => lead.status === "new").length,
  contacted: leads.filter((lead) => lead.status === "contacted").length,
  done: leads.filter((lead) => lead.status === "done").length,
  invalid: leads.filter((lead) => lead.status === "invalid").length,
};

const appointmentStatsMap = leads.reduce<Record<string, number>>((acc, lead) => {
  const key = lead.appointmentType || "consultation";
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});

const appointmentStats = Object.entries(appointmentStatsMap)
  .map(([key, count]) => ({
    key,
    label: APPOINTMENT_LABELS[key] ?? key,
    count,
  }))
  .sort((a, b) => b.count - a.count);

const examStatsMap = leads.reduce<Record<string, number>>((acc, lead) => {
  const key = (lead.examType || "未填写").trim() || "未填写";
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});

const examStats = Object.entries(examStatsMap)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

const latestLeads = leads.slice(0, 10);
const schoolFinderLeadCount = leads.filter((lead) => normalizeLeadSource(lead.source) === "school-finder").length;
const summaryLeadCount = leads.filter((lead) => isSchoolFinderSummaryLead(lead)).length;
const latestCatalogSyncRun = studyAbroadCatalogSyncState.runs[0] ?? null;
const latestCampaignRun = studyAbroadCampaignOutlook.recentRuns[0] ?? null;
const structuredCoveragePercent = studyAbroadCatalogStats.programCount
  ? Math.round(
      (studyAbroadCatalogStats.structuredAdmissionsCoverage /
        studyAbroadCatalogStats.programCount) *
        100
    )
  : 0;
const cadenceLabel =
  studyAbroadCampaignCadence.rhythm === "accelerate"
    ? "加速推进"
    : studyAbroadCampaignCadence.rhythm === "steady"
      ? "稳定补齐"
      : "精修收口";
const campaignModeLabel = (mode: string) => {
  if (mode === "roadmap") return "多轮批处理";
  if (mode === "sprint") return "单轮冲刺";
  return "留学补齐";
};
const maxTrendStructuredDelta = Math.max(
  1,
  ...studyAbroadCampaignTrend.days.map((day) => day.structuredDelta)
);
const maxCountryTrendStructuredDelta = Math.max(
  1,
  ...studyAbroadCampaignCountryTrend.countries.map((item) =>
    Math.max(item.structuredDelta, item.completeDelta)
  )
);
const countryFocusTrendMap = new Map(
  studyAbroadCampaignCountryFocusTrend.countries.map((item) => [item.country, item])
);
const countryTargetPlanMap = new Map(
  studyAbroadCountryTargetPlans.map((item) => [item.country, item])
);
const countryRecentActivityMap = new Map(
  studyAbroadCountryRecentActivity.map((item) => [item.country, item])
);
const countryTargetPlanRunMap = new Map(
  ((countryTargetPlanSuccess?.countryRuns as Array<{
    country: string;
    syncedCount?: number;
    okCount?: number;
    partialCount?: number;
    unavailableCount?: number;
  }>) ?? []).map((item) => [item.country, item])
);
const admissionsSyncFilters = admissionsSyncSuccess?.filters ?? {
  country: "",
  major: "",
  specialization: "",
};
const admissionsSyncCountry = String(admissionsSyncFilters.country ?? "").trim();
const admissionsSyncMajor = String(admissionsSyncFilters.major ?? "").trim();
const admissionsSyncSpecialization = String(admissionsSyncFilters.specialization ?? "").trim();
const activeCampaignCountry =
  Array.from(countryTargetPlanRunMap.keys())[0] ||
  admissionsSyncCountry ||
  "";
const focusMatchesSync = (focus: { country?: string; major?: string; specialization?: string }) => {
  const focusCountry = String(focus.country ?? "").trim();
  const focusMajor = String(focus.major ?? "").trim();
  const focusSpecialization = String(focus.specialization ?? "").trim();

  if (!admissionsSyncCountry || focusCountry !== admissionsSyncCountry) return false;
  if (admissionsSyncMajor && focusMajor !== admissionsSyncMajor) return false;
  if (admissionsSyncSpecialization && focusSpecialization !== admissionsSyncSpecialization) {
    return false;
  }
  return true;
};
const campaignCountryDrilldowns = studyAbroadCampaignCountryTrend.countries.map((countryTrend) => ({
  ...countryTrend,
  focusTrend: countryFocusTrendMap.get(countryTrend.country) ?? null,
  targetPlan: countryTargetPlanMap.get(countryTrend.country) ?? null,
  recentActivity: countryRecentActivityMap.get(countryTrend.country) ?? null,
})).map((item) => {
  const targetPlan = item.targetPlan;
  const displayFocusRecommendations = targetPlan?.focusRecommendations?.length
    ? (() => {
        const freshDeferrals = targetPlan.focusRecommendations.filter(
          (focus) => focus.coolingDown
        );
        return {
          items: targetPlan.focusRecommendations.slice(0, 6),
          deferredCount: freshDeferrals.length,
        };
      })()
    : { items: [], deferredCount: 0 };

  return {
    ...item,
    displayFocusRecommendations,
  };
});
---

<BaseLayout title="管理员后台" description="后台总览">
  <main class="container page">
    <div class="section-head">
      <div>
        <div class="section-kicker">Admin Dashboard</div>
        <h1 class="section-title">管理员后台</h1>
        <p class="section-desc">
          当前登录账号：{adminUser.username}
        </p>
      </div>

      <form method="POST" action={actions.adminLogout}>
        <button class="btn btn-ghost" type="submit">退出登录</button>
      </form>
    </div>

    {leadsError && (
      <div class="contact-notice mt-4">
        {leadsError}
      </div>
    )}

    <div class="cards cards--3 mt-4">
      <a class="card card--hover" href="/admin/settings">
        <div class="card-top">
          <div class="h3">站点设置</div>
          <span class="badge">Site</span>
        </div>
        <p class="muted mt-2">修改公司名称、联系方式，以及右下角咨询浮窗老师信息和文案。</p>
        <div class="card-cta">进入设置 →</div>
      </a>

      <a class="card card--hover" href="/admin/teachers">
        <div class="card-top">
          <div class="h3">老师管理</div>
          <span class="badge">{teachers.length}</span>
        </div>
        <p class="muted mt-2">新增、修改、删除老师，并上传老师图片。</p>
        <div class="card-cta">进入管理 →</div>
      </a>

      <a class="card card--hover" href="/admin/services">
        <div class="card-top">
          <div class="h3">服务管理</div>
          <span class="badge">{services.length}</span>
        </div>
        <p class="muted mt-2">新增、修改、删除服务，并上传服务图片。</p>
        <div class="card-cta">进入管理 →</div>
      </a>

      <a class="card card--hover" href="/admin/exams">
        <div class="card-top">
          <div class="h3">考试管理</div>
          <span class="badge">{exams.length}</span>
        </div>
        <p class="muted mt-2">新增、修改、删除考试，维护考试详情页内容。</p>
        <div class="card-cta">进入管理 →</div>
      </a>

      <a class="card card--hover" href="/admin/scores">
        <div class="card-top">
          <div class="h3">出分管理</div>
          <span class="badge">{scores.length}</span>
        </div>
        <p class="muted mt-2">新增、修改、删除出分展示，并上传案例图片。</p>
        <div class="card-cta">进入管理 →</div>
      </a>

      <a class="card card--hover" href="#leads">
        <div class="card-top">
          <div class="h3">咨询管理</div>
          <span class="badge">{leads.length}</span>
        </div>
        <p class="muted mt-2">修改咨询状态、填写备注、删除无效记录。</p>
        <div class="card-cta">查看管理 ↓</div>
      </a>

      <a class="card card--hover" href="/admin/school-search#pending-review-candidates">
        <div class="card-top">
          <div class="h3">选校候选</div>
          <span class="badge">{schoolSearchQueue.filter((item) => item.status === "pending").length}</span>
        </div>
        <p class="muted mt-2">查看搜索器补抓到的候选官网页，作为后续人工核验线索。</p>
        <div class="card-cta">查看候选 →</div>
      </a>

      <a class="card card--hover" href="/admin/school-search#runtime-acceptance-report">
        <div class="card-top">
          <div class="h3">全网扩搜状态</div>
          <span class="badge">
            {studyAbroadSearchRuntime.externalSearchEnabled ? "已启用" : "未启用"}
          </span>
        </div>
        <p class="muted mt-2">
          {studyAbroadSearchRuntime.externalSearchEnabled
            ? `当前使用 ${studyAbroadSearchRuntime.provider}，候选上限 ${studyAbroadSearchRuntime.maxCandidateResults} 条。`
            : "当前还没配扩搜 API，前台只能靠已核验项目库返回结果。"}
        </p>
        <div class="card-cta">查看治理 →</div>
      </a>

      <a class="card card--hover" href="/admin/study-abroad-catalog">
        <div class="card-top">
          <div class="h3">留学底库</div>
          <span class="badge">{studyAbroadCatalogStats.universityCount}</span>
        </div>
        <p class="muted mt-2">查看大学底库、项目底库和可接入的数据源清单，规划大规模选校检索。</p>
        <div class="card-cta">查看底库 →</div>
      </a>

      <a class="card card--hover" href="/">
        <div class="card-top">
          <div class="h3">返回前台</div>
          <span class="badge">Home</span>
        </div>
        <p class="muted mt-2">回到官网首页查看最新前台展示效果。</p>
        <div class="card-cta">打开首页 →</div>
      </a>
    </div>

    <section class="mt-8">
      <div class="section-head">
        <div>
          <div class="section-kicker">Admissions Campaign</div>
          <h2 class="section-title">留学门槛补齐进度</h2>
          <p class="section-desc">这里看最近自动补齐跑得怎么样，以及系统当前建议的推进节奏。</p>
        </div>
      </div>

      {campaignCadenceSuccess && (
        <div class="contact-notice contact-notice--success mt-4">
          {campaignCadenceSuccess.message}
        </div>
      )}
      {countryTargetPlanSuccess && (
        <div class="contact-notice contact-notice--success mt-4">
          {countryTargetPlanSuccess.message}
        </div>
      )}
      {admissionsSyncSuccess && (
        <div class="contact-notice contact-notice--success mt-4">
          {admissionsSyncSuccess.message}
        </div>
      )}
      {catalogSyncSuccess && (
        <div class="contact-notice contact-notice--success mt-4">
          {catalogSyncSuccess.message}
        </div>
      )}

      <div class="cards cards--3 mt-4">
        <div class="card">
          <div class="muted text-sm">当前结构化门槛覆盖</div>
          <div class="h2 mt-2">{structuredCoveragePercent}%</div>
          <div class="muted mt-2">
            重点国家目标线 {studyAbroadCampaignOutlook.goal.targetCoveragePercent}% ，当前还差 {studyAbroadCampaignOutlook.goal.remainingStructuredPrograms} 个结构化门槛项目。
          </div>
        </div>

        <div class="card">
          <div class="muted text-sm">系统推荐节奏</div>
          <div class="h2 mt-2">{cadenceLabel}</div>
          <div class="muted mt-2">
            建议每周推进 {studyAbroadCampaignCadence.suggestedRunsPerWeek} 次，每次 {studyAbroadCampaignCadence.rounds} 轮。
          </div>
        </div>

        <div class="card">
          <div class="muted text-sm">预计还需轮次</div>
          <div class="h2 mt-2">{studyAbroadCampaignOutlook.estimatedRunsToTarget ?? "待起量"}</div>
          <div class="muted mt-2">{studyAbroadCampaignOutlook.summary}</div>
        </div>

        <div class="card">
          <div class="muted text-sm">建议下次自动运行</div>
          <div class="h2 mt-2">{studyAbroadCampaignSchedule.nextRunLabel}</div>
          <div class="muted mt-2">
            {studyAbroadCampaignSchedule.frequencyLabel} · 命令：<code>{studyAbroadCampaignSchedule.command}</code>
          </div>
        </div>
      </div>

      <div class="cards cards--2 mt-6">
        <div class="card">
          <div class="h3">最近一次补齐结果</div>

          {latestCampaignRun ? (
            <div class="mt-4">
              <div><strong>模式：</strong>{campaignModeLabel(latestCampaignRun.mode)}</div>
              <div class="mt-2"><strong>时间：</strong>{latestCampaignRun.runAt.replace("T", " ").slice(0, 16)}</div>
              <div class="mt-2"><strong>轮次：</strong>{latestCampaignRun.rounds}</div>
              <div class="mt-2"><strong>同步项目：</strong>{latestCampaignRun.syncedCount}</div>
              <div class="mt-2"><strong>结构化门槛新增：</strong>{latestCampaignRun.structuredDelta}</div>
              <div class="mt-2"><strong>完整门槛新增：</strong>{latestCampaignRun.completeDelta}</div>
              <div class="mt-2"><strong>覆盖国家：</strong>{latestCampaignRun.countries.join(" / ") || "待补"}</div>
            </div>
          ) : (
            <p class="muted mt-3">还没有长期补齐记录，先从留学底库页跑一轮推荐节奏。</p>
          )}

          <div class="mt-4">
            <a class="btn btn-ghost" href="/admin/study-abroad-catalog">打开留学底库 →</a>
          </div>
        </div>

        <div class="card">
          <div class="h3">自动化入口</div>
          <div class="muted mt-3">
            后台现在已经有统一命令入口，后面无论是手动跑还是挂自动任务，都走同一条链路。
          </div>
          <div class="mt-3"><strong>命令：</strong><code>npm run study-abroad:campaign -- --mode=cadence</code></div>
          <div class="mt-2 muted">
            它会按系统当前推荐节奏自动选择轮次、国家数量和重点方向，不会机械重复上一轮。
          </div>
          <form method="POST" action={actions.executeStudyAbroadAdmissionsCampaignCadence} class="mt-4">
            <input type="hidden" name="degree" value="硕士" />
            <button class="btn" type="submit">按推荐节奏立即执行</button>
          </form>
          <div class="mt-4">
            <a class="btn btn-ghost" href="/admin/study-abroad-catalog">查看节奏面板 →</a>
          </div>
        </div>
      </div>

      <div class="cards cards--2 mt-6">
        <div class="card">
          <div class="card-top">
            <div class="h3">最近底库同步</div>
            <span class="badge">Catalog</span>
          </div>

          {latestCatalogSyncRun ? (
            <div class="mt-4">
              <div><strong>时间：</strong>{latestCatalogSyncRun.runAt.replace("T", " ").slice(0, 16)}</div>
              <div class="mt-2">
                <strong>来源：</strong>
                {latestCatalogSyncRun.trigger === "automation"
                  ? "自动任务"
                  : latestCatalogSyncRun.trigger === "script"
                    ? "脚本"
                    : "后台手动"}
              </div>
              <div class="mt-2">
                <strong>净增：</strong>学校{" "}
                {latestCatalogSyncRun.delta.universityCount >= 0 ? "+" : ""}
                {latestCatalogSyncRun.delta.universityCount} · 项目{" "}
                {latestCatalogSyncRun.delta.programCount >= 0 ? "+" : ""}
                {latestCatalogSyncRun.delta.programCount} · 国家{" "}
                {latestCatalogSyncRun.delta.countryCount >= 0 ? "+" : ""}
                {latestCatalogSyncRun.delta.countryCount}
              </div>
              <div class="muted mt-3">{latestCatalogSyncRun.message}</div>
              <div class="catalog-queue-grid mt-4">
                {latestCatalogSyncRun.sourceRuns.map((sourceRun) => (
                  <div class="catalog-queue-item">
                    <div class="card-top">
                      <div class="h3">{sourceRun.label}</div>
                      <span class="badge">
                        {sourceRun.metrics.skipped === true
                          ? "安全跳过"
                          : sourceRun.ok
                            ? "成功"
                            : "失败"}
                      </span>
                    </div>
                    <div class="muted mt-2">{sourceRun.message}</div>
                  </div>
                ))}
              </div>
            </div>
