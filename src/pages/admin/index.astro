    <script is:inline>
      (() => {
        const storageKey = "study-abroad-admin-sort-mode";
        const modeMeta = {
          recommendation: {
            attr: "data-sort-recommendation",
            hint: "综合推荐会把缺口、优先级和冷却一起算进去，适合日常默认判断。",
          },
          gap: {
            attr: "data-sort-gap",
            hint: "缺口最大只看补齐空间，适合短期把覆盖率往上推。",
          },
          stale: {
            attr: "data-sort-stale",
            hint: "最久未补会优先露出很久没动过、或从未动过的方向。",
          },
        };

        const readSavedMode = () => {
          try {
            const value = window.localStorage.getItem(storageKey) || "";
            return value in modeMeta ? value : "recommendation";
          } catch {
            return "recommendation";
          }
        };

        const writeSavedMode = (mode) => {
          try {
            window.localStorage.setItem(storageKey, mode);
          } catch {}
        };

        const sortBlocks = Array.from(
          document.querySelectorAll("[data-sort-toolbar]")
        )
          .map((toolbar) => {
            const list =
              toolbar.parentElement?.querySelector("[data-sort-list]") ||
              toolbar.parentElement;
            const buttons = Array.from(toolbar.querySelectorAll("[data-sort-mode]"));
            const hint = toolbar.querySelector("[data-sort-hint]");
            if (!(list instanceof HTMLElement) || !buttons.length) return null;
            return { toolbar, list, buttons, hint };
          })
          .filter(Boolean);

        const applyMode = (mode) => {
          const safeMode = mode in modeMeta ? mode : "recommendation";
          const meta = modeMeta[safeMode] || modeMeta.recommendation;

          sortBlocks.forEach((block) => {
            const items = Array.from(block.list.querySelectorAll("[data-sort-item]"));
            items.sort((left, right) => {
              const rightValue = Number(right.getAttribute(meta.attr) || 0);
              const leftValue = Number(left.getAttribute(meta.attr) || 0);
              if (rightValue !== leftValue) return rightValue - leftValue;

              const rightFallback = Number(
                right.getAttribute("data-sort-recommendation") || 0
              );
              const leftFallback = Number(
                left.getAttribute("data-sort-recommendation") || 0
              );
              return rightFallback - leftFallback;
            });
            block.list.append(...items);
            block.buttons.forEach((button) => {
              button.classList.toggle(
                "is-active",
                button.getAttribute("data-sort-mode") === safeMode
              );
            });
            if (block.hint) {
              block.hint.textContent = meta.hint;
            }
          });

          writeSavedMode(safeMode);
        };

        sortBlocks.forEach((block) => {
          block.buttons.forEach((button) => {
            button.addEventListener("click", () => {
              applyMode(button.getAttribute("data-sort-mode") || "recommendation");
            });
          });
        });

        applyMode(readSavedMode());
      })();
    </script>

