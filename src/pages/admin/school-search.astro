    primaryEvalTrendQuery?.major ||
    primaryEvalTrendQuery?.specialization
);
const evalTrendAlerts =
  latestEvalSnapshot && previousEvalSnapshot
    ? [
        latestEvalSnapshot.passRate < previousEvalSnapshot.passRate
          ? {
              id: "pass-rate-drop",
              title: "评测通过率回落",
              severity: "优先处理",
              summary: `通过率从 ${previousEvalSnapshot.passRate}% 降到 ${latestEvalSnapshot.passRate}%，说明最近这轮搜索里有更多样例开始失手。`,
              suggestion: "先看自动治理任务，再优先处理本周补库榜单最靠前的方向。",
            }
          : null,
        latestEvalSnapshot.zeroResultCases > previousEvalSnapshot.zeroResultCases
          ? {
              id: "zero-results-up",
              title: "零结果样例增加",
              severity: "高优先级",
              summary: `零结果样例从 ${previousEvalSnapshot.zeroResultCases} 条升到 ${latestEvalSnapshot.zeroResultCases} 条，已经有查询完全搜不出来。`,
              suggestion: "优先补国家 / 学位 / 专业大类的正式项目池，再回头看细分方向是否过窄。",
            }
          : null,
        latestEvalSnapshot.lowResultCases > previousEvalSnapshot.lowResultCases
          ? {
              id: "low-results-up",
              title: "低结果样例增加",
              severity: "建议尽快处理",
              summary: `低结果样例从 ${previousEvalSnapshot.lowResultCases} 条升到 ${latestEvalSnapshot.lowResultCases} 条，说明返回量开始变薄。`,
              suggestion: "优先补厚正式项目，再补门槛，避免这些查询继续滑向零结果。",
            }
          : null,
        latestEvalSnapshot.averageUniversityCount < previousEvalSnapshot.averageUniversityCount
          ? {
              id: "university-pool-down",
              title: "平均学校池缩小",
              severity: "持续观察",
              summary: `平均学校池从 ${previousEvalSnapshot.averageUniversityCount} 所降到 ${latestEvalSnapshot.averageUniversityCount} 所，召回宽度在变窄。`,
              suggestion: "先看本周补库榜单，确认是不是某几个国家 / 专业方向的正式库在拖后腿。",
            }
          : null,
        latestEvalSnapshot.candidateHeavyCases > previousEvalSnapshot.candidateHeavyCases
          ? {
              id: "candidate-heavy-up",
              title: "候选主导样例增加",
              severity: "优先处理",
              summary: `候选主导样例从 ${previousEvalSnapshot.candidateHeavyCases} 条升到 ${latestEvalSnapshot.candidateHeavyCases} 条，说明正式库开始撑不住这类搜索。`,
              suggestion: "优先导入热门候选并补门槛，同时规避重复误命中的来源站点。",
            }
          : null,
        latestEvalSnapshot.postAvoidQualityRate < previousEvalSnapshot.postAvoidQualityRate
          ? {
              id: "post-avoid-quality-down",
              title: "规避后质量率下降",
              severity: "需要复盘",
              summary: `规避后质量率从 ${previousEvalSnapshot.postAvoidQualityRate}% 降到 ${latestEvalSnapshot.postAvoidQualityRate}%，说明坏来源或误命中变多。`,
              suggestion: "复查最近审核备注和高规避命中搜索，优先处理重复域名和低可信候选来源。",
            }
          : null,
        latestEvalSnapshot.postAvoidQualityRate > previousEvalSnapshot.postAvoidQualityRate &&
        latestEvalSnapshot.blockedResultRate <= previousEvalSnapshot.blockedResultRate
          ? {
              id: "post-avoid-quality-up",
              title: "规避后质量率提升",
              severity: "继续保持",
              summary: `规避后质量率从 ${previousEvalSnapshot.postAvoidQualityRate}% 提升到 ${latestEvalSnapshot.postAvoidQualityRate}%，低质来源占比正在下降。`,
              suggestion: "继续沿用当前规避规则，同时把高可信候选导入正式库，减少前台依赖候选结果。",
            }
          : null,
      ].filter(
        (
          item
        ): item is {
          id: string;
          title: string;
          severity: string;
          summary: string;
          suggestion: string;
        } => Boolean(item)
      )
    : [];
const evalExecutionPlan = evalGovernanceLeaderboard.slice(0, 5).map((item, index) => ({
  id: buildStudyAbroadSearchExecutionPlanId(item.query) || `${index + 1}:${item.label}`,
  rank: index + 1,
  label: item.label,
  query: item.query,
  stageLabel:
    item.criticalCount > 0 || item.zeroLikeCount > 0
      ? "第 1 优先级"
      : item.lowLikeCount > 0
        ? "第 2 优先级"
        : item.candidateHeavyCount > 0
          ? "第 3 优先级"
          : "持续观察",
  reason:
    item.zeroLikeCount > 0
      ? `这组方向已经出现 ${item.zeroLikeCount} 条零结果样例，优先级最高。`
      : item.lowLikeCount > 0
        ? `这组方向有 ${item.lowLikeCount} 条低结果样例，先补厚正式项目更划算。`
        : item.candidateHeavyCount > 0
          ? `这组方向已有 ${item.candidateHeavyCount} 条候选主导样例，正式库需要尽快接住。`
          : "这组方向暂时没有明显坏趋势，但值得持续补厚。",
  suggestion: item.suggestion,
})).map((item) => ({
  ...item,
  planRecord: executionPlanRecordById.get(item.id) || null,
}));
const activeExecutionPlanRecords = executionPlanRecords.filter((item) => !item.archivedAt);
const executionPlanPendingCount = evalExecutionPlan.filter(
  (item) => (item.planRecord?.status || "pending") === "pending"
).length;
const executionPlanInProgressCount = evalExecutionPlan.filter(
  (item) => item.planRecord?.status === "in_progress"
).length;
const executionPlanCompletedCount = evalExecutionPlan.filter(
  (item) => item.planRecord?.status === "completed"
).length;
const currentWeekStart = getStartOfWeek();
const executionPlanTouchedThisWeek = activeExecutionPlanRecords.filter((item) =>
  isWithinCurrentWeek(item.updatedAt, currentWeekStart)
);
const executionPlanCompletedThisWeek = activeExecutionPlanRecords
  .filter((item) => isWithinCurrentWeek(item.completedAt, currentWeekStart))
  .sort(
    (left, right) =>
      new Date(right.completedAt).getTime() - new Date(left.completedAt).getTime()
  )
  .slice(0, 5);
const executionPlanCompletedThisWeekCount = activeExecutionPlanRecords.filter((item) =>
  isWithinCurrentWeek(item.completedAt, currentWeekStart)
).length;
const executionPlanStartedThisWeek = activeExecutionPlanRecords.filter((item) =>
  isWithinCurrentWeek(item.startedAt, currentWeekStart)
);
const executionPlanCompletionRate = executionPlanStartedThisWeek.length
  ? Math.round((executionPlanCompletedThisWeekCount / executionPlanStartedThisWeek.length) * 100)
  : 0;
const executionPlanAverageProcessingDurationHours = (() => {
  const durations = activeExecutionPlanRecords
    .filter((item) => isWithinCurrentWeek(item.completedAt, currentWeekStart) && item.startedAt && item.completedAt)
    .map((item) => {
      const startedAt = new Date(item.startedAt).getTime();
      const completedAt = new Date(item.completedAt).getTime();
      if (!Number.isFinite(startedAt) || !Number.isFinite(completedAt) || completedAt < startedAt) {
        return null;
      }
      return (completedAt - startedAt) / (1000 * 60 * 60);
    })
    .filter((item): item is number => typeof item === "number");

  if (!durations.length) return 0;
  return durations.reduce((sum, value) => sum + value, 0) / durations.length;
})();
const executionPlanTopActions = Array.from(
  executionPlanTouchedThisWeek.reduce((map, item) => {
    const key = summarizeExecutionAction(item.lastActionSummary);
    if (!key) return map;

    const current =
      map.get(key) || {
        label: key,
        count: 0,
      };
    current.count += 1;
    map.set(key, current);
    return map;
  }, new Map<string, { label: string; count: number }>())
)
  .map(([, item]) => item)
  .sort((left, right) => right.count - left.count || left.label.localeCompare(right.label))
  .slice(0, 3);
const executionPlanAttentionItems = evalExecutionPlan
  .filter((item) => (item.planRecord?.status || "pending") !== "completed")
  .slice(0, 3);
const executionWeeklyPrimaryPlan = executionPlanAttentionItems[0] || null;
const executionWeeklySummary = buildWeeklyExecutionSummary({
  touchedCount: executionPlanTouchedThisWeek.length,
  completedCount: executionPlanCompletedThisWeek.length,
  attentionCount: executionPlanAttentionItems.length,
  topActionLabel: executionPlanTopActions[0]?.label,
  completedLabels: executionPlanCompletedThisWeek.map((item) => item.label),
  attentionLabels: executionPlanAttentionItems.map((item) => item.label),
  weakestCountryLabel: weakestEvalCountryLeader?.label,
  weakestMajorLabel: weakestEvalMajorLeader?.label,
});
const executionWeeklyPrimaryPendingEntry = executionWeeklyPrimaryPlan
  ? findPendingReviewEntryForQuery(normalizeGovernanceQuery(executionWeeklyPrimaryPlan.query))
  : null;
const executionWeeklyPrimaryPendingSummary = getPendingEntryBatchAvoidSummary(
  executionWeeklyPrimaryPendingEntry
);
const executionWeeklyRecommendations = buildWeeklyExecutionRecommendations({
  touchedCount: executionPlanTouchedThisWeek.length,
  completedCount: executionPlanCompletedThisWeek.length,
  attentionCount: executionPlanAttentionItems.length,
  topActionLabel: executionPlanTopActions[0]?.label,
  completedLabels: executionPlanCompletedThisWeek.map((item) => item.label),
  attentionLabels: executionPlanAttentionItems.map((item) => item.label),
  weakestCountryLabel: weakestEvalCountryLeader?.label,
  weakestMajorLabel: weakestEvalMajorLeader?.label,
  primaryPlan: executionWeeklyPrimaryPlan
    ? {
        id: executionWeeklyPrimaryPlan.id,
        label: executionWeeklyPrimaryPlan.label,
        query: executionWeeklyPrimaryPlan.query,
        pendingEntryId: executionWeeklyPrimaryPendingEntry?.id,
        batchImportHighCount: executionWeeklyPrimaryPendingSummary.highCount,
        batchImportHighMediumCount: executionWeeklyPrimaryPendingSummary.highMediumCount,
        batchAvoidWatchCount: executionWeeklyPrimaryPendingSummary.watchCount,
        batchAvoidWatchMediumCount: executionWeeklyPrimaryPendingSummary.watchMediumCount,
        status: executionWeeklyPrimaryPlan.planRecord?.status || "pending",
        lastActionSummary: executionWeeklyPrimaryPlan.planRecord?.lastActionSummary,
        lastActionAt: executionWeeklyPrimaryPlan.planRecord?.lastActionAt,
        completedAt: executionWeeklyPrimaryPlan.planRecord?.completedAt,
      }
    : null,
});

function normalizeGovernanceQuery(input?: {
  country?: string;
  major?: string;
  specialization?: string;
  degree?: string;
}) {
  return {
    country: String(input?.country || ""),
    major: String(input?.major || ""),
    specialization: String(input?.specialization || ""),
    degree: String(input?.degree || ""),
  };
}

function findPendingReviewEntryForBucket(bucket: {
  query: {
    country: string;
    major: string;
    specialization: string;
    degree: string;
  };
}) {
  return (
    findPendingReviewEntryForQuery(
      normalizeGovernanceQuery(bucket.query)
    ) || null
  );
}

function findPendingReviewEntryForQuery(query: {
  country: string;
  major: string;
  specialization: string;
  degree: string;
}) {
  return (
    pendingItems.find((item) =>
      matchesGovernanceQuery(
        {
          country: item.country,
          major: item.major,
          specialization: item.specialization,
          degree: item.degree,
        },
        query
      )
    ) || null
  );
}

function getPendingEntryBatchAvoidSummary(
  entry:
    | {
        id?: string;
        batchEligibleHighCount?: number;
        batchEligibleHighMediumCount?: number;
        batchAvoidWatchCount?: number;
        batchAvoidWatchMediumCount?: number;
        batchAvoidWatchSuggestions?: Array<{ domain: string; count: number }>;
      }
    | null
    | undefined
) {
  return {
    highCount: Number(entry?.batchEligibleHighCount || 0),
    highMediumCount: Number(entry?.batchEligibleHighMediumCount || 0),
    watchCount: Number(entry?.batchAvoidWatchCount || 0),
    watchMediumCount: Number(entry?.batchAvoidWatchMediumCount || 0),
    watchPreview: Array.isArray(entry?.batchAvoidWatchSuggestions)
      ? entry.batchAvoidWatchSuggestions.slice(0, 3)
      : [],
  };
}

function findRecentAuditEntryForBucket(bucket: {
  query: {
    country: string;
    major: string;
    specialization: string;
    degree: string;
  };
}) {
  return (
    findRecentAuditEntryForQuery(normalizeGovernanceQuery(bucket.query)) || null
  );
}

function findRecentAuditEntryForQuery(query: {
  country: string;
  major: string;
  specialization: string;
  degree: string;
}) {
  return (
    auditEntries.find((entry) =>
      matchesGovernanceQuery(
        {
          country: entry.query.country,
          major: entry.query.major,
          specialization: entry.query.specialization,
          degree: entry.query.degree,
        },
        query
      )
    ) || null
  );
}

function findSuggestedAvoidDomainForBucket(bucket: {
  query: {
    country: string;
    major: string;
    specialization: string;
    degree: string;
  };
}) {
  return findSuggestedAvoidDomainForQuery(normalizeGovernanceQuery(bucket.query));
}

function findSuggestedAvoidDomainForQuery(query: {
  country: string;
  major: string;
  specialization: string;
  degree: string;
}) {
  const matchingPendingEntry = findPendingReviewEntryForQuery(query);
  const domainCounts = new Map<
    string,
    { domain: string; count: number; link: string; label: string }
  >();

  const registerDomain = (link?: string, label?: string) => {
    const domain = extractReviewDomain(link);
    if (!domain || activeRuleByDomain.has(domain)) {
      return;
    }

    const current =
      domainCounts.get(domain) || {
        domain,
        count: 0,
        link: normalizeReviewLink(link),
        label: label || domain,
      };
    current.count += 1;
    if (!current.link && link) {
      current.link = normalizeReviewLink(link);
    }
    if (!current.label && label) {
      current.label = label;
    }
    domainCounts.set(domain, current);
  };

  if (matchingPendingEntry) {
    matchingPendingEntry.candidates.forEach((candidate) => {
      registerDomain(candidate.link, candidate.displayLink || candidate.title);
    });
  } else {
    auditEntries
      .filter((entry) =>
        matchesGovernanceQuery(
          {
            country: entry.query.country,
            major: entry.query.major,
            specialization: entry.query.specialization,
            degree: entry.query.degree,
          },
          query
        )
      )
      .forEach((entry) => {
        entry.results
          .filter((result) => result.source === "candidate" && result.link)
          .forEach((result) => {
            registerDomain(result.link, result.displayLink || result.label);
          });
      });
  }

  const sorted = Array.from(domainCounts.values()).sort(
    (left, right) => right.count - left.count || left.domain.localeCompare(right.domain)
  );
  return sorted.find((item) => item.count >= 2) || null;
}

const notices = [
  importCandidateNotice,
  importCandidateBatchNotice,
  batchAvoidRuleNotice,
  reviewQueueNotice,
  reviewQueueNoteNotice,
  admissionsSyncNotice,
  admissionsCountryTargetNotice,
  createAvoidRuleNotice,
  updateAvoidRuleNotice,
  updateExecutionPlanStatusNotice,
].filter(
  (notice): notice is { ok: boolean; message: string } =>
    Boolean(notice && typeof notice === "object" && "message" in notice)
);
