    const meaningfulCount = countMeaningfulSearchResults(entry);
    const candidateHeavy =
      Number(entry.candidateCount || 0) > 0 &&
      Number(entry.displayedVerifiedCount || 0) <= Number(entry.candidateCount || 0);

    current.searchCount += 1;
    current.zeroCount += meaningfulCount === 0 ? 1 : 0;
    current.lowCount += meaningfulCount > 0 && meaningfulCount <= 3 ? 1 : 0;
    current.candidateHeavyCount += candidateHeavy ? 1 : 0;
    current.blockedCount += Number(entry.blockedResultCount || 0);
    current.verifiedCount += Number(entry.displayedVerifiedCount || 0);
