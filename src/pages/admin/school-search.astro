function findActiveAvoidRuleForLink(link?: string) {
  const normalizedLink = normalizeReviewLink(link);
  if (normalizedLink && activeRuleByLink.has(normalizedLink)) {
    return activeRuleByLink.get(normalizedLink) || null;
  }

  const domain = extractReviewDomain(normalizedLink || link);
  if (domain && activeRuleByDomain.has(domain)) {
    return activeRuleByDomain.get(domain) || null;
  }

  return null;
}

function findActiveAvoidRuleForResult(result: StudyAbroadSearchAuditResult) {
  if (result.programId && activeRuleByProgramId.has(result.programId)) {
    return activeRuleByProgramId.get(result.programId) || null;
  }

  return findActiveAvoidRuleForLink(result.link);
}

