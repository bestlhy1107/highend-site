function buildEvalGovernanceTaskSuggestion(item: StudyAbroadSearchEvalCaseReport) {
  if (item.metrics.meaningfulCount === 0) {
    if (item.resolvedQuery.specialization) {
      return "当前已经掉到零结果，先放宽细分方向，再补这个专业大类的正式项目。";
    }

    if (item.resolvedQuery.major) {
      return "当前已经掉到零结果，优先补这个专业大类的正式项目池。";
    }

    return "当前已经掉到零结果，优先补国家 / 学位的基础项目池。";
  }

  if (item.metrics.candidateCount > item.metrics.verifiedCount) {
    return "这组查询正在被候选结果支撑，优先导入候选，再补门槛。";
  }

  if (item.metrics.blockedCount > 0) {
    return "这组查询触发了规避名单，建议复查重复误命中的站点来源。";
  }

  if (item.metrics.meaningfulCount <= 3) {
    return "这组查询结果偏少，适合先补厚正式项目，再补门槛。";
  }

  return "继续观察这组查询，暂时不需要优先处理。";
}

function buildEvalGovernanceTaskPriority(item: StudyAbroadSearchEvalCaseReport) {
  let score = item.passed ? 0 : 100;

  if (item.metrics.meaningfulCount === 0) score += 60;
  else if (item.metrics.meaningfulCount <= 3) score += 40;

  if (item.metrics.candidateCount > item.metrics.verifiedCount) score += 30;
  if (item.metrics.blockedCount > 0) score += 20;
  if (item.resolvedQuery.specialization) score += 10;

  return score;
}

function buildEvalGovernanceLeaderboardKey(query: {
  country?: string;
  degree?: string;
  major?: string;
}) {
  return [
    String(query.country || "").trim().toLowerCase(),
    String(query.degree || "").trim().toLowerCase(),
    String(query.major || "").trim().toLowerCase(),
  ]
    .filter(Boolean)
    .join("|");
}

const evalGovernanceTasks = Array.from(
  (evalReport?.cases || [])
    .filter(
      (item) =>
        !item.passed ||
        item.metrics.meaningfulCount === 0 ||
        item.metrics.meaningfulCount <= 3 ||
        item.metrics.candidateCount > item.metrics.verifiedCount ||
        item.metrics.blockedCount > 0
    )
    .reduce((map, item) => {
      const query = normalizeGovernanceQuery(item.resolvedQuery);
      const key = buildSearchGovernanceKey(item.resolvedQuery);
      const current =
        map.get(key) || {
          key,
          label: summarizeSearchQuery(item.resolvedQuery) || item.label,
          severity: "observe",
          priority: 0,
          cases: [] as StudyAbroadSearchEvalCaseReport[],
          query,
          latestCase: item,
      };

      current.cases.push(item);
      current.latestCase = item;

      const priority = buildEvalGovernanceTaskPriority(item);
      if (priority > current.priority) {
        current.priority = priority;
        current.severity =
          priority >= 140 ? "critical" : priority >= 80 ? "high" : "medium";
      }

      map.set(key, current);
      return map;
    }, new Map<string, {
      key: string;
      label: string;
      severity: "critical" | "high" | "medium" | "observe";
      priority: number;
      cases: StudyAbroadSearchEvalCaseReport[];
      query: ReturnType<typeof normalizeGovernanceQuery>;
      latestCase: StudyAbroadSearchEvalCaseReport;
    }>())
).map(([, task]) => ({
  ...task,
  suggestion: buildEvalGovernanceTaskSuggestion(task.latestCase),
}))
  .sort((left, right) => right.priority - left.priority || right.cases.length - left.cases.length)
  .slice(0, 8);

const evalGovernanceLeaderboard = Array.from(
  evalGovernanceTasks.reduce((map, task) => {
    const key = buildEvalGovernanceLeaderboardKey(task.query) || task.key;
    const current =
      map.get(key) || {
        key,
        label:
          [task.query.country, task.query.degree, task.query.major]
            .filter(Boolean)
            .join(" / ") || task.label,
        query: {
          country: task.query.country,
          degree: task.query.degree,
          major: task.query.major,
          specialization: "",
        },
        taskCount: 0,
        caseCount: 0,
        criticalCount: 0,
        zeroLikeCount: 0,
        lowLikeCount: 0,
        candidateHeavyCount: 0,
        priority: 0,
        topTask: task,
      };

    current.taskCount += 1;
    current.caseCount += task.cases.length;
    current.criticalCount += task.severity === "critical" ? 1 : 0;
    current.zeroLikeCount += task.cases.filter((item) => item.metrics.meaningfulCount === 0).length;
    current.lowLikeCount += task.cases.filter(
      (item) => item.metrics.meaningfulCount > 0 && item.metrics.meaningfulCount <= 3
    ).length;
    current.candidateHeavyCount += task.cases.filter(
      (item) => item.metrics.candidateCount > item.metrics.verifiedCount
    ).length;

    if (task.priority > current.priority) {
      current.priority = task.priority;
      current.topTask = task;
    }

    map.set(key, current);
    return map;
  }, new Map<string, {
    key: string;
    label: string;
    query: ReturnType<typeof normalizeGovernanceQuery>;
    taskCount: number;
    caseCount: number;
    criticalCount: number;
    zeroLikeCount: number;
    lowLikeCount: number;
    candidateHeavyCount: number;
    priority: number;
    topTask: (typeof evalGovernanceTasks)[number];
  }>())
).map(([, item]) => ({
  ...item,
  suggestion: item.topTask.suggestion,
}))
  .sort((left, right) => right.priority - left.priority || right.caseCount - left.caseCount)
  .slice(0, 6);

function findEvalGovernanceLeaderboardItemForSegment(input: {
  kind: "country" | "major";
  key: string;
}) {
  return (
    evalGovernanceLeaderboard.find((item) =>
      input.kind === "country"
        ? item.query.country === input.key
        : item.query.major === input.key
    ) || null
  );
}

function buildEvalSegmentActionQuery(input: {
  kind: "country" | "major";
  key: string;
}) {
  const leaderboardItem = findEvalGovernanceLeaderboardItemForSegment(input);
  if (leaderboardItem) {
    return leaderboardItem.query;
  }

  return normalizeGovernanceQuery({
    country: input.kind === "country" ? input.key : "",
    degree: "",
    major: input.kind === "major" ? input.key : "",
    specialization: "",
  });
}

function buildEvalSegmentSuggestion(input: {
  kind: "country" | "major";
  label: string;
  passRate: number;
  zeroResultCases: number;
  lowResultCases: number;
  candidateHeavyCases: number;
}) {
  if (input.zeroResultCases > 0) {
    return input.kind === "country"
      ? `这个国家已经出现零结果样例，优先补 ${input.label} 的基础项目池，再补门槛。`
      : `这个方向已经出现零结果样例，优先补 ${input.label} 的正式项目，再检查方向映射是不是过窄。`;
  }

  if (input.candidateHeavyCases > 0) {
    return input.kind === "country"
      ? `这个国家有多条查询主要靠候选结果撑着，建议先导入高可信候选，再清理重复低质来源。`
      : `这个方向正在被候选结果支撑，建议先导入高可信候选，再补正式库和门槛。`;
  }

  if (input.lowResultCases > 0 || input.passRate < 100) {
    return input.kind === "country"
      ? `这个国家的正式结果开始变薄，适合先补门槛，再补热门学校和项目。`
      : `这个方向的召回还不够厚，适合先补正式项目，再放宽同类方向映射。`;
  }

  return input.kind === "country"
    ? `这个国家当前整体稳定，继续观察是否有新查询开始掉到候选主导。`
    : `这个方向当前整体稳定，继续观察是否需要扩细分方向和同类方向覆盖。`;
}

function buildEvalSegmentSeverityLabel(input: {
  passRate: number;
  zeroResultCases: number;
  lowResultCases: number;
  candidateHeavyCases: number;
}) {
  if (input.zeroResultCases > 0) return "优先补库";
  if (input.candidateHeavyCases > 0) return "候选偏重";
  if (input.lowResultCases > 0 || input.passRate < 100) return "需要加厚";
  return "整体稳定";
}

function buildEvalSegmentTrendLeaders(input: {
  kind: "country" | "major";
  currentItems: StudyAbroadSearchEvalSegmentSummary[];
  previousItems: StudyAbroadSearchEvalSegmentSummary[];
}) {
  const previousMap = new Map(input.previousItems.map((item) => [item.key, item] as const));

  return input.currentItems
    .map((item) => {
      const previous = previousMap.get(item.key) || null;
      const passRateDelta = previous ? Number((item.passRate - previous.passRate).toFixed(1)) : 0;
      const lowDelta = previous ? item.lowResultCases - previous.lowResultCases : 0;
      const zeroDelta = previous ? item.zeroResultCases - previous.zeroResultCases : 0;
      const candidateHeavyDelta = previous
        ? item.candidateHeavyCases - previous.candidateHeavyCases
        : 0;
      const weaknessScore =
        item.zeroResultCases * 80 +
        item.lowResultCases * 40 +
        item.candidateHeavyCases * 35 +
        Math.max(0, 100 - item.passRate) +
        (zeroDelta > 0 ? zeroDelta * 30 : 0) +
        (lowDelta > 0 ? lowDelta * 18 : 0) +
        (candidateHeavyDelta > 0 ? candidateHeavyDelta * 16 : 0) +
        (passRateDelta < 0 ? Math.abs(passRateDelta) * 2 : 0);

      const trendSummary = !previous
        ? "这是第一轮分段记录，后续继续跑评测后这里会开始显示真实趋势。"
        : [
            passRateDelta < 0
              ? `通过率下降 ${Math.abs(passRateDelta).toFixed(1)}%`
              : passRateDelta > 0
                ? `通过率提升 ${passRateDelta.toFixed(1)}%`
                : "通过率持平",
            zeroDelta > 0
              ? `零结果 +${zeroDelta}`
              : zeroDelta < 0
                ? `零结果 ${zeroDelta}`
                : "零结果持平",
            lowDelta > 0
              ? `低结果 +${lowDelta}`
              : lowDelta < 0
                ? `低结果 ${lowDelta}`
                : "低结果持平",
            candidateHeavyDelta > 0
              ? `候选主导 +${candidateHeavyDelta}`
              : candidateHeavyDelta < 0
                ? `候选主导 ${candidateHeavyDelta}`
                : "候选主导持平",
          ].join(" · ");

      return {
        ...item,
        previous,
        passRateDelta,
        lowDelta,
        zeroDelta,
        candidateHeavyDelta,
        weaknessScore,
        trendSummary,
      };
    })
    .sort(
      (left, right) =>
        right.weaknessScore - left.weaknessScore ||
        left.passRate - right.passRate ||
        right.zeroResultCases - left.zeroResultCases ||
        right.lowResultCases - left.lowResultCases
    )
    .slice(0, 6);
}

