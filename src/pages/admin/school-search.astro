                              value="管理员在搜索留痕中判定这条结果不符合推荐标准"
                            />
                            <button class="btn btn-ghost" type="submit">后续规避这条</button>
                          </form>
                          {result.link ? (
                            <form method="POST" action={actions.createStudyAbroadSearchAvoidRule}>
                              <input type="hidden" name="targetType" value="domain" />
                              <input type="hidden" name="source" value={result.source} />
                              <input type="hidden" name="label" value={result.displayLink || result.label} />
                              <input type="hidden" name="link" value={result.link} />
                              <input type="hidden" name="sourceSessionId" value={entry.sessionId} />
                              <input
                                type="hidden"
                                name="reason"
                                value="管理员在搜索留痕中判定这个站点整体不符合推荐标准"
                              />
                              <button class="btn btn-ghost" type="submit">规避整个站点</button>
                            </form>
                          ) : null}
                        </>
                      )}

                      {result.link ? (
                        <a class="btn btn-ghost" href={result.link} target="_blank" rel="noreferrer">
                          打开来源链接
                        </a>
                      ) : null}
                    </div>
                  </div>
                );
              })}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="card mt-6">
        <div class="h3">还没有搜索留痕</div>
        <p class="muted mt-2">
          当前只有用户真正执行搜索后，这里才会出现留痕。它会记录这轮搜索返回了哪些正式项目和候选官网页，方便管理员后续做规避。
        </p>
      </div>
    )}

    {(lowYieldAuditEntries.length || zeroYieldAuditEntries.length || highBlockedAuditEntries.length) ? (
      <div class="cards mt-6">
        <article class="card">
          <div class="card-top">
            <div class="h3">优先补库的低命中搜索</div>
            <span class="badge">{lowYieldAuditEntries.length} 条</span>
          </div>
          <div class="mt-4">
            {lowYieldAuditEntries.length ? lowYieldAuditEntries.map((entry) => (
              <div class="faq">
                <div class="h3">{summarizeSearchQuery(entry.query)}</div>
                <div class="muted mt-1">
                  命中 {countMeaningfulSearchResults(entry)} 条 · {new Date(entry.updatedAt).toLocaleString("zh-CN")}
                </div>
              </div>
            )) : (
              <div class="muted">最近没有低命中搜索。</div>
            )}
          </div>
        </article>

        <article class="card">
          <div class="card-top">
            <div class="h3">优先排查的零命中搜索</div>
            <span class="badge">{zeroYieldAuditEntries.length} 条</span>
          </div>
          <div class="mt-4">
            {zeroYieldAuditEntries.length ? zeroYieldAuditEntries.map((entry) => (
              <div class="faq">
                <div class="h3">{summarizeSearchQuery(entry.query)}</div>
                <div class="muted mt-1">{new Date(entry.updatedAt).toLocaleString("zh-CN")}</div>
                <div class="muted mt-1">{entry.message}</div>
              </div>
            )) : (
              <div class="muted">最近没有零命中搜索。</div>
            )}
          </div>
        </article>

        <article class="card">
          <div class="card-top">
            <div class="h3">反复触发规避的搜索</div>
            <span class="badge">{highBlockedAuditEntries.length} 条</span>
          </div>
          <div class="mt-4">
            {highBlockedAuditEntries.length ? highBlockedAuditEntries.map((entry) => (
              <div class="faq">
                <div class="h3">{summarizeSearchQuery(entry.query)}</div>
                <div class="muted mt-1">
                  已规避 {entry.blockedResultCount} 条 · {new Date(entry.updatedAt).toLocaleString("zh-CN")}
                </div>
              </div>
            )) : (
              <div class="muted">最近没有触发规避名单的搜索。</div>
            )}
          </div>
        </article>
      </div>
    ) : null}

    {activeAvoidRules.length ? (
      <div class="card mt-6">
        <div class="card-top">
          <div class="h3">当前规避名单</div>
          <span class="badge">{activeAvoidRules.length} 条</span>
        </div>
        <div class="mt-4">
          {activeAvoidRules.slice(0, 24).map((rule) => (
            <div class="faq">
              <div class="card-top">
                <div>
                  <div class="h3">{rule.label || rule.link || rule.domain || rule.programId}</div>
                  <div class="muted mt-1">
                    {rule.targetType === "program"
                      ? "正式项目规避"
                      : rule.targetType === "domain"
                        ? "整站规避"
                        : "单链接规避"}
                    {rule.reason ? ` · ${rule.reason}` : ""}
                  </div>
                  <div class="muted mt-1">
                    生效时间：{new Date(rule.updatedAt).toLocaleString("zh-CN")}
                  </div>
                  <div class="muted mt-1">
                    命中统计：{rule.hitCount || 0} 次
                    {rule.lastHitAt
                      ? ` · 最近命中 ${new Date(rule.lastHitAt).toLocaleString("zh-CN")}`
                      : ""}
                  </div>
                  {rule.lastHitLabel ? (
                    <div class="muted mt-1">最近命中结果：{rule.lastHitLabel}</div>
                  ) : null}
                </div>
                <form method="POST" action={actions.updateStudyAbroadSearchAvoidRuleStatus}>
                  <input type="hidden" name="id" value={rule.id} />
                  <input type="hidden" name="status" value="inactive" />
                  <button class="btn btn-ghost" type="submit">恢复显示</button>
                </form>
              </div>
            </div>
          ))}
        </div>
      </div>
    ) : null}

    {recentHandledItems.length ? (
      <div class="card mt-6">
        <div class="card-top">
          <div class="h3">最近已处理候选任务</div>
          <span class="badge">{recentHandledItems.length} 条</span>
        </div>
        <div class="mt-4">
          {recentHandledItems.map((item) => (
            <div class="faq">
              <div class="card-top">
                <div class="h3">{summarizeSearchQuery(item)}</div>
                <span class="badge">
                  {item.status === "reviewed" ? "已入库" : "已丢弃"}
                </span>
              </div>
              <div class="muted mt-1">
                处理时间：{new Date(item.updatedAt).toLocaleString("zh-CN")} · 候选 {item.candidates.length} 条
              </div>
              {item.adminNote ? <div class="muted mt-2">审核备注：{item.adminNote}</div> : null}
              {item.reviewHistory.length ? (
                <div class="mt-3">
                  {item.reviewHistory.slice(0, 4).map((historyItem) => (
                    <div class="muted mt-1">
                      {new Date(historyItem.createdAt).toLocaleString("zh-CN")} · {historyItem.action}
                      {historyItem.note ? `：${historyItem.note}` : ""}
                    </div>
                  ))}
                </div>
              ) : null}
            </div>
          ))}
        </div>
      </div>
    ) : null}
  </main>
</BaseLayout>
