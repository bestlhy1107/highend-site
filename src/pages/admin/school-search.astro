---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { actions } from "astro:actions";
import { readStudyAbroadCatalogPrograms } from "../../lib/study-abroad-catalog-store";
import {
  collectStudyAbroadReviewAvoidDomainSuggestions,
  readStudyAbroadReviewQueue,
} from "../../lib/study-abroad-review-queue";
import { getStudyAbroadSearchRuntimeStatus } from "../../lib/study-abroad-search";
import {
  normalizeStudyAbroadGovernanceLink,
  readStudyAbroadSearchAuditEntries,
  readStudyAbroadSearchAvoidRules,
  type StudyAbroadSearchAuditResult,
} from "../../lib/study-abroad-search-governance";
import {
  readStudyAbroadSearchEvalHistory,
  readStudyAbroadSearchEvalReport,
  type StudyAbroadSearchEvalCaseReport,
  type StudyAbroadSearchEvalHistoryItem,
  type StudyAbroadSearchEvalSegmentSummary,
} from "../../lib/study-abroad-search-eval";
import { readStudyAbroadSearchRuntimeAcceptanceReport } from "../../lib/study-abroad-search-runtime-acceptance";
import {
  autoArchiveCompletedStudyAbroadSearchExecutionPlans,
  buildStudyAbroadSearchExecutionPlanId,
  readStudyAbroadSearchExecutionPlanRecords,
} from "../../lib/study-abroad-search-execution-plan";

function normalizeReviewLink(value?: string) {
  return normalizeStudyAbroadGovernanceLink(value);
}

function extractReviewDomain(value?: string) {
  try {
    return new URL(String(value || "").trim()).hostname.toLowerCase().replace(/^www\./, "");
  } catch {
    return "";
  }
}

function looksLikePdfReviewLink(value?: string) {
  return normalizeReviewLink(value).toLowerCase().endsWith(".pdf");
}

function getCandidateCredibilityLevel(candidate: {
  credibilityLevel?: "high" | "medium" | "watch";
}) {
  return candidate.credibilityLevel === "high" || candidate.credibilityLevel === "medium"
    ? candidate.credibilityLevel
    : "watch";
}

function getCandidateCredibilityLabel(level: "high" | "medium" | "watch") {
  switch (level) {
    case "high":
      return "高可信";
    case "medium":
      return "中可信";
    default:
      return "待核对";
  }
}

function getCandidateCredibilityPriority(level: "high" | "medium" | "watch") {
  switch (level) {
    case "high":
      return 3;
    case "medium":
      return 2;
    default:
      return 1;
  }
}

function summarizeReviewCandidateCredibility(candidates: {
  credibilityLevel?: "high" | "medium" | "watch";
}[]) {
  return candidates.reduce(
    (acc, candidate) => {
      const level = getCandidateCredibilityLevel(candidate);
      acc[level] += 1;
      return acc;
    },
    {
      high: 0,
      medium: 0,
      watch: 0,
    }
  );
}

function compareReviewCandidates(
  left: {
    credibilityLevel?: "high" | "medium" | "watch";
    score?: number;
    authorityScore?: number;
    rerankScore?: number;
    title?: string;
  },
  right: {
    credibilityLevel?: "high" | "medium" | "watch";
    score?: number;
    authorityScore?: number;
    rerankScore?: number;
    title?: string;
  }
) {
  return (
    getCandidateCredibilityPriority(getCandidateCredibilityLevel(right)) -
      getCandidateCredibilityPriority(getCandidateCredibilityLevel(left)) ||
    Number(right.score || 0) - Number(left.score || 0) ||
    Number(right.authorityScore || 0) - Number(left.authorityScore || 0) ||
    Number(right.rerankScore || 0) - Number(left.rerankScore || 0) ||
    String(left.title || "").localeCompare(String(right.title || ""), "zh-CN")
  );
}

function summarizeSearchQuery(query?: {
  freeText?: string;
  country?: string;
  degree?: string;
  major?: string;
  specialization?: string;
}) {
  const summary = [
    query?.country || "",
    query?.degree || "",
    query?.major || "",
    query?.specialization || "",
  ]
    .filter(Boolean)
    .join(" / ");

  return summary || String(query?.freeText || "").trim() || "未命名搜索";
}

function countMeaningfulSearchResults(entry: {
  displayedVerifiedCount: number;
  candidateCount: number;
}) {
  return Number(entry.displayedVerifiedCount || 0) + Number(entry.candidateCount || 0);
}

function buildSearchGovernanceKey(query?: {
  freeText?: string;
  country?: string;
  degree?: string;
  major?: string;
  specialization?: string;
}) {
  const normalizedFreeText = String(query?.freeText || "").trim().toLowerCase();
  const structuredKey = [
    query?.country || "",
    query?.degree || "",
    query?.major || "",
    query?.specialization || "",
  ]
    .map((item) => String(item || "").trim().toLowerCase())
    .filter(Boolean)
    .join("|");

  return structuredKey || normalizedFreeText || "unlabeled";
}

function buildGovernanceSuggestion(input: {
  zeroCount: number;
  lowCount: number;
  candidateHeavyCount: number;
  blockedCount: number;
  query: {
    freeText: string;
    country: string;
    major: string;
    specialization: string;
    degree: string;
  };
}) {
  if (input.zeroCount > 0) {
    if (input.query.specialization) {
      return "优先检查这个细分方向是否过窄，必要时补同大类项目，并增加更宽方向推荐。";
    }

    if (input.query.major) {
      return "优先补这个专业大类的正式项目，并检查学科映射是否过严。";
    }

    return "优先补国家 / 学位组合的基础项目池，避免用户一上来就空结果。";
  }

  if (input.candidateHeavyCount > 0) {
    return "这类查询常靠候选官网页撑结果，建议优先把热门候选导入正式库，并补门槛。";
  }

  if (input.blockedCount > 0) {
    return "这类查询反复撞上规避名单，建议复查坏结果来源，并调整搜索扩展站点范围。";
  }

  if (input.lowCount > 0) {
    return "这类查询结果偏少，建议补热门学校项目，并放宽同类专业映射。";
  }

  return "继续观察这类查询，暂时不需要优先处理。";
}

function matchesGovernanceQuery(
  left: {
    country?: string;
    major?: string;
    specialization?: string;
    degree?: string;
  },
  right: {
    country?: string;
    major?: string;
    specialization?: string;
    degree?: string;
  }
) {
  return (
    String(left.country || "") === String(right.country || "") &&
    String(left.major || "") === String(right.major || "") &&
    String(left.specialization || "") === String(right.specialization || "") &&
    String(left.degree || "") === String(right.degree || "")
  );
}

function buildEvalHistoryItemFromReport(report: {
  generatedAt: string;
  totalCases: number;
  passedCases: number;
  failedCases: number;
  passRate: number;
  zeroResultCases: number;
  lowResultCases: number;
  candidateHeavyCases: number;
  candidateHeavyRate?: number;
  blockedCases?: number;
  totalBlockedCount?: number;
  averageBlockedCount?: number;
  blockedResultRate?: number;
  postAvoidQualityRate?: number;
  averageVerifiedCount: number;
  averageUniversityCount: number;
  averageCandidateCount: number;
  byCountry?: StudyAbroadSearchEvalSegmentSummary[];
  byMajor?: StudyAbroadSearchEvalSegmentSummary[];
}): StudyAbroadSearchEvalHistoryItem {
  return {
    generatedAt: report.generatedAt,
    totalCases: report.totalCases,
    passedCases: report.passedCases,
    failedCases: report.failedCases,
    passRate: report.passRate,
    zeroResultCases: report.zeroResultCases,
    lowResultCases: report.lowResultCases,
    candidateHeavyCases: report.candidateHeavyCases,
    candidateHeavyRate: report.candidateHeavyRate || 0,
    blockedCases: report.blockedCases || 0,
    totalBlockedCount: report.totalBlockedCount || 0,
    averageBlockedCount: report.averageBlockedCount || 0,
    blockedResultRate: report.blockedResultRate || 0,
    postAvoidQualityRate:
      typeof report.postAvoidQualityRate === "number" ? report.postAvoidQualityRate : 100,
    averageVerifiedCount: report.averageVerifiedCount,
    averageUniversityCount: report.averageUniversityCount,
    averageCandidateCount: report.averageCandidateCount,
    byCountry: Array.isArray(report.byCountry) ? report.byCountry : [],
    byMajor: Array.isArray(report.byMajor) ? report.byMajor : [],
  };
}

function formatEvalTrendDelta(
  currentValue: number,
  previousValue: number | null,
  options?: {
    digits?: number;
    higherIsBetter?: boolean;
    unit?: string;
  }
) {
  if (previousValue === null || Number.isNaN(previousValue)) {
    return "还没有上一次评测可对比";
  }

  const digits = options?.digits ?? 1;
  const unit = options?.unit || "";
  const delta = Number((currentValue - previousValue).toFixed(digits));
  const threshold = digits > 0 ? 1 / 10 ** digits : 0.5;

  if (Math.abs(delta) < threshold) {
    return "较上次基本持平";
  }

  const higherIsBetter = options?.higherIsBetter !== false;
  const better = higherIsBetter ? delta > 0 : delta < 0;

  return `较上次 ${delta > 0 ? "+" : ""}${delta}${unit}（${better ? "变好" : "变差"}）`;
}

function getStartOfWeek(date = new Date()) {
  const next = new Date(date);
  const day = next.getDay();
  const diff = day === 0 ? -6 : 1 - day;
  next.setHours(0, 0, 0, 0);
  next.setDate(next.getDate() + diff);
  return next;
}

function isWithinCurrentWeek(value?: string, weekStart = getStartOfWeek()) {
  if (!value) return false;
  const time = new Date(value).getTime();
  return Number.isFinite(time) && time >= weekStart.getTime();
}

function summarizeExecutionAction(value?: string) {
  const normalized = String(value || "").trim();
  if (!normalized) return "";

  const [head] = normalized.split("：");
  return head || normalized;
}

function buildWeeklyExecutionSummary(input: {
  touchedCount: number;
  completedCount: number;
  attentionCount: number;
  topActionLabel?: string;
  completedLabels?: string[];
  attentionLabels?: string[];
  weakestCountryLabel?: string;
  weakestMajorLabel?: string;
}) {
  if (!input.touchedCount) {
    const weakestSummary = [input.weakestCountryLabel, input.weakestMajorLabel]
      .filter(Boolean)
      .join(" / ");
    return {
      headline: "本周还没有实际推进记录。",
      detail: weakestSummary
        ? `建议先从下周自动执行清单的前 1 到 3 组开始，优先处理当前最弱的 ${weakestSummary}。`
        : "建议先从下周自动执行清单的前 1 到 3 组开始，先把最优先的国家和方向跑起来。",
    };
  }

  const detailParts: string[] = [];

  if (input.completedLabels?.length) {
    detailParts.push(`已完成重点：${input.completedLabels.slice(0, 2).join("、")}`);
  }

  if (input.attentionLabels?.length) {
    detailParts.push(`当前卡住：${input.attentionLabels.slice(0, 2).join("、")}`);
  }

  if (input.topActionLabel) {
    detailParts.push(`最近最常执行：${input.topActionLabel}`);
  }

  if (input.weakestCountryLabel) {
    detailParts.push(`当前最弱国家：${input.weakestCountryLabel}`);
  }

  if (input.weakestMajorLabel) {
    detailParts.push(`当前最弱方向：${input.weakestMajorLabel}`);
  }

  return {
    headline: `本周已推进 ${input.touchedCount} 组计划，完成 ${input.completedCount} 组，仍有 ${input.attentionCount} 组待跟进。`,
    detail:
      detailParts.join("；") ||
      "这周已经有实际推进动作，建议优先清掉仍待推进的计划，让补库和补门槛节奏更稳定。",
  };
}

function buildWeeklyRecommendationPlanStatus(plan?: {
  status?: "pending" | "in_progress" | "completed";
  lastActionSummary?: string;
  lastActionAt?: string;
  completedAt?: string;
} | null) {
  const status = plan?.status || "pending";

  if (status === "completed") {
    return {
      label: "已完成",
      detail: plan?.completedAt
        ? `完成时间：${new Date(plan.completedAt).toLocaleString("zh-CN")}`
        : "这组计划已经完成，可以把经验复制到同类方向。",
    };
  }

  if (status === "in_progress") {
    return {
      label: "已开始执行",
      detail: plan?.lastActionSummary
        ? `最近动作：${plan.lastActionSummary}`
        : plan?.lastActionAt
          ? `最近更新时间：${new Date(plan.lastActionAt).toLocaleString("zh-CN")}`
          : "这组计划已经在推进中，建议继续收口。",
    };
  }

  return {
    label: "待执行",
    detail: "这组计划还没正式开始，适合直接从这里发起动作。",
  };
}

function buildWeeklyExecutionRecommendations(input: {
  touchedCount: number;
  completedCount: number;
  attentionCount: number;
  topActionLabel?: string;
  completedLabels?: string[];
  attentionLabels?: string[];
  weakestCountryLabel?: string;
  weakestMajorLabel?: string;
  primaryPlan?: {
    id: string;
    label: string;
    query: {
      country: string;
      degree: string;
      major: string;
      specialization: string;
    };
    pendingEntryId?: string;
    batchImportHighCount?: number;
    batchImportHighMediumCount?: number;
    batchAvoidWatchCount?: number;
    batchAvoidWatchMediumCount?: number;
    status?: "pending" | "in_progress" | "completed";
    lastActionSummary?: string;
    lastActionAt?: string;
    completedAt?: string;
  } | null;
}) {
  const primaryPlanStatus = input.primaryPlan?.status || "pending";
  const primaryPlanActionable = Boolean(input.primaryPlan && primaryPlanStatus !== "completed");
  const recommendations: Array<{
    title: string;
    detail: string;
    actionLabel: string;
    actionType: "anchor" | "sync" | "country" | "import-high" | "avoid-watch-medium";
    actionHref?: string;
    plan?: {
      id: string;
      label: string;
      query: {
        country: string;
        degree: string;
        major: string;
        specialization: string;
      };
      pendingEntryId?: string;
      batchImportHighCount?: number;
      batchImportHighMediumCount?: number;
      batchAvoidWatchCount?: number;
      batchAvoidWatchMediumCount?: number;
    } | null;
    statusLabel?: string;
    statusDetail?: string;
  }> = [];

  if (!input.touchedCount) {
    recommendations.push({
      title: "先把本周第一组计划跑起来",
      detail:
        input.weakestCountryLabel || input.weakestMajorLabel
          ? `先从下周自动执行清单的前 1 组开始，优先处理当前最弱的 ${[input.weakestCountryLabel, input.weakestMajorLabel].filter(Boolean).join(" / ")}。`
          : "先从下周自动执行清单的前 1 组开始，把最优先的国家和方向真正跑起来。",
      actionLabel: primaryPlanActionable ? "直接去补这组门槛" : "去执行清单处理",
      actionType: primaryPlanActionable ? "sync" : "anchor",
      actionHref: primaryPlanActionable ? undefined : "#eval-next-week-plan",
      plan: input.primaryPlan || null,
      statusLabel: buildWeeklyRecommendationPlanStatus(input.primaryPlan).label,
      statusDetail: buildWeeklyRecommendationPlanStatus(input.primaryPlan).detail,
    });
    recommendations.push({
      title: "优先拿到第一条完成记录",
      detail: "优先选择一组能快速见效的补门槛任务，先让周报里出现第一条已完成记录。",
      actionLabel:
        primaryPlanActionable && input.primaryPlan?.query.country
          ? "按国家推进这组"
          : "查看本周补库榜单",
      actionType:
        primaryPlanActionable && input.primaryPlan?.query.country ? "country" : "anchor",
      actionHref:
        primaryPlanActionable && input.primaryPlan?.query.country
          ? undefined
          : "#eval-weekly-focus",
      plan: input.primaryPlan || null,
      statusLabel: buildWeeklyRecommendationPlanStatus(input.primaryPlan).label,
      statusDetail: buildWeeklyRecommendationPlanStatus(input.primaryPlan).detail,
    });
    return recommendations;
  }

  if (input.attentionCount > 0) {
    const stuckLabels = input.attentionLabels?.slice(0, 2).join("、");
    recommendations.push({
      title: "先清掉还卡着的计划",
      detail: stuckLabels
        ? `优先回到执行清单处理 ${input.attentionCount} 组未完成计划，先清掉 ${stuckLabels}${input.weakestCountryLabel ? `，同时盯住当前最弱国家 ${input.weakestCountryLabel}` : ""}。`
        : `优先回到执行清单处理 ${input.attentionCount} 组未完成计划，避免这周动作只停留在“处理中”。`,
      actionLabel: "去执行清单处理",
      actionType: "anchor",
      actionHref: "#eval-next-week-plan",
      plan: null,
    });
    if (primaryPlanActionable && input.primaryPlan) {
      recommendations.push({
        title: "先把第一组待推进计划补起来",
        detail: `建议先推进 ${input.primaryPlan.label}，这样最容易把周报里的待办数量降下来。`,
        actionLabel: "直接去补这组门槛",
        actionType: "sync",
        plan: input.primaryPlan,
        statusLabel: buildWeeklyRecommendationPlanStatus(input.primaryPlan).label,
        statusDetail: buildWeeklyRecommendationPlanStatus(input.primaryPlan).detail,
      });
    }
  }

  if (
    primaryPlanActionable &&
    input.primaryPlan?.pendingEntryId &&
    input.primaryPlan.batchImportHighCount &&
    recommendations.length < 3
  ) {
    recommendations.push({
      title: "先批量导入高可信候选",
      detail: `${input.primaryPlan.label} 当前还有 ${input.primaryPlan.batchImportHighCount} 条高可信候选没进正式库，先导入这批通常最能直接放大正式结果。`,
      actionLabel: `导入高可信候选（${input.primaryPlan.batchImportHighCount}）`,
      actionType: "import-high",
      plan: input.primaryPlan,
      statusLabel: buildWeeklyRecommendationPlanStatus(input.primaryPlan).label,
      statusDetail: buildWeeklyRecommendationPlanStatus(input.primaryPlan).detail,
    });
  }

  if (
    primaryPlanActionable &&
    input.primaryPlan?.pendingEntryId &&
    input.primaryPlan.batchAvoidWatchMediumCount &&
    recommendations.length < 3
  ) {
    recommendations.push({
      title: "顺手清掉重复低质来源",
      detail: `${input.primaryPlan.label} 当前有 ${input.primaryPlan.batchAvoidWatchMediumCount} 个中低可信重复来源可直接规避，清掉后候选噪音会更低。`,
      actionLabel: `规避中低可信来源（${input.primaryPlan.batchAvoidWatchMediumCount}）`,
      actionType: "avoid-watch-medium",
      plan: input.primaryPlan,
      statusLabel: buildWeeklyRecommendationPlanStatus(input.primaryPlan).label,
      statusDetail: buildWeeklyRecommendationPlanStatus(input.primaryPlan).detail,
    });
  }

  if (input.touchedCount > 0 && input.completedCount === 0) {
    recommendations.push({
      title: "先收口一组已完成计划",
      detail: "这周已经开始推进，但还没有形成已完成计划，建议先把 1 组最接近收口的任务标记完成。",
      actionLabel: "回到执行清单收口",
      actionType: "anchor",
      actionHref: "#eval-next-week-plan",
      plan: null,
    });
  }

  if (input.completedLabels?.length && recommendations.length < 3) {
    recommendations.push({
      title: "把已完成节奏复制到同类方向",
      detail: `已完成的节奏开始形成了，下一步建议复制到同类方向，比如 ${input.completedLabels.slice(0, 2).join("、")}${input.weakestMajorLabel ? `，优先对当前最弱方向 ${input.weakestMajorLabel} 复用这套节奏。` : "。"} `,
      actionLabel: "查看本周补库榜单",
      actionType: "anchor",
      actionHref: "#eval-weekly-focus",
      plan: null,
    });
  }

  if (!input.attentionCount && input.completedCount > 0 && recommendations.length < 3) {
    recommendations.push({
      title: "当前优先计划已经做完，切到下一组方向",
      detail:
        input.weakestCountryLabel || input.weakestMajorLabel
          ? `这周最核心的执行计划已经完成，下一步建议回到本周补库榜单，优先接手当前最弱的 ${[input.weakestCountryLabel, input.weakestMajorLabel].filter(Boolean).join(" / ")}。`
          : "这周最核心的执行计划已经完成，下一步建议回到本周补库榜单，从下一组国家 / 专业方向继续推进。",
      actionLabel: "查看本周补库榜单",
      actionType: "anchor",
      actionHref: "#eval-weekly-focus",
      plan: null,
    });
  }

  if (input.topActionLabel && recommendations.length < 3) {
    recommendations.push({
      title: "沿着最近有效动作继续推进",
      detail: `延续最近最常执行的“${input.topActionLabel}”节奏，同时补上一组能明确收口的已完成结果。`,
      actionLabel: "回到执行清单继续推进",
      actionType: "anchor",
      actionHref: "#eval-next-week-plan",
      plan: null,
    });
  }

  return recommendations.slice(0, 3);
}

const adminUser = await Astro.session?.get("adminUser");
if (!adminUser) {
  return Astro.redirect("/admin/login");
}

const importCandidateResult = Astro.getActionResult(actions.importStudyAbroadReviewCandidate);
const importCandidateNotice =
  importCandidateResult && !importCandidateResult.error ? importCandidateResult.data : null;
const importCandidateBatchResult = Astro.getActionResult(
  actions.importStudyAbroadReviewCandidatesByCredibility
);
const importCandidateBatchNotice =
  importCandidateBatchResult && !importCandidateBatchResult.error
    ? importCandidateBatchResult.data
    : null;
const batchAvoidRuleResult = Astro.getActionResult(actions.createStudyAbroadReviewBatchAvoidRules);
const batchAvoidRuleNotice =
  batchAvoidRuleResult && !batchAvoidRuleResult.error ? batchAvoidRuleResult.data : null;
const reviewQueueResult = Astro.getActionResult(actions.updateStudyAbroadReviewQueueStatus);
const reviewQueueNotice =
  reviewQueueResult && !reviewQueueResult.error ? reviewQueueResult.data : null;
const reviewQueueNoteResult = Astro.getActionResult(actions.updateStudyAbroadReviewEntryNote);
const reviewQueueNoteNotice =
  reviewQueueNoteResult && !reviewQueueNoteResult.error ? reviewQueueNoteResult.data : null;
const admissionsSyncResult = Astro.getActionResult(actions.syncStudyAbroadAdmissionsSnapshots);
const admissionsSyncNotice =
  admissionsSyncResult && !admissionsSyncResult.error ? admissionsSyncResult.data : null;
const admissionsCountryTargetResult = Astro.getActionResult(
  actions.executeStudyAbroadAdmissionsCountryTargetPlan
);
const admissionsCountryTargetNotice =
  admissionsCountryTargetResult && !admissionsCountryTargetResult.error
    ? admissionsCountryTargetResult.data
    : null;
const createAvoidRuleResult = Astro.getActionResult(actions.createStudyAbroadSearchAvoidRule);
const createAvoidRuleNotice =
  createAvoidRuleResult && !createAvoidRuleResult.error ? createAvoidRuleResult.data : null;
const updateAvoidRuleResult = Astro.getActionResult(actions.updateStudyAbroadSearchAvoidRuleStatus);
const updateAvoidRuleNotice =
  updateAvoidRuleResult && !updateAvoidRuleResult.error ? updateAvoidRuleResult.data : null;
const updateExecutionPlanStatusResult = Astro.getActionResult(
  actions.updateStudyAbroadSearchExecutionPlanStatus
);
const updateExecutionPlanStatusNotice =
  updateExecutionPlanStatusResult && !updateExecutionPlanStatusResult.error
    ? updateExecutionPlanStatusResult.data
    : null;

const archivedExecutionPlanResult = await autoArchiveCompletedStudyAbroadSearchExecutionPlans({
  olderThanDays: 7,
});

const [
  queue,
  catalogPrograms,
  auditEntries,
  avoidRules,
  evalReport,
  evalHistoryRaw,
  executionPlanRecords,
  runtimeAcceptanceReport,
] = await Promise.all([
  readStudyAbroadReviewQueue(),
  readStudyAbroadCatalogPrograms(),
  readStudyAbroadSearchAuditEntries(),
  readStudyAbroadSearchAvoidRules(),
