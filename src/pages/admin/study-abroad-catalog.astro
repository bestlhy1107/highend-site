                  </div>
                  <div class="muted mt-2">
                    {item.rounds} 轮 · {item.itemCount} 组任务 · {item.syncedCount} 项目
                  </div>
                  <div class="muted mt-2">
                    结构化门槛 +{item.structuredDelta} · 完整门槛 +{item.completeDelta}
                  </div>
                  <div class="muted mt-2">
                    覆盖国家：{item.countries.join(" / ") || "待补"}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ) : null}
      </div>

      <div class="card mt-4" id="catalog-targets">
        <div class="card-top">
          <div>
            <div class="h3">重点国家目标覆盖率</div>
            <div class="muted mt-1">这里专门看重点国家离目标线还有多远，避免美国大盘太厚时把英国、香港、新加坡这些国家长期压住。</div>
          </div>
          <span class="badge">Targets</span>
        </div>

        <div class="mt-4">
          <div class="muted">下一批自动轮转建议</div>
          <div class="catalog-queue-grid mt-3">
            {admissionsCountryTargetQueue.map((item) => (
              <div class="catalog-queue-item">
                <div class="card-top">
                  <div class="h3">{item.country}</div>
                  <span class="badge">轮转分 {item.queueScore}</span>
                </div>
                <div class="muted mt-2">
                  目标 {item.targetStructuredCoveragePercent}% · 当前 {item.structuredCoveragePercent}% · 还差 {item.targetGapPercent}%
                </div>
                <div class="muted mt-2">
                  建议方向：{item.focusRecommendations.map((focus) => focus.major).join(" / ") || "先补基础覆盖"}
                </div>
                <div class="muted mt-2">
                  国家冷却：{item.lastCountryRunAt ? `${admissionsStrategy.countryCooldownHours}h 内降权，最近一次 ${item.lastCountryRunAt.slice(0, 16).replace("T", " ")}` : "未补过，当前没有国家冷却"}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-4">
          {admissionsCountryTargetPlans.length ? (
            admissionsCountryTargetPlans.map((item) => (
              <div class="faq">
                <div class="card-top">
                  <div class="h3">{item.country}</div>
                  <span class="badge">{admissionsCountryTargetStatusLabel(item.status)}</span>
                </div>
                <div class="muted mt-2">
                  当前结构化覆盖 {item.structuredCoveragePercent}% · 目标 {item.targetStructuredCoveragePercent}% · 还差 {item.targetGapPercent}%
                </div>
                <div class="muted mt-2">
                  项目 {item.totalPrograms} 个 · 已同步 {item.syncedCoveragePercent}% · 结构化字段 {item.structuredPrograms} 个 · 预计至少再补 {item.targetProgramGap} 个
                </div>
                <div class="muted mt-2">
                  {item.note}
                </div>
                {item.focusRecommendations.length ? (
                  <div class="mt-3">
                    <div class="muted">建议先补方向：</div>
                    <div class="mt-2">
                      {item.focusRecommendations.map((focus) => (
                        <div class="faq">
                          <div class="h3">{focus.major}</div>
                          <div class="muted mt-1">
                            项目 {focus.totalPrograms} 个 · 结构化覆盖 {focus.structuredCoveragePercent}% ·
                            待补抓 {focus.missingPrograms} 个
                          </div>
                          <div class="muted mt-1">
                            {focus.coolingDown
                              ? `冷却中 ${focus.cooldownRemainingHours}h · 上次 ${focus.lastRecommendationRunLabel}`
                              : `上次补齐：${focus.lastRecommendationRunLabel}`}
                          </div>
                          <div class="muted mt-1">
                            推荐分 {focus.recommendationScore} = 缺口 {focus.gapScore} + 久未执行 {focus.recencyBoostScore} - 冷却扣分 {focus.recencyPenaltyScore}
                          </div>
                          <div class="muted mt-1">
                            缺口拆解：缺失 {focus.missingGapScore} + 结构化 {focus.structuredGapScore} + 完整 {focus.completeGapScore} + 国家目标 {focus.targetGapScore} + 优先级 {focus.priorityScore} + 规模 {focus.volumeScore}
                          </div>
                          <div class="muted mt-2">{focus.description}</div>
                          <form method="POST" action={actions.syncStudyAbroadAdmissionsSnapshots} class="mt-3">
                            <input type="hidden" name="country" value={focus.country} />
                            <input type="hidden" name="degree" value={focus.degree} />
                            <input type="hidden" name="major" value={focus.major} />
                            <input type="hidden" name="mode" value="missing-first" />
                            <input type="hidden" name="maxPrograms" value={focus.maxPrograms} />
                            <input type="hidden" name="recordHistory" value="true" />
                            <button class="btn btn-ghost" type="submit">优先补这个方向</button>
                          </form>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : null}
                <form method="POST" action={actions.executeStudyAbroadAdmissionsCountryTargetPlan} class="mt-4">
                  <input type="hidden" name="country" value={item.country} />
                  <input type="hidden" name="degree" value="硕士" />
                  <input
                    type="hidden"
                    name="maxFocusPerCountry"
                    value={Math.min(3, Math.max(1, item.focusRecommendations.length || 1))}
                  />
                  <button class="btn" type="submit">按国家目标补推荐方向</button>
                </form>
                <form method="POST" action={actions.syncStudyAbroadAdmissionsSnapshots} class="mt-4">
                  <input type="hidden" name="country" value={item.country} />
                  <input type="hidden" name="degree" value="硕士" />
                  <input type="hidden" name="mode" value="missing-first" />
                  <input type="hidden" name="recordHistory" value="true" />
                  <input
                    type="hidden"
                    name="maxPrograms"
                    value={Math.min(12, Math.max(4, item.targetProgramGap || 4))}
                  />
                  <button class="btn btn-ghost" type="submit">优先补这个国家</button>
                </form>
              </div>
            ))
          ) : (
            <div class="faq">
              <div class="h3">还没有可展示的国家目标进度</div>
              <div class="muted mt-1">等更多国家进入项目层后，这里会开始显示每个重点国家的目标差值。</div>
            </div>
          )}
        </div>

        <form method="POST" action={actions.executeStudyAbroadAdmissionsCountryTargetPlan} class="mt-4">
          <input type="hidden" name="degree" value="硕士" />
          <input type="hidden" name="maxCountries" value="3" />
          <input type="hidden" name="maxFocusPerCountry" value="2" />
          <button class="btn btn-ghost" type="submit">按国家目标自动补前 3 个国家</button>
        </form>
      </div>

      <div class="card mt-4">
        <div class="card-top">
          <div>
            <div class="h3">最近预热记录</div>
            <div class="muted mt-1">这里会记住最近跑过哪些国家和方向，智能预热会尽量避开刚补过的组合。</div>
          </div>
          <span class="badge">History</span>
        </div>

        <div class="mt-4">
          {recentWarmupHistory.length ? (
            recentWarmupHistory.map((item) => (
              <div class="faq">
                <div class="h3">{item.label}</div>
                <div class="muted mt-1">
                  {admissionsHistoryModeLabel(item.mode)} · {item.runAt.slice(0, 16).replace("T", " ")}
                </div>
                <div class="muted mt-2">
                  同步 {item.syncedCount} 个 · 完整 {item.okCount} 个 · 部分 {item.partialCount} 个 · 待补抓 {item.unavailableCount} 个
                </div>
              </div>
            ))
          ) : (
            <div class="faq">
              <div class="h3">还没有预热记录</div>
              <div class="muted mt-1">跑过一轮热门方向或智能预热后，这里会开始积累轮换历史。</div>
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="mt-8" id="catalog-gaps">
      <div class="section-head">
        <div>
          <div class="section-kicker">Admissions Gaps</div>
          <h2 class="section-title">门槛覆盖缺口</h2>
          <p class="section-desc">这两张表专门看“哪里项目多、但门槛还没补厚”，方便你先抓最有价值的一批。</p>
        </div>
      </div>

      <div class="cards cards--2 mt-4">
        <article class="card">
          <div class="card-top">
            <div class="h3">按国家 / 地区看缺口</div>
            <span class="badge">Top 8</span>
          </div>

          <div class="mt-4">
            {topCountryGaps.map((item) => (
              <div class="faq">
                <div class="h3">{item.label}</div>
                <div class="muted mt-1">
                  项目 {item.totalPrograms} 个 · 已同步 {coveragePercent(item.syncedPrograms, item.totalPrograms)}% ·
                  有结构化字段 {coveragePercent(item.structuredPrograms, item.totalPrograms)}%
                </div>
                <div class="muted mt-2">
                  完整门槛 {item.completePrograms} 个 · 仍待补抓 {item.missingPrograms} 个
                </div>
              </div>
            ))}
          </div>
        </article>

        <article class="card">
          <div class="card-top">
            <div class="h3">按专业方向看缺口</div>
            <span class="badge">Top 8</span>
          </div>

          <div class="mt-4">
            {topDisciplineGaps.map((item) => (
              <div class="faq">
                <div class="h3">{item.label}</div>
                <div class="muted mt-1">
                  项目 {item.totalPrograms} 个 · 已同步 {coveragePercent(item.syncedPrograms, item.totalPrograms)}% ·
                  有结构化字段 {coveragePercent(item.structuredPrograms, item.totalPrograms)}%
                </div>
                <div class="muted mt-2">
                  完整门槛 {item.completePrograms} 个 · 仍待补抓 {item.missingPrograms} 个
                </div>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>

    <section class="mt-8" id="catalog-sources">
      <div class="section-head">
        <div>
          <div class="section-kicker">Sources</div>
          <h2 class="section-title">数据源注册表</h2>
          <p class="section-desc">先把每个来源的使用角色定清楚，后面接入时就不会边做边猜。</p>
        </div>
      </div>

      <div class="cards mt-4">
        {sources.map((source) => (
          <article class="card">
            <div class="card-top">
              <div>
                <div class="h3">{source.name}</div>
                <div class="muted mt-1">
                  {CATEGORY_LABELS[source.category]} / {ACCESS_LABELS[source.accessModel]} /{" "}
                  {source.scope === "global" ? "全球" : "单一国家"}
                </div>
              </div>
              <span class="badge">{STATUS_LABELS[source.status]}</span>
            </div>

            <p class="muted mt-3">{source.recommendedUse}</p>

            <div class="mt-3">
              <strong>覆盖地区：</strong>{source.regions.join("、")}
            </div>
            <div class="mt-2">
              <strong>可补字段：</strong>{source.fieldCoverage.join("、")}
            </div>
            <div class="mt-2">
              <strong>备注：</strong>{source.notes}
            </div>

            <div class="detail-actions mt-4">
              <a class="btn btn-ghost" href={source.url} target="_blank" rel="noreferrer">
                打开来源说明
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-8" id="catalog-preview">
      <div class="section-head">
        <div>
          <div class="section-kicker">Current Base</div>
          <h2 class="section-title">当前底库预览</h2>
          <p class="section-desc">这部分先从站内精选项目里拆出来，后面会逐步被正式数据源补强。</p>
        </div>
      </div>

      <div class="cards cards--2 mt-4">
        <article class="card">
          <div class="card-top">
            <div class="h3">学校底库预览</div>
            <span class="badge">{universityPreview.length}</span>
          </div>

          <div class="mt-4">
            {universityPreview.map((item) => (
              <div class="faq">
                <div class="h3">{item.name}</div>
                <div class="muted mt-1">
                  {item.country}
                  {item.stateOrProvince ? ` / ${item.stateOrProvince}` : ""}
                  {item.city ? ` / ${item.city}` : ""}
                  {` / ${item.websiteDomain || "官网待补"}`}
                </div>
                <div class="muted mt-2">
                  QS 排名：{item.qsRank ?? "待接入"} {item.rankingSource ? `(${item.rankingSource})` : ""}
                </div>
              </div>
            ))}
          </div>
        </article>

        <article class="card">
          <div class="card-top">
            <div class="h3">项目底库预览</div>
            <span class="badge">{programPreview.length}</span>
          </div>

          <div class="mt-4">
            {programPreview.map((item) => (
              <div class="faq">
                <div class="h3">{item.programName}</div>
                <div class="muted mt-1">
                  {item.schoolName} / {item.country}
                  {item.stateOrProvince ? ` / ${item.stateOrProvince}` : ""}
                  / {item.degree}
                </div>
                <div class="muted mt-2">
                  学科：{item.discipline} · 学费：{item.tuitionAmount || "待补"}{" "}
                  {item.tuitionCurrency || ""}
                </div>
                <div class="muted mt-2">
                  {admissionsStatusLabel(item.admissionsSnapshot?.extractionStatus)}
                  {item.admissionsSnapshot?.gpaMin
                    ? ` · GPA ${item.admissionsSnapshot.gpaMin}/${item.admissionsSnapshot.gpaScale || "4.0"}`
                    : ""}
                  {item.admissionsSnapshot?.ieltsMin
                    ? ` · IELTS ${item.admissionsSnapshot.ieltsMin}`
                    : ""}
                  {item.admissionsSnapshot?.toeflMin
                    ? ` · TOEFL ${item.admissionsSnapshot.toeflMin}`
                    : ""}
                </div>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>

    <section class="mt-8">
      <div class="card">
        <div class="h3">接下来最该做什么</div>
        <p class="muted mt-2">
          先把美国方向接成完整链路：大学底库、学校官网域名、项目层、学费字段、招生页字段、门槛快照覆盖率。等这条链路打通，再复制到英国和加拿大。
        </p>
        <div class="mt-4">
          {topSources.map((source) => (
            <div class="faq">
              <div class="h3">{source.name}</div>
              <div class="muted mt-1">{source.recommendedUse}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
