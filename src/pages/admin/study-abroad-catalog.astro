---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { actions } from "astro:actions";
import { readStudyAbroadCatalogSummary } from "../../lib/study-abroad-catalog-store";
import { readStudyAbroadCatalogSyncState } from "../../lib/study-abroad-catalog-sync";
import {
  STUDY_ABROAD_MAJOR_GROUPS,
  STUDY_ABROAD_MAJOR_SPECIALIZATIONS,
} from "../../lib/study-abroad-programs";
import {
  getStudyAbroadAdmissionsStrategyPresetId,
  getStudyAbroadAdmissionsStrategyPresets,
  readStudyAbroadAdmissionsCampaignCadence,
  readStudyAbroadAdmissionsCampaignOutlook,
  readStudyAbroadAdmissionsCampaignSchedule,
  readStudyAbroadAdmissionsCoverageGoalSummary,
  getStudyAbroadAdmissionsWarmupPresets,
  readStudyAbroadAdmissionsStrategy,
  readStudyAbroadAdmissionsCoverageSprintPlan,
  readStudyAbroadAdmissionsCoverageSprintRoadmap,
  readStudyAbroadAdmissionsCountryTargetExecutionQueue,
  readStudyAbroadAdmissionsCountryTargetPlans,
  readStudyAbroadAdmissionsWarmupRecommendations,
  readStudyAbroadAdmissionsWarmupState,
} from "../../lib/study-abroad-admissions-sync";

const adminUser = await Astro.session?.get("adminUser");
if (!adminUser) {
  return Astro.redirect("/admin/login");
}

const { sources, universities, programs, stats } = await readStudyAbroadCatalogSummary();
const catalogSyncState = await readStudyAbroadCatalogSyncState();
const latestCatalogSyncRun = catalogSyncState.runs[0] ?? null;
const syncResult = Astro.getActionResult(actions.syncUsStudyAbroadCatalog);
const syncSuccess = syncResult && !syncResult.error ? syncResult.data : null;
const globalSyncResult = Astro.getActionResult(actions.syncGlobalStudyAbroadUniversities);
const globalSyncSuccess = globalSyncResult && !globalSyncResult.error ? globalSyncResult.data : null;
const ukSyncResult = Astro.getActionResult(actions.syncUkStudyAbroadPilotPrograms);
const ukSyncSuccess = ukSyncResult && !ukSyncResult.error ? ukSyncResult.data : null;
const catalogSyncResult = Astro.getActionResult(actions.syncStudyAbroadCatalogSources);
const catalogSyncSuccess =
  catalogSyncResult && !catalogSyncResult.error ? catalogSyncResult.data : null;
const admissionsSyncResult = Astro.getActionResult(actions.syncStudyAbroadAdmissionsSnapshots);
const admissionsSyncSuccess =
  admissionsSyncResult && !admissionsSyncResult.error ? admissionsSyncResult.data : null;
const admissionsWarmupResult = Astro.getActionResult(actions.warmStudyAbroadAdmissionsCoverage);
const admissionsWarmupSuccess =
  admissionsWarmupResult && !admissionsWarmupResult.error ? admissionsWarmupResult.data : null;
const admissionsSmartWarmupResult = Astro.getActionResult(actions.smartWarmStudyAbroadAdmissionsCoverage);
const admissionsSmartWarmupSuccess =
  admissionsSmartWarmupResult && !admissionsSmartWarmupResult.error
    ? admissionsSmartWarmupResult.data
    : null;
const admissionsCountryTargetRunResult = Astro.getActionResult(
  actions.executeStudyAbroadAdmissionsCountryTargetPlan
);
const admissionsCountryTargetRunSuccess =
  admissionsCountryTargetRunResult && !admissionsCountryTargetRunResult.error
    ? admissionsCountryTargetRunResult.data
    : null;
const admissionsCoverageSprintResult = Astro.getActionResult(
  actions.executeStudyAbroadAdmissionsCoverageSprint
);
const admissionsCoverageSprintSuccess =
  admissionsCoverageSprintResult && !admissionsCoverageSprintResult.error
    ? admissionsCoverageSprintResult.data
    : null;
const admissionsCoverageRoadmapResult = Astro.getActionResult(
  actions.executeStudyAbroadAdmissionsCoverageRoadmap
);
const admissionsCoverageRoadmapSuccess =
  admissionsCoverageRoadmapResult && !admissionsCoverageRoadmapResult.error
    ? admissionsCoverageRoadmapResult.data
    : null;
const admissionsCampaignCadenceResult = Astro.getActionResult(
  actions.executeStudyAbroadAdmissionsCampaignCadence
);
const admissionsCampaignCadenceSuccess =
  admissionsCampaignCadenceResult && !admissionsCampaignCadenceResult.error
    ? admissionsCampaignCadenceResult.data
    : null;
const admissionsStrategyResult = Astro.getActionResult(actions.updateStudyAbroadAdmissionsStrategy);
const admissionsStrategySuccess =
  admissionsStrategyResult && !admissionsStrategyResult.error
    ? admissionsStrategyResult.data
    : null;

const STATUS_LABELS: Record<string, string> = {
  ready: "可直接开工",
  pilot: "适合试点",
  "needs-license": "需采购授权",
  research: "还需调研",
};

const ACCESS_LABELS: Record<string, string> = {
  api: "API",
  "open-data": "开放数据",
  licensed: "授权接入",
  manual: "人工/半自动",
};

const CATEGORY_LABELS: Record<string, string> = {
  official: "官方源",
  commercial: "商业源",
  "open-data": "开源/开放数据",
};

const rankCoverage = stats.universityCount
  ? Math.round((stats.qsCoverage / stats.universityCount) * 100)
  : 0;
const tuitionCoverage = stats.programCount
  ? Math.round((stats.tuitionCoverage / stats.programCount) * 100)
  : 0;
const admissionsCoverage = stats.programCount
  ? Math.round((stats.admissionsCoverage / stats.programCount) * 100)
  : 0;
const structuredAdmissionsCoverage = stats.programCount
  ? Math.round((stats.structuredAdmissionsCoverage / stats.programCount) * 100)
  : 0;

const topSources = sources.slice(0, 5);
const universityPreview = universities.slice(0, 8);
const programPreview = programs.slice(0, 8);
const programCountryOptions = Array.from(
  new Set(programs.map((item) => item.country).filter(Boolean))
).sort((a, b) => a.localeCompare(b, "zh-CN"));
const specializationOptions = Array.from(
  new Set(
    Object.values(STUDY_ABROAD_MAJOR_SPECIALIZATIONS)
      .flat()
      .filter(Boolean)
  )
).sort((a, b) => a.localeCompare(b, "zh-CN"));
const admissionsWarmupPresets = getStudyAbroadAdmissionsWarmupPresets();
const admissionsWarmupRecommendations = await readStudyAbroadAdmissionsWarmupRecommendations({
  limit: 6,
  degree: "硕士",
});
const admissionsCountryTargetPlans = await readStudyAbroadAdmissionsCountryTargetPlans({
  limit: 8,
  degree: "硕士",
  focusLimit: 3,
});
const admissionsCountryTargetQueue = await readStudyAbroadAdmissionsCountryTargetExecutionQueue({
  limit: 4,
  degree: "硕士",
  focusLimit: 2,
});
const admissionsCoverageSprintPlan = await readStudyAbroadAdmissionsCoverageSprintPlan({
  degree: "硕士",
  maxCountries: 2,
  maxFocusPerCountry: 2,
  maxRecommendations: 3,
});
const admissionsCoverageGoalSummary = await readStudyAbroadAdmissionsCoverageGoalSummary({
  degree: "硕士",
});
const admissionsCampaignOutlook = await readStudyAbroadAdmissionsCampaignOutlook({
  degree: "硕士",
});
const admissionsCampaignCadence = await readStudyAbroadAdmissionsCampaignCadence({
  degree: "硕士",
});
const admissionsCampaignSchedule = await readStudyAbroadAdmissionsCampaignSchedule({
  degree: "硕士",
});
const admissionsStrategy = await readStudyAbroadAdmissionsStrategy();
const admissionsCoverageSprintRoadmap = await readStudyAbroadAdmissionsCoverageSprintRoadmap({
  degree: "硕士",
  rounds: 3,
  maxCountries: 2,
  maxFocusPerCountry: 2,
  maxRecommendations: 3,
});
const admissionsStrategyPresets = getStudyAbroadAdmissionsStrategyPresets();
const activeAdmissionsStrategyPresetId =
  getStudyAbroadAdmissionsStrategyPresetId(admissionsStrategy);
const admissionsWarmupState = await readStudyAbroadAdmissionsWarmupState();
const recentWarmupHistory = admissionsWarmupState.history.slice(0, 6);
const topCountryGaps = stats.countryAdmissionsCoverage.slice(0, 8);
const topDisciplineGaps = stats.disciplineAdmissionsCoverage.slice(0, 8);
const admissionsStatusLabel = (status?: string | null) => {
  if (status === "ok") return "门槛已入库";
  if (status === "partial") return "门槛部分入库";
  if (status === "unavailable") return "门槛待补抓";
  return "未同步门槛";
};
const coveragePercent = (covered: number, total: number) =>
  total ? Math.round((covered / total) * 100) : 0;
const admissionsCountryTargetStatusLabel = (status: string) => {
  if (status === "reached") return "已达目标";
  if (status === "progressing") return "追赶中";
  return "待起量";
};
const admissionsHistoryModeLabel = (mode: string) => {
  if (mode === "preset") return "手动预热";
  if (mode === "sprint") return "覆盖冲刺";
  if (mode === "direct") return "定向同步";
  return "智能预热";
};
---

<BaseLayout title="管理员后台 - 留学院校底库" description="留学院校与项目底库规划面板">
  <main class="container page">
    <section class="catalog-hero">
      <div class="section-head">
        <div>
          <div class="section-kicker">Admin</div>
          <h1 class="section-title">留学院校底库</h1>
          <p class="section-desc">
            这里不是前台搜索结果，而是后续做“地区筛学校、专业筛项目、补 QS 排名和学费”的数据底座。
          </p>
        </div>

        <a class="btn btn-ghost" href="/admin">返回后台</a>
      </div>

      <div class="catalog-overview-grid mt-4">
        <article class="catalog-overview-card">
          <div class="muted text-sm">已登记数据源</div>
          <div class="h2 mt-2">{stats.sourceCount}</div>
          <div class="muted mt-2">按 2026 年 4 月 27 日核过一轮来源。</div>
        </article>

        <article class="catalog-overview-card">
          <div class="muted text-sm">底库规模</div>
          <div class="catalog-overview-stat-list mt-3">
            <div>
              <span>学校</span>
              <strong>{stats.universityCount}</strong>
            </div>
            <div>
              <span>项目</span>
              <strong>{stats.programCount}</strong>
            </div>
            <div>
              <span>国家 / 地区</span>
              <strong>{stats.countryCount}</strong>
            </div>
          </div>
        </article>

        <article class="catalog-overview-card">
          <div class="muted text-sm">基础字段覆盖</div>
          <div class="catalog-overview-dual mt-3">
            <div>
              <span>QS 排名</span>
              <strong>{rankCoverage}%</strong>
            </div>
            <div>
              <span>学费字段</span>
              <strong>{tuitionCoverage}%</strong>
            </div>
          </div>
          <div class="muted mt-3">排名还需要正式授权源，学费字段已经能支撑第一轮选校比较。</div>
        </article>

        <article class="catalog-overview-card">
          <div class="muted text-sm">门槛质量</div>
          <div class="catalog-overview-dual mt-3">
            <div>
              <span>门槛快照</span>
              <strong>{admissionsCoverage}%</strong>
            </div>
            <div>
              <span>可比对字段</span>
              <strong>{structuredAdmissionsCoverage}%</strong>
            </div>
          </div>
          <div class="muted mt-3">重点国家和热门硕士方向的结构化覆盖，还在继续往上推。</div>
        </article>
      </div>
    </section>

    {syncSuccess && (
      <div class="contact-notice contact-notice--success mt-4">
        {syncSuccess.message}
        {syncSuccess.usingDemoKey ? " 当前使用的是 demo key，适合试点验证，后续建议换正式 API key。" : ""}
      </div>
    )}

    {globalSyncSuccess && (
      <div class="contact-notice contact-notice--success mt-4">
        {globalSyncSuccess.message}
      </div>
    )}

    {ukSyncSuccess && (
      <div class="contact-notice contact-notice--success mt-4">
        {ukSyncSuccess.message}
      </div>
    )}

    {admissionsSyncSuccess && (
      <div class="contact-notice contact-notice--success mt-4">
        {admissionsSyncSuccess.message}
      </div>
    )}

    {admissionsWarmupSuccess && (
      <div class="contact-notice contact-notice--success mt-4">
        {admissionsWarmupSuccess.message}
      </div>
    )}

    {admissionsSmartWarmupSuccess && (
      <div class="contact-notice contact-notice--success mt-4">
        {admissionsSmartWarmupSuccess.message}
      </div>
    )}

    {admissionsCountryTargetRunSuccess && (
      <div class="contact-notice contact-notice--success mt-4">
        {admissionsCountryTargetRunSuccess.message}
      </div>
    )}

    {admissionsCoverageSprintSuccess && (
      <div class="contact-notice contact-notice--success mt-4">
        {admissionsCoverageSprintSuccess.message}
      </div>
    )}

    {admissionsCoverageRoadmapSuccess && (
      <div class="contact-notice contact-notice--success mt-4">
        {admissionsCoverageRoadmapSuccess.message}
      </div>
    )}

    {admissionsCampaignCadenceSuccess && (
      <div class="contact-notice contact-notice--success mt-4">
        {admissionsCampaignCadenceSuccess.message}
      </div>
    )}

    <nav class="catalog-nav mt-4">
      <a href="#catalog-roadmap">同步入口</a>
      <a href="#catalog-targets">目标与预热</a>
      <a href="#catalog-gaps">覆盖缺口</a>
      <a href="#catalog-sources">数据源</a>
      <a href="#catalog-preview">底库预览</a>
    </nav>

    <section class="mt-8" id="catalog-roadmap">
      <div class="section-head">
        <div>
          <div class="section-kicker">Roadmap</div>
          <h2 class="section-title">推荐落地顺序</h2>
          <p class="section-desc">先把最容易接、最有产出的源接进来，再逐步补齐排名和更大范围项目。</p>
        </div>
      </div>

      {catalogSyncSuccess && (
        <div class="contact-notice contact-notice--success mt-4">
          {catalogSyncSuccess.message}
        </div>
      )}

      <div class="card mt-4">
        <div class="card-top">
          <div>
            <div class="h3">统一底库同步</div>
            <div class="muted mt-1">把全球学校、美国试点和英国项目种子揉成同一轮同步，方便自动化和最近同步记录统一沉淀。</div>
          </div>
          <span class="badge">Sync</span>
        </div>

        <div class="catalog-queue-grid mt-4">
          <div class="catalog-queue-item">
            <div class="muted text-sm">最近一次同步</div>
            <div class="h2 mt-2">
              {latestCatalogSyncRun ? latestCatalogSyncRun.runAt.replace("T", " ").slice(0, 16) : "还未运行"}
            </div>
            <div class="muted mt-2">
              {latestCatalogSyncRun
                ? `${latestCatalogSyncRun.ok ? "成功" : "部分失败"} · ${latestCatalogSyncRun.trigger === "automation" ? "自动任务" : latestCatalogSyncRun.trigger === "script" ? "脚本" : "后台"}`
                : "建议先跑一轮，后面自动任务也会沿用这条入口。 "}
            </div>
          </div>
          <div class="catalog-queue-item">
            <div class="muted text-sm">最近净增</div>
            <div class="h2 mt-2">
              {latestCatalogSyncRun
                ? `校 ${latestCatalogSyncRun.delta.universityCount >= 0 ? "+" : ""}${latestCatalogSyncRun.delta.universityCount}`
                : "待运行"}
            </div>
            <div class="muted mt-2">
              {latestCatalogSyncRun
                ? `项目 ${latestCatalogSyncRun.delta.programCount >= 0 ? "+" : ""}${latestCatalogSyncRun.delta.programCount} · 国家 ${latestCatalogSyncRun.delta.countryCount >= 0 ? "+" : ""}${latestCatalogSyncRun.delta.countryCount}`
                : "运行后这里会显示本轮真实增量。"}
            </div>
          </div>
          <div class="catalog-queue-item">
            <div class="muted text-sm">自动同步命令</div>
            <div class="h2 mt-2">study-abroad:catalog-sync</div>
            <div class="muted mt-2">
              <code>npm run study-abroad:catalog-sync</code>
            </div>
            <div class="muted mt-2">
              如果还没配正式 <code>COLLEGE_SCORECARD_API_KEY</code>，脚本会默认跳过美国源，先稳定同步全球学校和英国项目种子。
            </div>
          </div>
        </div>

        {latestCatalogSyncRun && (
          <div class="mt-4">
            <div class="muted">{latestCatalogSyncRun.message}</div>
            <div class="catalog-queue-grid mt-3">
              {latestCatalogSyncRun.sourceRuns.map((sourceRun) => (
                <div class="catalog-queue-item">
                  <div class="card-top">
                    <div class="h3">{sourceRun.label}</div>
                    <span class="badge">{sourceRun.ok ? "成功" : "失败"}</span>
                  </div>
                  <div class="muted mt-2">{sourceRun.message}</div>
                  <div class="muted mt-2">
                    耗时 {Math.max(1, Math.round(sourceRun.durationMs / 1000))}s
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <form method="POST" action={actions.syncStudyAbroadCatalogSources} class="mt-4">
          <div class="form-grid">
            <label class="form-item">
              <span class="form-label">美国抓取页数</span>
              <input class="input" name="usMaxPages" type="number" min="1" max="30" value="10" />
              <p class="muted mt-2">默认沿用当前更稳的 10 页，后面有正式 key 再继续放大。</p>
            </label>
            <label class="form-item">
              <span class="form-label">美国每页数量</span>
              <input class="input" name="usPerPage" type="number" min="20" max="100" value="100" />
              <p class="muted mt-2">通常保持 100 更划算。</p>
            </label>
          </div>
          <div class="campaign-inline-actions mt-4">
            <input type="hidden" name="includeGlobal" value="true" />
            <input type="hidden" name="includeUs" value="true" />
            <input type="hidden" name="includeUk" value="true" />
            <button class="btn" type="submit">同步整套底库</button>
          </div>
        </form>
      </div>

      <div class="cards cards--3 mt-4">
        <article class="card">
          <div class="h3">第一阶段</div>
          <p class="muted mt-2">先接大学底库和美国官方项目源，快速把“地区筛学校”和“专业筛项目”的主链路跑通。</p>
          <div class="mt-3"><strong>建议顺序：</strong> Hipo -> College Scorecard</div>
        </article>

        <article class="card">
          <div class="h3">第二阶段</div>
          <p class="muted mt-2">补英国、加拿大、澳洲官方课程源，把热门留学地区扩成真正可检索的目录。</p>
          <div class="mt-3"><strong>建议顺序：</strong> Discover Uni / EduCanada / Course Seeker</div>
        </article>

        <article class="card">
          <div class="h3">第三阶段</div>
          <p class="muted mt-2">最后补商业排名和商业项目库，让排序、排名和覆盖面真正成体系。</p>
          <div class="mt-3"><strong>建议顺序：</strong> QS 授权 -> Studyportals 合作</div>
        </article>

        <article class="card">
          <div class="h3">学校层扩容</div>
          <p class="muted mt-2">先把全球学校底库铺开，再按国家逐个补官方项目层，这样选国家时不会再被学校数量卡住。</p>
          <div class="mt-3"><strong>建议顺序：</strong> Hipo 全球学校 -> 英/加/澳官方项目源</div>
        </article>
      </div>

      <div class="card mt-4" id="catalog-targets">
        <div class="card-top">
          <div>
            <div class="h3">美国试点同步</div>
            <div class="muted mt-1">先把美国学校底库和官方硕士项目层同步进来，后面再扩到英国、加拿大和澳洲。</div>
          </div>
          <span class="badge">Pilot</span>
        </div>

        <form method="POST" action={actions.syncUsStudyAbroadCatalog} class="mt-4">
          <div class="form-grid">
            <div class="form-item">
              <label class="form-label">抓取页数</label>
              <input class="input" name="maxPages" type="number" min="1" max="30" value="10" />
              <p class="muted mt-2">每页最多 100 所学校。当前 demo key 实测 10 页更稳；正式 API key 可以继续提高到 20-30 页。</p>
            </div>

            <div class="form-item">
              <label class="form-label">每页数量</label>
              <input class="input" name="perPage" type="number" min="20" max="100" value="100" />
              <p class="muted mt-2">建议保持 100，这样美国试点导入更完整一些。</p>
            </div>
          </div>

          <div class="mt-4">
            <button class="btn" type="submit">同步美国试点底库</button>
          </div>
        </form>
      </div>

      <div class="card mt-4">
        <div class="card-top">
          <div>
            <div class="h3">全球学校底库同步</div>
            <div class="muted mt-1">先把美国之外的学校目录铺进去，前台选国家后就能先拉出更完整的学校池。</div>
          </div>
          <span class="badge">Ready</span>
        </div>

        <form method="POST" action={actions.syncGlobalStudyAbroadUniversities} class="mt-4">
          <p class="muted">
            这一步只补学校层，不会替代美国官方项目层。同步完成后，国家下拉会扩成更完整的全球学校目录。
          </p>

          <div class="mt-4">
            <button class="btn" type="submit">同步全球学校底库</button>
          </div>
        </form>
      </div>

      <div class="card mt-4">
        <div class="card-top">
          <div>
            <div class="h3">英国硕士项目种子</div>
            <div class="muted mt-1">先把一批英国官网硕士项目写进项目层，让英国从“学校很多、项目很薄”推进到可直接检索项目。</div>
          </div>
          <span class="badge">Pilot</span>
        </div>

        <form method="POST" action={actions.syncUkStudyAbroadPilotPrograms} class="mt-4">
          <p class="muted">
            当前这批项目种子来自英国高校官方 postgraduate course pages，适合作为英国方向第一轮项目层补全。
          </p>

          <div class="mt-4">
            <button class="btn" type="submit">同步英国硕士项目种子</button>
          </div>
        </form>
      </div>

      <div class="card mt-4">
        <div class="card-top">
          <div>
            <div class="h3">招生门槛快照同步</div>
            <div class="muted mt-1">把官网里已经抓到的 GPA、语言、GRE / GMAT、工作经验字段沉淀回项目底库，后续搜索会优先吃这层快照。</div>
          </div>
          <span class="badge">Quality</span>
        </div>

        <form method="POST" action={actions.syncStudyAbroadAdmissionsSnapshots} class="mt-4">
          <div class="form-grid">
            <div class="form-item">
              <label class="form-label">同步项目数</label>
              <input class="input" name="maxPrograms" type="number" min="1" max="40" value="12" />
              <p class="muted mt-2">建议先从高优先级项目开始，每轮 8 到 20 个更稳。</p>
            </div>

            <div class="form-item">
              <label class="form-label">同步策略</label>
              <select class="input" name="mode">
