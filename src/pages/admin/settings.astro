---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { actions, isInputError } from "astro:actions";
import { readSiteSettings } from "../../lib/site-store";
import { normalizeImageUrl } from "../../lib/image-url";

const adminUser = await Astro.session?.get("adminUser");
if (!adminUser) {
  return Astro.redirect("/admin/login");
}

const current = await readSiteSettings();
const result = Astro.getActionResult(actions.updateSiteSettings);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const success = result && !result.error ? result.data : null;
const unauthorized =
  result?.error && "code" in result.error && result.error.code === "UNAUTHORIZED";
const consultAvatar = normalizeImageUrl(current.consultTeacherAvatar);
---

<BaseLayout title="管理员后台 - 站点设置" description="修改站点基础信息">
  <main class="container page">
    <div class="section-head">
      <div>
        <div class="section-kicker">Admin</div>
        <h1 class="section-title">站点基础信息设置</h1>
        <p class="section-desc">这里可以同时修改官网基础信息和右下角咨询浮窗内容。</p>
      </div>

      <a class="btn btn-ghost" href="/admin">返回后台</a>
    </div>

    {success && (
      <div class="contact-notice contact-notice--success mt-4">
        {success.message}
      </div>
    )}

    {unauthorized && (
      <div class="contact-notice contact-notice--error mt-4">
        请先重新登录管理员后台。
      </div>
    )}

    <form method="POST" action={actions.updateSiteSettings} class="mt-4">
      <div class="cards cards--2">
        <section class="card">
          <div class="h3">站点基础信息</div>
          <p class="muted mt-2">公司名称、联系电话和邮箱会同时用于前台联系区与咨询浮窗。</p>

          <div class="form-grid mt-4">
            <div class="form-item">
              <label class="form-label" for="site-companyName">公司名称</label>
              <input
                class="input"
                id="site-companyName"
                name="companyName"
                type="text"
                value={current.companyName}
                required
              />
              {inputErrors.companyName && (
                <p class="form-error">{inputErrors.companyName.join("，")}</p>
              )}
            </div>

            <div class="form-item">
              <label class="form-label" for="site-phone">联系电话</label>
              <input
                class="input"
                id="site-phone"
                name="phone"
                type="text"
                value={current.phone}
                required
              />
              {inputErrors.phone && (
                <p class="form-error">{inputErrors.phone.join("，")}</p>
              )}
            </div>
          </div>

          <div class="form-item mt-4">
            <label class="form-label" for="site-slogan">站点标语</label>
            <input
              class="input"
              id="site-slogan"
              name="slogan"
              type="text"
              value={current.slogan}
              required
            />
            {inputErrors.slogan && (
              <p class="form-error">{inputErrors.slogan.join("，")}</p>
            )}
          </div>

          <div class="form-grid mt-4">
            <div class="form-item">
              <label class="form-label" for="site-email">邮箱</label>
              <input
                class="input"
                id="site-email"
                name="email"
                type="email"
                value={current.email}
                required
              />
              {inputErrors.email && (
                <p class="form-error">{inputErrors.email.join("，")}</p>
              )}
            </div>

            <div class="form-item">
              <label class="form-label" for="site-wechat">微信号</label>
              <input
                class="input"
                id="site-wechat"
                name="wechat"
                type="text"
                value={current.wechat}
                required
              />
              {inputErrors.wechat && (
                <p class="form-error">{inputErrors.wechat.join("，")}</p>
              )}
            </div>
          </div>
        </section>

        <section class="card site-settings-card">
          <div class="h3">咨询浮窗老师信息</div>
          <p class="muted mt-2">这里控制浮窗里的老师头像、姓名和顶部状态文案。</p>

          <div class="form-grid mt-4">
            <div class="form-item">
              <label class="form-label" for="consultTeacherName">老师姓名</label>
              <input
                class="input"
                id="consultTeacherName"
                name="consultTeacherName"
                type="text"
                value={current.consultTeacherName}
              />
            </div>

            <div class="form-item">
              <label class="form-label" for="consultStatusText">顶部状态文案</label>
              <input
                class="input"
                id="consultStatusText"
                name="consultStatusText"
                type="text"
                value={current.consultStatusText}
              />
            </div>
          </div>

          <div class="form-item mt-4">
            <label class="form-label" for="consultTeacherAvatar">老师头像路径</label>
            <input
              class="input"
              id="consultTeacherAvatar"
              name="consultTeacherAvatar"
              type="text"
              value={current.consultTeacherAvatar}
              data-site-image-path
            />
          </div>

          <div class="form-item mt-4">
            <label class="form-label">上传老师头像</label>
            <input class="input" type="file" accept="image/*" data-site-image-upload />
            <p class="muted mt-2" data-site-upload-status></p>
            {consultAvatar ? (
              <img
                class="mt-3"
                src={consultAvatar}
                data-site-image-preview
                style="width: 96px; height: 96px; border-radius: 8px; object-fit: cover;"
              />
            ) : (
              <img
                class="mt-3"
                data-site-image-preview
                style="width: 96px; height: 96px; border-radius: 8px; object-fit: cover; display:none;"
              />
            )}
          </div>
        </section>
      </div>

      <section class="card mt-6">
        <div class="h3">咨询浮窗文案</div>
        <p class="muted mt-2">支持调整欢迎语、国家问题、阶段问题、联系方式引导和 3 秒自动提醒。</p>

        <div class="form-item mt-4">
          <label class="form-label" for="consultWelcomeMessage">欢迎语</label>
          <textarea
            class="input"
            id="consultWelcomeMessage"
            name="consultWelcomeMessage"
            rows="3"
          >{current.consultWelcomeMessage}</textarea>
        </div>

        <div class="form-grid mt-4">
          <div class="form-item">
            <label class="form-label" for="consultCountryPrompt">国家问题文案</label>
            <input
              class="input"
              id="consultCountryPrompt"
              name="consultCountryPrompt"
              type="text"
              value={current.consultCountryPrompt}
            />
          </div>

          <div class="form-item">
            <label class="form-label" for="consultCountryOptions">国家按钮（逗号分隔）</label>
            <input
              class="input"
              id="consultCountryOptions"
              name="consultCountryOptions"
              type="text"
              value={current.consultCountryOptions}
            />
          </div>
        </div>

        <div class="form-grid mt-4">
          <div class="form-item">
            <label class="form-label" for="consultStagePrompt">阶段问题文案</label>
            <input
              class="input"
              id="consultStagePrompt"
              name="consultStagePrompt"
              type="text"
              value={current.consultStagePrompt}
            />
          </div>

          <div class="form-item">
            <label class="form-label" for="consultStageOptions">阶段按钮（逗号分隔）</label>
            <input
              class="input"
              id="consultStageOptions"
              name="consultStageOptions"
              type="text"
              value={current.consultStageOptions}
            />
          </div>
        </div>

        <div class="form-item mt-4">
          <label class="form-label" for="consultContactMessage">联系方式引导文案</label>
          <textarea
            class="input"
            id="consultContactMessage"
            name="consultContactMessage"
            rows="4"
          >{current.consultContactMessage}</textarea>
        </div>

        <div class="form-item mt-4">
          <label class="form-label" for="consultIdleMessage">3 秒无操作自动提醒文案</label>
          <textarea
            class="input"
            id="consultIdleMessage"
            name="consultIdleMessage"
            rows="3"
          >{current.consultIdleMessage}</textarea>
          <p class="muted mt-2">
            支持占位符：<code>{"{{wechat}}"}</code>、<code>{"{{phone}}"}</code>、<code>{"{{teacherName}}"}</code>。
          </p>
        </div>

        <div class="mt-4">
          <button class="btn" type="submit">保存站点与浮窗设置</button>
        </div>
      </section>
    </form>
  </main>

  <script is:inline>
    (() => {
      const uploadInput = document.querySelector("[data-site-image-upload]");
      const pathInput = document.querySelector("[data-site-image-path]");
      const statusEl = document.querySelector("[data-site-upload-status]");
      const previewEl = document.querySelector("[data-site-image-preview]");

      if (!(uploadInput instanceof HTMLInputElement)) return;
      if (!(pathInput instanceof HTMLInputElement)) return;

      uploadInput.addEventListener("change", async () => {
        const file = uploadInput.files?.[0];
        if (!file) return;

        if (statusEl) statusEl.textContent = "上传中...";

        const formData = new FormData();
        formData.append("file", file);

        try {
          const res = await fetch("/api/admin/upload-site-image", {
            method: "POST",
            body: formData,
          });

          const data = await res.json();

          if (!res.ok || !data?.ok) {
            throw new Error(data?.message || "上传失败");
          }

          pathInput.value = data.path;

          if (previewEl instanceof HTMLImageElement) {
            previewEl.src = data.path;
            previewEl.style.display = "block";
          }

          if (statusEl) statusEl.textContent = "上传成功";
        } catch (error) {
          if (statusEl) {
            statusEl.textContent =
              error instanceof Error ? error.message : "上传失败";
          }
        }
      });
    })();
  </script>
</BaseLayout>
