---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { readSiteSettings } from "../lib/site-store";
import { readTeachers } from "../lib/teachers-store";
import { readServices } from "../lib/services-store";
import { readScores } from "../lib/scores-store";

import ScoreCarousel from "../components/ScoreCarousel.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import StudyAbroadSection from "../components/StudyAbroadSection.astro";
import TeacherShowcase from "../components/TeacherShowcase.astro";
import NewsFeed from "../components/NewsFeed.astro";
import ContactSection from "../components/ContactSection.astro";
import { readExams } from "../lib/exams-store";
import { STUDY_ABROAD_PROGRAMS } from "../lib/study-abroad-programs";
import { getStudyAbroadUniversityNameZh } from "../lib/study-abroad-university-names";
const site = await readSiteSettings();
const teachers = await readTeachers();

const scores = await readScores();
const services = await readServices();
const exams = await readExams();
const abroadServices = services.filter((service) => service.category === "abroad");
const contactOptions = Array.from(
  new Set(
    exams
      .map((exam) => exam.title)
      .map((item) => item.trim())
      .filter(Boolean)
  )
);
const studyAbroadCountryCount = new Set(STUDY_ABROAD_PROGRAMS.map((program) => program.country)).size;
const featuredPrograms = STUDY_ABROAD_PROGRAMS.slice(0, 3).map((program) => ({
  country: program.country,
  degree: program.degree,
  schoolName: getStudyAbroadUniversityNameZh(program.schoolName) || program.schoolName,
  programName: program.programName,
}));
const heroMetrics = [
  {
    value: `${studyAbroadCountryCount}+`,
    label: "国家 / 地区",
  },
  {
    value: `${STUDY_ABROAD_PROGRAMS.length}+`,
    label: "项目底库",
  },
  {
    value: `${teachers.length || 3}+`,
    label: "顾问 / 老师",
  },
];
const heroDeliverables = [
  {
    title: "首轮项目池",
    body: "先给你一批值得继续看的学校和项目，不再从海量官网里盲找。",
  },
  {
    title: "背景短板",
    body: "把 GPA、语言、实习或课程背景里真正影响申请的部分挑出来。",
  },
  {
    title: "申请节奏",
    body: "知道下一步先补什么，再安排文书、推荐信和递交时间。",
  },
];
const heroContactItems = [
  {
    label: "顾问",
    value: String(site.consultTeacherName || "周老师").trim(),
  },
  {
    label: "电话",
    value: String(site.phone || "").trim(),
  },
  {
    label: "微信",
    value: String(site.wechat || "").trim(),
  },
].filter((item) => item.value && item.value !== "待填写");
---

<BaseLayout
  title={site.companyName ?? "Wanhe Education"}
  description={site.slogan ?? ""}
>
  <main>
    <section class="hero-section hero-section--immersive">
      <div class="container hero-stack">
        <div class="hero-copy hero-copy--centered">
          <div class="hero-kicker hero-kicker--soft">2026 Intake · Wanhe Education</div>
          <h1 class="hero-title">让留学<br>更加简单<br>让语言<br>没有阻碍</h1>
          <p class="hero-subtitle">
            {site.slogan ??
              "从语言提分到留学申请，把国家、项目、门槛和时间线收拢到同一套更清楚的界面里。"}
          </p>

          <div class="hero-actions hero-actions--centered">
            <a class="btn" href="/school-finder">开始选校</a>
            <a class="btn btn-ghost-dark" href="#contact">预约咨询</a>
          </div>

          <div class="hero-points hero-points--centered">
            <span class="hero-pill">官方项目页</span>
            <span class="hero-pill">语言提分</span>
            <span class="hero-pill">留学申请</span>
            <span class="hero-pill">1v1 规划</span>
          </div>
        </div>

        <div class="hero-showcase">
          <article class="hero-spotlight-card">
            <span class="hero-spotlight-label">Selection Engine</span>
            <strong>国家、项目、门槛与申请节奏，同屏收拢。</strong>
            <p>
              先看清学校与项目池，再决定文书、递交和出分安排。复杂留学流程，也可以像消费电子产品页一样清楚、安静、好扫读。
            </p>

            <div class="hero-spotlight-metrics">
              {heroMetrics.map((item) => (
                <div class="hero-spotlight-metric">
                  <strong>{item.value}</strong>
                  <span>{item.label}</span>
                </div>
              ))}
            </div>
          </article>

          <article class="hero-mini-card">
            <div class="hero-mini-kicker">Featured Programs</div>
            <div class="hero-mini-title">你会先看到这些项目样例。</div>
            <div class="hero-program-list">
              {featuredPrograms.map((program) => (
                <div class="hero-program-item">
                  <small>{program.country} · {program.degree}</small>
                  <strong>{program.schoolName}</strong>
                  <span>{program.programName}</span>
                </div>
              ))}
            </div>
          </article>

          <article class="hero-results-card">
            <div class="hero-results-copy">
              <div class="hero-mini-kicker">Consulting</div>
              <div class="hero-mini-title">先拿到一轮判断，再决定要不要深入申请。</div>
              <p class="hero-results-desc">
                你不需要先看完所有学校官网。把目标国家、专业方向和当前成绩告诉我们，先拿到值得继续看的项目池和下一步建议。
              </p>

              <div class="hero-conversion-actions">
                <a class="btn" href="#contact">预约顾问咨询</a>
                <a class="btn btn-ghost-dark" href="/school-finder">直接开始选校</a>
              </div>
            </div>

            <div class="hero-results-side">
              <div class="hero-outcome-list">
                {heroDeliverables.map((item) => (
                  <div class="hero-outcome-item">
                    <strong>{item.title}</strong>
                    <p>{item.body}</p>
                  </div>
                ))}
              </div>

              {heroContactItems.length ? (
                <div class="hero-contact-row">
                  {heroContactItems.map((item) => (
                    <div class="hero-contact-chip">
                      <span>{item.label}</span>
                      <strong>{item.value}</strong>
                    </div>
                  ))}
                </div>
              ) : null}
            </div>
          </article>
        </div>
      </div>
    </section>

    {exams.length ? (
      <section class="section-block">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="section-kicker">Exams</div>
              <h2 class="section-title">语言 / 考试服务</h2>
              <p class="section-desc">点击进入查看每个考试项目的完整介绍与学习建议</p>
            </div>
            <a class="section-link" href="/exams">查看全部考试 →</a>
          </div>

          <div class="exam-grid">
            {exams.slice(0, 6).map((e) => (
              <a class="exam-card" href={`/exams/${e.id}`}>
                <h3>{e.title}</h3>
                {e.subtitle ? <p>{e.subtitle}</p> : null}
                {e.tags?.length ? (
                  <div class="card-tags">
                    {e.tags.slice(0, 4).map((t: string) => (
                      <span>{t}</span>
                    ))}
                  </div>
                ) : null}
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : null}

    {abroadServices.length ? (
      <section class="section-block compact-top">
        <StudyAbroadSection services={services} />
      </section>
    ) : null}

    <section class="section-block compact-top">
      <ScoreCarousel scores={scores} />
    </section>

    <section class="section-block compact-top">
      <ServiceGrid services={services} />
    </section>

    <section class="section-block compact-top">
      <TeacherShowcase teachers={teachers} />
    </section>

    <section class="section-block compact-top">
      <NewsFeed />
    </section>

    <section class="section-block compact-top">
      <ContactSection site={site} examOptions={contactOptions} />
    </section>
  </main>
</BaseLayout>
