---
import { readNewsFeed } from "../lib/news-feed";

const title = "最新考试动态";
const initialNewsState = await readNewsFeed("all", 6);
const formatDate = (value?: string) => {
  if (!value) return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;

  return new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date);
};

const TAGS = [
  { key: "all", label: "全部" },
  { key: "toefl", label: "TOEFL" },
  { key: "ielts", label: "IELTS" },
  { key: "gre", label: "GRE" },
  { key: "det", label: "DET" },
  { key: "toeic", label: "TOEIC" },
];
---

<section class="container reveal" id="news">
  <div class="section-head">
    <div>
      <div class="section-kicker">News</div>
      <h2 class="section-title">{title}</h2>
      <p class="section-desc">把考试时间线、报名窗口和政策变化收拢在一屏里。</p>
    </div>

    <div class="news-filters" data-news-filters>
      {TAGS.map((tag) => (
        <button
          class={`news-filter ${tag.key === "all" ? "is-active" : ""}`}
          data-tag={tag.key}
          type="button"
        >
          {tag.label}
        </button>
      ))}
    </div>
  </div>

  <div class="news-shell">
    <div class="muted" data-news-status>{initialNewsState.items.length ? "" : "暂无动态"}</div>
    <div class="news-grid" data-news-list>
      {initialNewsState.items.map((item) => (
        <a class="news-card" href={item.link} target="_blank" rel="noreferrer">
          <div class="news-card-source">{item.source || "News"}</div>
          <div class="news-card-title">{item.title || ""}</div>
          {item.pubDate ? <div class="news-card-date">{formatDate(item.pubDate)}</div> : null}
          {item.snippet ? <p class="news-card-snippet">{item.snippet}</p> : null}
          <div class="news-card-cta">查看原文 →</div>
        </a>
      ))}
    </div>
  </div>

  <script
    type="application/json"
    data-news-initial
    is:inline
    set:html={JSON.stringify(initialNewsState)}
  ></script>

  <script is:inline>
    (() => {
      const root = document.currentScript?.closest("#news");
      if (!root) return;

      const statusEl = root.querySelector("[data-news-status]");
      const listEl = root.querySelector("[data-news-list]");
      const buttons = Array.from(root.querySelectorAll("[data-tag]"));
      const initialDataEl = root.querySelector("[data-news-initial]");

      let controller = null;
      let initialState = {
        items: [],
        cached: false,
        stale: false,
        fallback: false,
      };

      try {
        initialState = {
          ...initialState,
          ...JSON.parse(initialDataEl?.textContent || "{}"),
        };
      } catch {}

      const esc = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (char) => {
          const map = {
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          };
          return map[char] || char;
        });

      const formatDate = (value) => {
        if (!value) return "";
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return value;

        return new Intl.DateTimeFormat("zh-CN", {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        }).format(date);
      };

      const render = (items) => {
        if (!listEl) return;

        listEl.innerHTML = items
          .map((item) => {
            const source = esc(item.source || "News");
            const title = esc(item.title || "");
            const link = esc(item.link || "#");
            const date = item.pubDate ? formatDate(item.pubDate) : "";
            const snippet = esc(item.snippet || "");

            return `
              <a class="news-card" href="${link}" target="_blank" rel="noreferrer">
                <div class="news-card-source">${source}</div>
                <div class="news-card-title">${title}</div>
                ${date ? `<div class="news-card-date">${esc(date)}</div>` : ""}
                ${snippet ? `<p class="news-card-snippet">${snippet}</p>` : ""}
                <div class="news-card-cta">查看原文 →</div>
              </a>
            `;
          })
          .join("");
      };

      const setActive = (tag) => {
        buttons.forEach((btn) => {
          const active = btn.getAttribute("data-tag") === tag;
          btn.classList.toggle("is-active", active);
        });
      };

      const load = async (tag, options = {}) => {
        setActive(tag);

        if (controller) controller.abort();
        controller = new AbortController();

        if (!options.preserveContent) {
          if (statusEl) statusEl.textContent = "加载中...";
          if (listEl) listEl.innerHTML = "";
        }

        try {
          const res = await fetch(`/api/news?tag=${encodeURIComponent(tag)}&limit=6`, {
            signal: controller.signal,
          });

          const data = await res.json();
          const items = Array.isArray(data?.items) ? data.items : [];

          if (!items.length) {
            if (!options.preserveContent || !listEl?.children.length) {
              if (statusEl) statusEl.textContent = "暂无动态";
            }
            return;
          }

          if (statusEl) statusEl.textContent = "";
          render(items);
        } catch (error) {
          if (error?.name === "AbortError") return;
          if (statusEl) statusEl.textContent = "加载失败，请稍后再试";
          if (!options.preserveContent && listEl) listEl.innerHTML = "";
        }
      };

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tag = btn.getAttribute("data-tag") || "all";
          load(tag);
        });
      });

      setActive("all");

      if (Array.isArray(initialState.items) && initialState.items.length) {
        if (statusEl) statusEl.textContent = "";
        render(initialState.items);
      }

      if (initialState.stale || initialState.fallback) {
        load("all", {
          preserveContent: true,
        });
      }
    })();
  </script>
</section>
