---
import { actions, isInputError } from "astro:actions";

type SiteData = {
  companyName?: string;
  phone?: string;
  email?: string;
  wechat?: string;
};

type Props = {
  site: SiteData;
  examOptions?: string[];
};

const { site, examOptions = [] } = Astro.props as Props;

const result = Astro.getActionResult(actions.contactLead);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const success = result && !result.error ? result.data : null;
const hasCommonError = result?.error && !isInputError(result.error);

const fallbackExamOptions = ["TOEFL", "IELTS", "GRE", "DET", "TOEIC", "留学申请"];
const normalizedExamOptions = Array.from(
  new Set(
    (examOptions.length ? examOptions : fallbackExamOptions)
      .map((item) => String(item).trim())
      .filter(Boolean)
  )
);
const contactDraftStorageKey = "study-abroad-contact-draft-v1";
---

<section id="contact" class="container reveal">
  <div class="contact-stage">
    <div class="contact-stage-copy">
      <div class="section-kicker">Appointment</div>
      <h2 class="section-title">把你的申请节奏，先拉清楚。</h2>
      <p class="section-desc">
        提交预约后，我们会根据你的考试方向、留学目标和时间窗口，安排更合适的顾问或老师和你对接。
      </p>

      <div class="contact-stage-tags">
        <span>语言提分</span>
        <span>留学申请</span>
        <span>选校规划</span>
        <span>文书递交</span>
      </div>

      <div class="contact-meta-grid">
        <div class="contact-meta-card">
          <span>电话</span>
          <strong>{site.phone ?? "待填写"}</strong>
        </div>
        <div class="contact-meta-card">
          <span>邮箱</span>
          <strong>{site.email ?? "待填写"}</strong>
        </div>
        <div class="contact-meta-card">
          <span>微信</span>
          <strong>{site.wechat ?? "待填写"}</strong>
        </div>
      </div>
    </div>

    <div class="contact-stage-form">
      {success && (
        <div class="contact-notice contact-notice--success">
          {success.message}
        </div>
      )}

      {hasCommonError && (
        <div class="contact-notice contact-notice--error">
          提交失败，请稍后重试。
        </div>
      )}

      <div class="contact-notice contact-notice--info" data-role="contact-prefill-note" hidden>
        <div>
          <strong>已从选校页带入咨询摘要</strong>
          <p data-role="contact-prefill-note-text">你可以直接补充联系方式和期望时间后提交。</p>
        </div>
        <button class="contact-notice-action" type="button" data-role="contact-prefill-clear">
          清除带入
        </button>
      </div>

      <form method="POST" action={actions.contactLead} class="contact-shell" data-role="contact-form">
        <input type="hidden" name="source" value="homepage" data-role="contact-source" />

        <div class="form-grid">
          <div class="form-item">
            <label class="form-label" for="contact-name">姓名</label>
            <input
              class="input"
              id="contact-name"
              name="name"
              type="text"
              placeholder="如：张同学 / Li"
              required
            />
            {inputErrors.name && (
              <p class="form-error">{inputErrors.name.join("，")}</p>
            )}
          </div>

          <div class="form-item">
            <label class="form-label" for="contact-contact">联系方式</label>
            <input
              class="input"
              id="contact-contact"
              name="contact"
              type="text"
              placeholder="微信 / 手机 / 邮箱"
              required
            />
            {inputErrors.contact && (
              <p class="form-error">{inputErrors.contact.join("，")}</p>
            )}
          </div>
        </div>

        <div class="form-grid mt-4">
          <div class="form-item">
            <label class="form-label" for="appointment-type">预约类型</label>
            <select class="input" id="appointment-type" name="appointmentType" data-role="contact-appointment-type" required>
              <option value="trial">预约试听</option>
              <option value="consultation">预约咨询</option>
            </select>
            {inputErrors.appointmentType && (
              <p class="form-error">{inputErrors.appointmentType.join("，")}</p>
            )}
          </div>

          <div class="form-item">
            <label class="form-label" for="exam-type">考试类型</label>
            <select class="input" id="exam-type" name="examType" data-role="contact-exam-type" required>
              <option value="">请选择</option>
              {normalizedExamOptions.map((option) => (
                <option value={option}>{option}</option>
              ))}
            </select>
            {inputErrors.examType && (
              <p class="form-error">{inputErrors.examType.join("，")}</p>
            )}
          </div>
        </div>

        <div class="form-item mt-4">
          <label class="form-label" for="preferred-time">期望时间段</label>
          <input
            class="input"
            id="preferred-time"
            name="preferredTime"
            data-role="contact-preferred-time"
            type="text"
            placeholder="如：本周六下午 / 工作日晚上 7 点后"
            required
          />
          {inputErrors.preferredTime && (
            <p class="form-error">{inputErrors.preferredTime.join("，")}</p>
          )}
        </div>

        <div class="form-item mt-4">
          <label class="form-label" for="contact-need">补充需求</label>
          <textarea
            class="input"
            id="contact-need"
            name="need"
            data-role="contact-need-input"
            placeholder="如：托福口语提分，目标 26+；想申请美国 CS 硕士，先看项目池"
            required
          ></textarea>
          {inputErrors.need && (
            <p class="form-error">{inputErrors.need.join("，")}</p>
          )}
        </div>

        <div class="mt-4">
          <button class="btn" type="submit">提交预约</button>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline define:vars={{ contactDraftStorageKey }}>
  const contactRoot = document.querySelector("#contact");

  if (contactRoot) {
    const form = contactRoot.querySelector('[data-role="contact-form"]');
    const sourceInput = contactRoot.querySelector('[data-role="contact-source"]');
    const appointmentTypeInput = contactRoot.querySelector('[data-role="contact-appointment-type"]');
    const examTypeInput = contactRoot.querySelector('[data-role="contact-exam-type"]');
    const preferredTimeInput = contactRoot.querySelector('[data-role="contact-preferred-time"]');
    const needInput = contactRoot.querySelector('[data-role="contact-need-input"]');
    const prefillNote = contactRoot.querySelector('[data-role="contact-prefill-note"]');
    const prefillNoteText = contactRoot.querySelector('[data-role="contact-prefill-note-text"]');
    const clearPrefillButton = contactRoot.querySelector('[data-role="contact-prefill-clear"]');

    const readDraft = () => {
      try {
        const raw = window.localStorage.getItem(contactDraftStorageKey);
        if (!raw) {
          return null;
        }
        const parsed = JSON.parse(raw);
        return parsed && typeof parsed === "object" ? parsed : null;
      } catch {
        return null;
      }
    };

    const clearDraft = () => {
      try {
        window.localStorage.removeItem(contactDraftStorageKey);
      } catch {}
    };

    const setSelectValueIfPresent = (node, value) => {
      if (!(node instanceof HTMLSelectElement) || !value) {
        return;
      }
      const hasOption = Array.from(node.options).some((option) => option.value === value);
      if (hasOption) {
        node.value = value;
      }
    };

    const updatePrefillNotice = (draft) => {
      if (!(prefillNote instanceof HTMLElement) || !(prefillNoteText instanceof HTMLElement)) {
        return;
      }
      if (!draft) {
        prefillNote.hidden = true;
        prefillNoteText.textContent = "你可以直接补充联系方式和期望时间后提交。";
        return;
      }
      const createdAt = draft.createdAt ? new Date(draft.createdAt) : null;
      const timeText =
        createdAt instanceof Date && Number.isFinite(createdAt.getTime())
          ? createdAt.toLocaleString("zh-CN", { hour12: false })
          : "刚刚";
      prefillNote.hidden = false;
      prefillNoteText.textContent = `已带入选校摘要（${timeText}），建议补充联系方式和期望时间后直接提交。`;
    };

    const applyDraft = (draft) => {
      if (!draft) {
        updatePrefillNotice(null);
        return;
      }

      if (sourceInput instanceof HTMLInputElement) {
        sourceInput.value = draft.source === "school-finder" ? "school-finder" : sourceInput.value;
      }
      setSelectValueIfPresent(appointmentTypeInput, draft.appointmentType || "consultation");
      setSelectValueIfPresent(examTypeInput, draft.examType || "留学申请");

      if (preferredTimeInput instanceof HTMLInputElement && !preferredTimeInput.value.trim()) {
        preferredTimeInput.value = String(draft.preferredTime || "希望先做选校咨询").trim();
      }

      if (needInput instanceof HTMLTextAreaElement) {
        const existing = needInput.value.trim();
        const summary = String(draft.summary || "").trim();
        if (summary && (!existing || !existing.includes(summary))) {
          needInput.value = summary;
        }
      }

      updatePrefillNotice(draft);
    };

    const params = new URLSearchParams(window.location.search);
    const shouldAttemptPrefill = params.get("prefill") === "school-finder";
    const draft = readDraft();

    if (shouldAttemptPrefill && draft) {
      applyDraft(draft);
    } else {
      updatePrefillNotice(null);
    }

    if (clearPrefillButton instanceof HTMLButtonElement) {
      clearPrefillButton.addEventListener("click", () => {
        clearDraft();
        if (needInput instanceof HTMLTextAreaElement) {
          needInput.value = "";
        }
        if (sourceInput instanceof HTMLInputElement) {
          sourceInput.value = "homepage";
        }
        updatePrefillNotice(null);
      });
    }

    if (form instanceof HTMLFormElement) {
      form.addEventListener("submit", () => {
        clearDraft();
      });
    }
  }
</script>
