---
import { normalizeImageUrl } from "../lib/image-url";
import type { RuntimeSiteSettings } from "../lib/site-store";

type Props = {
  site: Partial<RuntimeSiteSettings>;
  currentPath?: string;
};

const { site, currentPath = "/" } = Astro.props as Props;

const widgetConfig = {
  companyName: String(site.companyName ?? "留学咨询").trim() || "留学咨询",
  teacherName: String(site.consultTeacherName ?? "周老师").trim() || "周老师",
  teacherAvatar: normalizeImageUrl(site.consultTeacherAvatar ?? ""),
  statusText: String(site.consultStatusText ?? "正在为您服务").trim() || "正在为您服务",
  phone: String(site.phone ?? "").trim(),
  wechat: String(site.wechat ?? "").trim(),
  contactHref: currentPath === "/" ? "#contact" : "/#contact",
  studyHref: currentPath === "/" ? "#study-abroad" : "/#study-abroad",
  welcomeMessage:
    String(site.consultWelcomeMessage ?? "").trim() ||
    "亲爱的同学 / 家长您好，欢迎来到留学咨询窗口。我们可以先帮您梳理国家方向、申请阶段和准备时间线。",
  countryPrompt:
    String(site.consultCountryPrompt ?? "").trim() ||
    "您想了解哪个国家或地区的留学呢？",
  countryOptions:
    String(site.consultCountryOptions ?? "").trim() ||
    "美国,英国,澳洲,加拿大,中国港澳,日本,韩国,新加坡,马来西亚",
  stagePrompt:
    String(site.consultStagePrompt ?? "").trim() ||
    "您是想申请哪个阶段留学呢？",
  stageOptions:
    String(site.consultStageOptions ?? "").trim() || "中学,本科,硕士,博士",
  contactMessage:
    String(site.consultContactMessage ?? "").trim() ||
    "您好，如果对留学申请有什么疑问，比如院校选择、申请条件等，可以留下您意向申请的国家 + 电话 / 微信 / 邮箱，我们会安排专属老师尽快联系您。",
  idleMessage:
    String(site.consultIdleMessage ?? "").trim() ||
    "您也可以直接联系我们的微信或者电话，免费获取 1v1 留学规划指导。微信：{{wechat}} 电话：{{phone}}",
};
---

<div class="consult-widget" data-consult-widget>
  <button
    class="consult-backdrop"
    type="button"
    aria-label="关闭咨询窗口"
    data-consult-backdrop
    hidden
  ></button>

  <button
    class="consult-launcher"
    type="button"
    aria-label="打开咨询窗口"
    aria-controls="consult-panel"
    aria-expanded="false"
    data-consult-open
  >
    在线咨询
  </button>

  <section
    id="consult-panel"
    class="consult-panel"
    aria-label="留学咨询窗口"
    data-consult-panel
    hidden
  >
    <div class="consult-topline"></div>

    <div class="consult-header">
      <div class="consult-status-pill">
        {widgetConfig.teacherName} {widgetConfig.statusText}
      </div>

      <div class="consult-header-actions">
        <button type="button" aria-label="最小化" data-consult-minimize>
          −
        </button>
        <button type="button" aria-label="关闭" data-consult-close>
          x
        </button>
      </div>
    </div>

    <div class="consult-body">
      <div class="consult-messages" data-consult-messages></div>
    </div>

    <form class="consult-form" data-consult-form>
      <label class="consult-label" for="consult-input">请输入您要咨询的问题</label>
      <textarea
        id="consult-input"
        class="consult-input"
        maxlength="500"
        rows="3"
        placeholder="例如：我想申请英国硕士，现在大四，应该先准备什么？"
        data-consult-input
      ></textarea>

      <div class="consult-form-meta">
        <span class="consult-count" data-consult-count>0/500</span>
        <button class="consult-send" type="submit" data-consult-send>
          发送
        </button>
      </div>
    </form>

    <script
      type="application/json"
      data-consult-config
      is:inline
      set:html={JSON.stringify(widgetConfig)}
    ></script>
  </section>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-consult-widget]");
    if (!(root instanceof HTMLElement)) return;

    const backdrop = root.querySelector("[data-consult-backdrop]");
    const panel = root.querySelector("[data-consult-panel]");
    const openButton = root.querySelector("[data-consult-open]");
    const minimizeButton = root.querySelector("[data-consult-minimize]");
    const closeButton = root.querySelector("[data-consult-close]");
    const messagesEl = root.querySelector("[data-consult-messages]");
    const form = root.querySelector("[data-consult-form]");
    const input = root.querySelector("[data-consult-input]");
    const count = root.querySelector("[data-consult-count]");
    const sendButton = root.querySelector("[data-consult-send]");
    const configEl = root.querySelector("[data-consult-config]");

    if (!(backdrop instanceof HTMLButtonElement)) return;
    if (!(panel instanceof HTMLElement)) return;
    if (!(openButton instanceof HTMLButtonElement)) return;
    if (!(minimizeButton instanceof HTMLButtonElement)) return;
    if (!(closeButton instanceof HTMLButtonElement)) return;
    if (!(messagesEl instanceof HTMLElement)) return;
    if (!(form instanceof HTMLFormElement)) return;
    if (!(input instanceof HTMLTextAreaElement)) return;
    if (!(count instanceof HTMLElement)) return;
    if (!(sendButton instanceof HTMLButtonElement)) return;
    if (!(configEl instanceof HTMLScriptElement)) return;

    const defaults = {
      companyName: "留学咨询",
      teacherName: "周老师",
      teacherAvatar: "",
      statusText: "正在为您服务",
      phone: "",
      wechat: "",
      contactHref: "/#contact",
      studyHref: "/#study-abroad",
      welcomeMessage:
        "亲爱的同学 / 家长您好，欢迎来到留学咨询窗口。我们可以先帮您梳理国家方向、申请阶段和准备时间线。",
      countryPrompt: "您想了解哪个国家或地区的留学呢？",
      countryOptions:
        "美国,英国,澳洲,加拿大,中国港澳,日本,韩国,新加坡,马来西亚",
      stagePrompt: "您是想申请哪个阶段留学呢？",
      stageOptions: "中学,本科,硕士,博士",
      contactMessage:
        "您好，如果对留学申请有什么疑问，比如院校选择、申请条件等，可以留下您意向申请的国家 + 电话 / 微信 / 邮箱，我们会安排专属老师尽快联系您。",
      idleMessage:
        "您也可以直接联系我们的微信或者电话，免费获取 1v1 留学规划指导。微信：{{wechat}} 电话：{{phone}}",
    };

    let config = defaults;

    try {
      config = {
        ...defaults,
        ...JSON.parse(configEl.textContent || "{}"),
      };
    } catch {}

    const closedKey = "consult-widget-closed";
    const sessionKey = "consult-widget-session";
    const consultHash = "#consult";
    const messages = [];
    let selectedCountry = "";
    let selectedStage = "";
    let customerEmail = "";
    let customerPhone = "";
    let customerWechat = "";
    let idleSent = false;
    let idleTimer = 0;
    let booted = false;

    const readStorage = (key) => {
      try {
        return window.sessionStorage.getItem(key);
      } catch {
        return null;
      }
    };

    const writeStorage = (key, value) => {
      try {
        window.sessionStorage.setItem(key, value);
      } catch {}
    };

    const clearStorage = (key) => {
      try {
        window.sessionStorage.removeItem(key);
      } catch {}
    };

    const mobileMedia =
      typeof window.matchMedia === "function"
        ? window.matchMedia("(max-width: 720px)")
        : null;

    const sessionId = (() => {
      const existing = readStorage(sessionKey);
      if (existing) return existing;

      const next =
        typeof crypto !== "undefined" && crypto.randomUUID
          ? crypto.randomUUID()
          : `consult-${Date.now()}`;

      writeStorage(sessionKey, next);
      return next;
    })();

    const escapeHtml = (value) =>
      String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");

    const toOptions = (value) =>
      String(value || "")
        .split(",")
        .map((item) => item.trim())
        .filter(Boolean);

    const countryOptions = toOptions(config.countryOptions);
    const stageOptions = toOptions(config.stageOptions);

    const formatTemplate = (template) =>
      String(template || "")
        .replaceAll("{{wechat}}", config.wechat || "")
        .replaceAll("{{phone}}", config.phone || "")
        .replaceAll("{{teacherName}}", config.teacherName || "")
        .replaceAll("{{country}}", selectedCountry || "")
        .replaceAll("{{stage}}", selectedStage || "");

    const currentTime = () => {
      const now = new Date();
      return `${String(now.getHours()).padStart(2, "0")}:${String(
        now.getMinutes(),
      ).padStart(2, "0")}`;
    };

    const getTeacherInitial = () =>
      String(config.teacherName || "顾")
        .trim()
        .charAt(0) || "顾";

    const syncOpenState = (expanded) => {
      root.classList.toggle("is-open", expanded);
      openButton.setAttribute("aria-expanded", expanded ? "true" : "false");
      backdrop.hidden = !(expanded && mobileMedia?.matches);
      document.documentElement.classList.toggle(
        "consult-scroll-locked",
        expanded && Boolean(mobileMedia?.matches),
      );
      document.body.classList.toggle(
        "consult-scroll-locked",
        expanded && Boolean(mobileMedia?.matches),
      );
    };

    const syncComposerState = () => {
      const hasValue = Boolean(input.value.trim());
      sendButton.disabled = !hasValue;
      sendButton.classList.toggle("is-active", hasValue);
      count.textContent = `${input.value.length}/500`;
    };

    const clearIdleTimer = () => {
      if (idleTimer) {
        window.clearTimeout(idleTimer);
        idleTimer = 0;
      }
    };

    const scheduleIdleMessage = () => {
      if (idleSent) return;
      clearIdleTimer();
      idleTimer = window.setTimeout(() => {
        idleSent = true;
        addBotMessage(formatTemplate(config.idleMessage), contactActions());
      }, 3000);
    };

    const scrollToBottom = () => {
      requestAnimationFrame(() => {
        messagesEl.scrollTop = messagesEl.scrollHeight;
      });
    };

    const renderMessages = () => {
      messagesEl.innerHTML = messages
        .map((message) => {
          const actionsHtml = message.actions.length
            ? `<div class="consult-message-actions">${message.actions
                .map((action) => {
                  const themeClass =
                    action.theme === "blue"
                      ? "consult-action-btn consult-action-btn--blue"
                      : action.theme === "solid"
                        ? "consult-action-btn consult-action-btn--solid"
                        : "consult-action-btn";

                  return `<button
                      type="button"
                      class="${themeClass}"
                      data-action-kind="${escapeHtml(action.kind)}"
                      data-action-value="${escapeHtml(action.value || "")}"
                      data-action-label="${escapeHtml(action.label)}"
                    >${escapeHtml(action.label)}</button>`;
                })
                .join("")}</div>`
            : "";

          const avatarHtml =
            message.role === "bot"
              ? config.teacherAvatar
                ? `<img class="consult-avatar-img" src="${escapeHtml(
                    config.teacherAvatar,
                  )}" alt="${escapeHtml(config.teacherName)}" />`
                : `<div class="consult-avatar-fallback">${escapeHtml(
                    getTeacherInitial(),
                  )}</div>`
              : "";

          return `<article class="consult-message consult-message--${message.role}">
              ${
                message.role === "bot"
                  ? `<div class="consult-avatar">${avatarHtml}</div>`
                  : ""
              }
              <div class="consult-message-main">
                <div class="consult-message-meta">
                  <strong>${escapeHtml(
                    message.role === "bot" ? config.teacherName : "您",
                  )}</strong>
                  <span>${escapeHtml(message.time)}</span>
                </div>
                <div class="consult-bubble consult-bubble--${message.role}">${escapeHtml(
                  message.text,
                ).replaceAll("\n", "<br>")}</div>
                ${actionsHtml}
              </div>
            </article>`;
        })
        .join("");

      messagesEl.querySelectorAll("[data-action-kind]").forEach((node) => {
        if (!(node instanceof HTMLButtonElement)) return;

        node.addEventListener("click", async () => {
          clearIdleTimer();
          const kind = node.dataset.actionKind || "";
          const value = node.dataset.actionValue || "";
          const label = node.dataset.actionLabel || value;

          if (kind === "country") {
            handleCountrySelection(label);
            return;
          }

          if (kind === "stage") {
            handleStageSelection(label);
            return;
          }

          if (kind === "copy") {
            if (!value) return;

            try {
              if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(value);
                addBotMessage(`已复制：${value}，您可以直接去联系老师。`);
              } else {
                addBotMessage(`请手动复制：${value}`);
              }
            } catch {
              addBotMessage(`复制失败，请手动记录：${value}`);
            }
            return;
          }

          if (kind === "contact" && value) {
            writeStorage(closedKey, "1");
            minimizePanel();
            window.location.href = value;
            return;
          }

          if ((kind === "link" || kind === "call") && value) {
            window.location.href = value;
          }
        });
      });

      scrollToBottom();
    };

    const addMessage = (role, text, actions = []) => {
      const cleanText = String(text || "").trim();
      if (!cleanText) return;

      messages.push({
        role,
        text: cleanText,
        time: currentTime(),
        actions: Array.isArray(actions) ? actions : [],
      });

      renderMessages();
    };

    const addBotMessage = (text, actions = []) => {
      addMessage("bot", text, actions);
    };

    const addUserMessage = (text) => {
      addMessage("user", text);
    };

    const captureContact = (text) => {
      const emailMatch = String(text).match(
        /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i,
      );
      const phoneMatch = String(text)
        .match(/(?:\+?\d[\d\s-]{6,}\d)/)?.[0]
        ?.replace(/\s+/g, "");
      const wechatMatch = String(text).match(
        /(?:微信|wechat|vx|wx)[:：]?\s*([a-zA-Z][-_a-zA-Z0-9]{4,})/i,
      );

      if (emailMatch?.[0]) customerEmail = emailMatch[0];
      if (phoneMatch) customerPhone = phoneMatch;
      if (wechatMatch?.[1]) customerWechat = wechatMatch[1];
    };

    const transcript = () =>
      messages.slice(-12).map((item) => ({
        role: item.role,
        text: item.text,
        time: item.time,
      }));

    const notifyBusiness = async (messageText) => {
      try {
        await fetch("/api/consult/message", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            sessionId,
            currentPath: window.location.pathname,
            pageHref: window.location.href,
            message: messageText,
            customerEmail,
            customerPhone,
            wechat: customerWechat,
            transcript: transcript(),
          }),
        });
      } catch (error) {
        console.error("Failed to notify consult email", error);
      }
    };

    const contactActions = () => {
      const items = [];

      if (config.wechat) {
        items.push({
          label: "微信复制",
          kind: "copy",
          value: config.wechat,
          theme: "blue",
        });
      }

      if (config.phone) {
        items.push({
          label: "电话咨询",
          kind: "call",
          value: `tel:${config.phone}`,
          theme: "blue",
        });
      }

      items.push({
        label: "预约咨询",
        kind: "contact",
        value: config.contactHref,
        theme: "solid",
      });

      return items;
    };

    const countryActions = () =>
      countryOptions.map((item) => ({
        label: item,
        kind: "country",
        value: item,
        theme: "",
      }));

    const stageActions = () =>
      stageOptions.map((item) => ({
        label: item,
        kind: "stage",
        value: item,
        theme: "",
      }));

    const confirmContactMessage = () => {
      const lines = [];

      if (customerPhone) lines.push(`电话：${customerPhone}`);
      if (customerWechat) lines.push(`微信：${customerWechat}`);
      if (customerEmail) lines.push(`邮箱：${customerEmail}`);

      return lines.length
        ? `好的，已收到您的联系方式。\n${lines.join("\n")}\n老师会尽快联系您。`
        : formatTemplate(config.contactMessage);
    };

    const handleCountrySelection = (country) => {
      selectedCountry = country;
      captureContact(country);
      addUserMessage(country);
      void notifyBusiness(country);
      addBotMessage(formatTemplate(config.stagePrompt), stageActions());
    };

    const handleStageSelection = (stage) => {
      selectedStage = stage;
      captureContact(stage);
      addUserMessage(stage);
      void notifyBusiness(stage);
      addBotMessage(formatTemplate(config.contactMessage), contactActions());
    };

    const normalizedIncludes = (value, options) => {
      const clean = String(value || "").trim().toLowerCase();
      return options.find((item) => clean === String(item).trim().toLowerCase()) || "";
    };

    const handleTextMessage = (rawText) => {
      const text = String(rawText || "").trim();
      if (!text) return;

      clearIdleTimer();
      captureContact(text);
      addUserMessage(text);
      void notifyBusiness(text);
      input.value = "";
      syncComposerState();

      const matchedCountry = normalizedIncludes(text, countryOptions);
      if (!selectedCountry && matchedCountry) {
        selectedCountry = matchedCountry;
        addBotMessage(formatTemplate(config.stagePrompt), stageActions());
        return;
      }

      const matchedStage = normalizedIncludes(text, stageOptions);
      if (selectedCountry && !selectedStage && matchedStage) {
        selectedStage = matchedStage;
        addBotMessage(formatTemplate(config.contactMessage), contactActions());
        return;
      }

      if (/微信|电话|邮箱|联系|手机号|mail|email/i.test(text)) {
        addBotMessage(formatTemplate(config.idleMessage), contactActions());
        return;
      }

      if (customerPhone || customerWechat || customerEmail) {
        addBotMessage(confirmContactMessage(), contactActions());
        return;
      }

      if (!selectedCountry) {
        addBotMessage(formatTemplate(config.countryPrompt), countryActions());
        return;
      }

      if (!selectedStage) {
        addBotMessage(formatTemplate(config.stagePrompt), stageActions());
        return;
      }

      addBotMessage(formatTemplate(config.contactMessage), contactActions());
    };

    const bootMessages = () => {
      if (booted) return;
      booted = true;
      addBotMessage(formatTemplate(config.welcomeMessage));
      addBotMessage(formatTemplate(config.countryPrompt), countryActions());
    };

    const openPanel = () => {
      bootMessages();
      panel.hidden = false;
      syncOpenState(true);
      openButton.hidden = true;
      clearStorage(closedKey);
      scheduleIdleMessage();
      scrollToBottom();
      window.requestAnimationFrame(() => {
        input.focus({ preventScroll: true });
      });
    };

    const minimizePanel = () => {
      clearIdleTimer();
      syncOpenState(false);
      panel.hidden = true;
      openButton.hidden = false;
    };

    const closePanel = () => {
      minimizePanel();
      writeStorage(closedKey, "1");
    };

    openButton.addEventListener("click", openPanel);
    backdrop.addEventListener("click", closePanel);
    minimizeButton.addEventListener("click", minimizePanel);
    closeButton.addEventListener("click", closePanel);

    input.addEventListener("input", () => {
      clearIdleTimer();
      syncComposerState();
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        handleTextMessage(input.value);
      }
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      handleTextMessage(input.value);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && root.classList.contains("is-open")) {
        closePanel();
      }
    });

    const handleViewportChange = () => {
      syncOpenState(root.classList.contains("is-open"));
    };

    if (mobileMedia) {
      if (typeof mobileMedia.addEventListener === "function") {
        mobileMedia.addEventListener("change", handleViewportChange);
      }
    }

    syncComposerState();
    minimizePanel();

    if (window.location.hash === consultHash && readStorage(closedKey) !== "1") {
      openPanel();
    }
  })();
</script>

<style is:global>
  .consult-scroll-locked {
    overflow: hidden;
  }

  .consult-widget {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 120;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    max-width: calc(100vw - 24px);
  }

  .consult-backdrop {
    display: none;
  }

  .consult-launcher,
  .consult-panel {
    position: relative;
    z-index: 1;
  }

  .consult-launcher {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 112px;
    min-height: 46px;
    padding: 0 18px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: linear-gradient(180deg, #1994ff 0%, #0071e3 100%);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    box-shadow: 0 18px 38px rgba(0, 113, 227, 0.26);
    cursor: pointer;
    transition: transform 0.16s ease, box-shadow 0.16s ease, opacity 0.16s ease;
  }

  .consult-launcher::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.14);
  }

  .consult-panel {
    width: min(360px, calc(100vw - 32px));
    height: min(560px, calc(100vh - 96px));
    max-height: calc(100vh - 96px);
    border-radius: 20px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.86);
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.18);
    backdrop-filter: blur(22px);
  }

  .consult-topline {
    height: 4px;
    background: linear-gradient(90deg, #8bd6ff, #0071e3);
  }

  .consult-header {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60px;
    padding: 10px 14px 8px;
    background: rgba(255, 255, 255, 0.86);
  }

  .consult-status-pill {
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(0, 113, 227, 0.08);
    color: #48607b;
    font-size: 14px;
    font-weight: 800;
    text-align: center;
  }

  .consult-header-actions {
    position: absolute;
    right: 10px;
    top: 10px;
    display: flex;
    gap: 6px;
  }

  .consult-header-actions button {
    width: 28px;
    height: 28px;
    border: 1px solid rgba(29, 29, 31, 0.06);
    border-radius: 999px;
    background: rgba(245, 245, 247, 0.92);
    color: #7b8497;
