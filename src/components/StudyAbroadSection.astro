---
import UniversityFinder from "./UniversityFinder.astro";
import { normalizeImageUrl } from "../lib/image-url";
import type { RuntimeService } from "../lib/services-store";
import {
  POPULAR_MAJOR_HINTS,
  STUDY_ABROAD_COUNTRIES,
  STUDY_ABROAD_PROGRAMS,
} from "../lib/study-abroad-programs";

type Props = {
  services?: RuntimeService[];
};

const { services = [] } = Astro.props as Props;

const abroadServices = Array.isArray(services)
  ? services
      .filter((service) => service?.category === "abroad")
      .sort((a, b) => a.order - b.order)
  : [];

const featuredService = abroadServices[0] ?? null;
const otherServices = abroadServices.slice(1, 4);

const summaryParagraphs = String(featuredService?.summary ?? "")
  .split("\n")
  .map((item) => item.trim())
  .filter(Boolean);

const sectionStats = [
  {
    value: `${STUDY_ABROAD_PROGRAMS.length}+`,
    label: "精选官网项目",
  },
  {
    value: `${STUDY_ABROAD_COUNTRIES.length}`,
    label: "国家 / 地区",
  },
  {
    value: `${POPULAR_MAJOR_HINTS.length}`,
    label: "热门方向",
  },
];

const journeySteps = [
  {
    step: "01",
    title: "先定国家与专业",
    body: "把目标国家、专业方向、预算和准备时间一起框住，第一轮项目池才不会发散。",
  },
  {
    step: "02",
    title: "再看学校与项目匹配",
    body: "同一所学校里，不同项目的课程、申请要求和职业出口往往差别很大，要逐项拆开看。",
  },
  {
    step: "03",
    title: "最后进入背景规划",
    body: "把语言、实习、科研、文书和推荐信按时间线推进，申请动作才会真正落地。",
  },
];

const featuredPrograms = STUDY_ABROAD_PROGRAMS.slice(0, 4);
---

{
  featuredService ? (
    <section class="container reveal" id="study-abroad">
      <div class="section-head">
        <div>
          <div class="section-kicker">Study Abroad</div>
          <h2 class="section-title">留学申请</h2>
          <p class="section-desc">
            不是只讲“服务流程”，而是先把学校项目池筛出来，再决定选校、文书和递交流程怎么走。
          </p>
        </div>

        <a class="section-link" href={`/services/${featuredService.id}`}>
          查看完整服务 →
        </a>
      </div>

      <div class="study-abroad-band">
        <div class="study-abroad-hero">
          <div class="study-abroad-copy">
            <div class="card-tags">
              <span>留学申请</span>
              {featuredService.tags.slice(0, 3).map((tag) => (
                <span>{tag}</span>
              ))}
            </div>

            <h3 class="study-abroad-title">
              {featuredService.icon ? `${featuredService.icon} ` : ""}
              用真实项目池做第一轮留学筛选
            </h3>

            <p class="study-abroad-subtitle">
              {featuredService.subtitle || "选校定位、文书、申请、签证一站式服务"}
            </p>

            <div class="study-abroad-summary">
              {(summaryParagraphs.length
                ? summaryParagraphs
                : [
                    "后台继续补充国家、专业和学生画像后，这个模块会更适合做分层转化。",
                  ]
              )
                .slice(0, 2)
                .map((item) => <p>{item}</p>)}
            </div>

            <div class="study-abroad-actions">
              <a class="btn" href={`/services/${featuredService.id}`}>
                查看申请方案
              </a>
              <a class="btn btn-ghost" href="#contact">
                预约留学咨询
              </a>
            </div>

            <div class="study-abroad-stats">
              {sectionStats.map((stat) => (
                <div class="study-abroad-stat">
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="study-abroad-visual">
            {featuredService.heroImage ? (
              <img
                class="study-abroad-image"
                src={normalizeImageUrl(featuredService.heroImage)}
                alt={featuredService.title}
                loading="lazy"
              />
            ) : (
              <div class="study-abroad-placeholder">
                <div>
                  <div class="study-abroad-placeholder-kicker">Study Abroad</div>
                  <div class="study-abroad-placeholder-title">把项目、国家和专业放在一张图里看</div>
                  <p class="study-abroad-placeholder-copy">
                    这里会显示后台上传的留学申请主图，建议换成更能体现国家和校园氛围的实拍图。
                  </p>
                </div>
              </div>
            )}

            <div class="study-abroad-picks">
              <div class="study-abroad-picks-head">
                <span>热门匹配方向</span>
                <strong>直达官网项目页</strong>
              </div>

              <div class="study-abroad-picks-grid">
                {featuredPrograms.map((program) => (
                  <a
                    class="study-abroad-pick"
                    href={program.overviewUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <small>{program.country}</small>
                    <strong>{program.schoolName}</strong>
                    <span>{program.programName}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="study-abroad-journey">
          {journeySteps.map((item) => (
            <article class="study-abroad-step">
              <div class="study-abroad-step-number">STEP {item.step}</div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>

        <UniversityFinder />
      </div>

      {otherServices.length ? (
        <div class="mt-8">
          <div class="section-head">
            <div>
              <div class="section-kicker">More</div>
              <h3 class="h2">更多留学服务</h3>
            </div>
          </div>

          <div class="cards cards--3">
            {otherServices.map((service) => (
              <a class="card card--hover" href={`/services/${service.id}`}>
                <div class="card-top">
                  <div>
                    <div class="h3">
                      {service.icon ? `${service.icon} ` : ""}
                      {service.title}
                    </div>
                    <div class="muted mt-1">{service.subtitle}</div>
                  </div>
                  <div class="badge">留学</div>
                </div>

                {service.tags.length ? (
                  <div class="tags">
                    {service.tags.slice(0, 4).map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                ) : null}

                <div class="card-cta">查看详情 →</div>
              </a>
            ))}
          </div>
        </div>
      ) : null}
    </section>
  ) : null
}
