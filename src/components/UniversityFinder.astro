---
import {
  POPULAR_MAJOR_HINTS,
  STUDY_ABROAD_COUNTRIES,
  STUDY_ABROAD_DATA_UPDATED_AT,
  STUDY_ABROAD_PROGRAMS,
  type StudyAbroadProgram,
} from "../lib/study-abroad-programs";

type Props = {
  anchorId?: string;
  compact?: boolean;
};

const { anchorId = "school-match", compact = false } = Astro.props as Props;

const finderId = `school-match-${Math.random().toString(36).slice(2, 10)}`;
const initialResults = STUDY_ABROAD_PROGRAMS.slice(0, compact ? 4 : 6);

const sameLink = (program: StudyAbroadProgram) =>
  Boolean(program.admissionsUrl) && program.admissionsUrl === program.overviewUrl;
---

<section
  class:list={["school-match", compact && "school-match--compact"]}
  id={anchorId}
  data-school-match={finderId}
>
  <div class="school-match-head">
    <div>
      <div class="section-kicker">Official School Finder</div>
      <h3 class="school-match-title">输入国家和专业，先把院校项目池筛出来</h3>
      <p class="school-match-desc">
        结果页直达院校官网的项目简介与申请要求页面，先筛出方向，再决定要不要进入精细选校。
      </p>
    </div>

    <div class="school-match-source">
      <strong>数据说明</strong>
      <p>
        当前为精选官方项目库，覆盖美英加澳、中国香港和新加坡的热门方向。项目链接均来自院校官网，最近核对日期
        {STUDY_ABROAD_DATA_UPDATED_AT}。
      </p>
    </div>
  </div>

  <div class="school-match-controls">
    <label class="school-match-field">
      <span>意向国家</span>
      <select data-role="country">
        <option value="">全部国家 / 地区</option>
        {STUDY_ABROAD_COUNTRIES.map((country) => (
          <option value={country}>{country}</option>
        ))}
      </select>
    </label>

    <label class="school-match-field">
      <span>意向专业</span>
      <input
        data-role="major"
        type="text"
        inputmode="search"
        placeholder="例如 计算机、金融、市场营销、教育、商业分析"
      />
    </label>

    <label class="school-match-field">
      <span>学位类型</span>
      <select data-role="degree">
        <option value="">全部</option>
        <option value="硕士">硕士</option>
        <option value="MBA">MBA</option>
      </select>
    </label>
  </div>

  <div class="school-match-hints">
    <span>热门方向</span>
    <div class="school-match-chip-row">
      {POPULAR_MAJOR_HINTS.map((hint) => (
        <button class="school-match-chip" type="button" data-major-hint={hint}>
          {hint}
        </button>
      ))}
    </div>
  </div>

  <div class="school-match-status" data-role="status">
    先看一轮精选项目。输入国家和专业后，结果会即时更新。
  </div>

  <div class="school-match-results" data-role="results">
    {initialResults.map((program) => (
      <article class="school-card">
        <div class="school-card-top">
          <div>
            <div class="school-card-meta">
              <span>{program.country}</span>
              <span>{program.city}</span>
              <span>{program.degree}</span>
            </div>
            <h4>{program.schoolName}</h4>
            <p class="school-card-program">{program.programName}</p>
          </div>
          <div class="school-card-discipline">{program.discipline}</div>
        </div>

        <p class="school-card-summary">{program.summary}</p>

        <div class="school-card-tags">
          {program.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>

        <div class="school-card-facts">
          {program.duration ? <span>学制：{program.duration}</span> : null}
          {program.intake ? <span>入学：{program.intake}</span> : null}
          <span>核对：{program.checkedAt}</span>
        </div>

        <div class="school-card-actions">
          <a href={program.overviewUrl} target="_blank" rel="noreferrer">
            招生简介
          </a>
          {!sameLink(program) && program.admissionsUrl ? (
            <a href={program.admissionsUrl} target="_blank" rel="noreferrer">
              申请要求
            </a>
          ) : null}
        </div>
      </article>
    ))}
  </div>

  <script type="application/json" id={`${finderId}-data`}>
    {JSON.stringify(STUDY_ABROAD_PROGRAMS)}
  </script>

  <script is:inline define:vars={{ finderId, compact }}>
    const root = document.querySelector(`[data-school-match="${finderId}"]`);
    const dataNode = document.getElementById(`${finderId}-data`);

    if (root && dataNode) {
      const programs = JSON.parse(dataNode.textContent || "[]");
      const countrySelect = root.querySelector('[data-role="country"]');
      const majorInput = root.querySelector('[data-role="major"]');
      const degreeSelect = root.querySelector('[data-role="degree"]');
      const statusNode = root.querySelector('[data-role="status"]');
      const resultsNode = root.querySelector('[data-role="results"]');
      const hintButtons = Array.from(root.querySelectorAll("[data-major-hint]"));
      const defaultCount = compact ? 4 : 6;

      const majorFamilies = {
        "计算机 / AI": [
          "计算机",
          "computer science",
          "cs",
          "software",
          "programming",
          "ai",
          "人工智能",
          "machine learning",
          "cybersecurity",
          "information technology",
          "it",
          "ux",
          "hci",
          "数据科学",
        ],
        金融: [
          "金融",
          "finance",
          "investment",
          "banking",
          "wealth",
          "risk",
          "quant",
          "fintech",
        ],
        "商科 / 管理": [
          "商科",
          "business",
          "management",
          "commerce",
          "mba",
          "strategy",
          "consulting",
          "商业分析",
        ],
        "市场营销 / 传媒": [
          "市场",
          "营销",
          "marketing",
          "communications",
          "advertising",
          "media",
          "brand",
          "imc",
          "传媒",
        ],
        教育: ["教育", "education", "teaching", "policy", "pedagogy", "research"],
        "商业分析 / 数据": [
          "数据",
          "data",
          "analytics",
          "analysis",
          "business analytics",
          "sql",
          "python",
          "information systems",
        ],
      };

      const normalize = (value) =>
        String(value || "")
          .toLowerCase()
          .trim()
          .replace(/[()]/g, " ")
          .replace(/[.,/\\-]+/g, " ")
          .replace(/\s+/g, " ");

      const expandQuery = (value) => {
        const query = normalize(value);
        if (!query) return [];

        const expanded = new Set(query.split(" ").filter(Boolean));

        Object.entries(majorFamilies).forEach(([label, keywords]) => {
          const labelText = normalize(label);
          const hasFamilyMatch =
            query.includes(labelText) ||
            keywords.some((keyword) => query.includes(normalize(keyword)));

          if (hasFamilyMatch) {
            expanded.add(labelText);
            keywords.forEach((keyword) => expanded.add(normalize(keyword)));
          }
        });

        return Array.from(expanded);
      };

      const describeFilters = (country, major, degree) => {
        const parts = [];

        if (country) parts.push(country);
        if (major) parts.push(`专业：${major}`);
        if (degree) parts.push(`学位：${degree}`);

        return parts.length ? parts.join(" / ") : "精选推荐";
      };

      const cardHtml = (program) => {
        const facts = [
          program.duration ? `<span>学制：${program.duration}</span>` : "",
          program.intake ? `<span>入学：${program.intake}</span>` : "",
          `<span>核对：${program.checkedAt}</span>`,
        ]
          .filter(Boolean)
          .join("");

        const admissionsLink =
          program.admissionsUrl && program.admissionsUrl !== program.overviewUrl
            ? `<a href="${program.admissionsUrl}" target="_blank" rel="noreferrer">申请要求</a>`
            : "";

        return `
          <article class="school-card">
            <div class="school-card-top">
              <div>
                <div class="school-card-meta">
                  <span>${program.country}</span>
                  <span>${program.city}</span>
                  <span>${program.degree}</span>
                </div>
                <h4>${program.schoolName}</h4>
                <p class="school-card-program">${program.programName}</p>
              </div>
              <div class="school-card-discipline">${program.discipline}</div>
            </div>

            <p class="school-card-summary">${program.summary}</p>

            <div class="school-card-tags">
              ${program.tags.map((tag) => `<span>${tag}</span>`).join("")}
            </div>

            <div class="school-card-facts">${facts}</div>

            <div class="school-card-actions">
              <a href="${program.overviewUrl}" target="_blank" rel="noreferrer">招生简介</a>
              ${admissionsLink}
            </div>
          </article>
        `;
      };

      const renderResults = () => {
        const country = countrySelect instanceof HTMLSelectElement ? countrySelect.value : "";
        const degree = degreeSelect instanceof HTMLSelectElement ? degreeSelect.value : "";
        const major = majorInput instanceof HTMLInputElement ? majorInput.value.trim() : "";
        const queryTokens = expandQuery(major);

        const matched = programs
          .map((program) => {
            if (country && program.country !== country) {
              return null;
            }

            if (degree && program.degree !== degree) {
              return null;
            }

            const searchText = normalize(
              [
                program.schoolName,
                program.programName,
                program.discipline,
                program.summary,
                ...(program.keywords || []),
                ...(program.tags || []),
              ].join(" ")
            );

            let score = program.priority || 0;

            if (major) {
              const rawQuery = normalize(major);
              let majorMatched = searchText.includes(rawQuery);

              queryTokens.forEach((token) => {
                if (searchText.includes(token)) {
                  majorMatched = true;
                  score += token.length > 2 ? 9 : 4;
                }
              });

              if (!majorMatched) {
                return null;
              }
            }

            if (country) {
              score += 12;
            }

            if (degree) {
              score += 6;
            }

            return { program, score };
          })
          .filter(Boolean)
          .sort((left, right) => right.score - left.score)
          .map((entry) => entry.program);

        const fallback = !country && !major && !degree;
        const visible = fallback ? matched.slice(0, defaultCount) : matched.slice(0, 12);

        if (statusNode) {
          statusNode.textContent = fallback
            ? `当前展示 ${visible.length} 个精选项目。输入国家和专业后，会按匹配度重排。`
            : visible.length
              ? `已找到 ${visible.length} 个匹配项目：${describeFilters(country, major, degree)}`
              : `没有找到完全匹配的项目：${describeFilters(country, major, degree)}。建议把专业词放宽到“计算机”“金融”“商科”“教育”等大方向。`;
        }

        if (!resultsNode) {
          return;
        }

        if (!visible.length) {
          resultsNode.innerHTML = `
            <div class="school-match-empty">
              <strong>这轮没有筛到合适结果</strong>
              <p>可以先缩短国家条件，或者把专业从“量化金融”“人机交互”放宽到“金融”“计算机 / AI”。</p>
            </div>
          `;
          return;
        }

        resultsNode.innerHTML = visible.map(cardHtml).join("");
      };

      [countrySelect, majorInput, degreeSelect].forEach((node) => {
        if (!node) return;

        node.addEventListener("input", renderResults);
        node.addEventListener("change", renderResults);
      });

      hintButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const hint = button.getAttribute("data-major-hint");
          if (!(majorInput instanceof HTMLInputElement) || !hint) {
            return;
          }

          majorInput.value = hint;
          majorInput.focus();
          renderResults();
        });
      });
    }
  </script>
</section>
