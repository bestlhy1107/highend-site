      let lastEmptyText =
        "可以先放宽国家条件，或者改选更宽的专业方向，比如从“商业分析 / 数据”切到“商科 / 管理”。";
      let activeDetailProgramId = "";
      let fitPreviewToken = 0;
      let admissionsPrefetchToken = 0;
      let admissionsPrefetchTimer = 0;
      let candidateExpansionToken = 0;
      let candidateExpansionController = null;
      let selectedSchoolSummary = null;
      const FAVORITES_STORAGE_KEY = "study-abroad-finder-favorites-v1";
      const SAVED_SEARCHES_STORAGE_KEY = "study-abroad-finder-saved-searches-v1";
      const COMPARE_STORAGE_KEY = "study-abroad-finder-compare-v1";
      const CONTACT_DRAFT_STORAGE_KEY = "study-abroad-contact-draft-v1";
      let favoriteSchools = [];
      let favoritePrograms = [];
      let savedSearches = [];
      let comparePrograms = [];
      let activeSearchGuidance = null;
      const detailCache = new Map();
      const intentSuppressValue = "__none__";
      const inferredIntentKeys = new Set(["country", "degree", "major", "specialization"]);
      const specializationMap =
        specializationOptionsByMajor &&
        typeof specializationOptionsByMajor === "object"
          ? specializationOptionsByMajor
          : {};
      const majorExpansionMap =
        majorExpansionHints && typeof majorExpansionHints === "object"
          ? majorExpansionHints
          : {};

      const escapeHtml = (value) =>
        String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");

      const storageAvailable = () => {
        try {
          return typeof window !== "undefined" && Boolean(window.localStorage);
        } catch {
          return false;
        }
      };

      const readStorageValue = (key, fallback = null) => {
        if (!storageAvailable()) return fallback;

        try {
          const raw = window.localStorage.getItem(key);
          if (!raw) return fallback;
          return JSON.parse(raw);
        } catch {
          return fallback;
        }
      };

      const writeStorageValue = (key, value) => {
        if (!storageAvailable()) return;

        try {
          window.localStorage.setItem(key, JSON.stringify(value));
        } catch {
          // ignore storage write failures in private mode or quota limits
        }
      };

      const isoNow = () => new Date().toISOString();

      const downloadTextFile = (content, filename, type = "text/plain;charset=utf-8") => {
        if (typeof document === "undefined") return;

        const blob = new Blob([content], { type });
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement("a");
        anchor.href = url;
        anchor.download = filename;
        document.body.appendChild(anchor);
        anchor.click();
        anchor.remove();
        URL.revokeObjectURL(url);
      };

      const snapshotProgram = (program) => ({
        id: String(program?.id || ""),
        universityId: String(program?.universityId || ""),
        schoolName: String(program?.schoolName || ""),
        schoolNameZh: String(program?.schoolNameZh || ""),
        country: String(program?.country || ""),
        city: String(program?.city || ""),
        stateOrProvince: String(program?.stateOrProvince || ""),
        degree: String(program?.degree || ""),
        discipline: String(program?.discipline || ""),
        programName: String(program?.programName || ""),
        summary: String(program?.summary || ""),
        duration: String(program?.duration || ""),
        intake: String(program?.intake || ""),
        tuitionAmount: String(program?.tuitionAmount || ""),
        tuitionCurrency: String(program?.tuitionCurrency || ""),
        overviewUrl: String(program?.overviewUrl || ""),
        admissionsUrl: String(program?.admissionsUrl || ""),
        officialWebsite: String(program?.officialWebsite || program?.overviewUrl || ""),
        qsRank: Number(program?.qsRank) || null,
        qsRankingYear: Number(program?.qsRankingYear) || null,
        checkedAt: String(program?.checkedAt || ""),
        tags: Array.isArray(program?.tags) ? program.tags.slice(0, 6) : [],
        admissionsSnapshot: program?.admissionsSnapshot || null,
        savedAt: isoNow(),
      });

      const snapshotSchool = (school) => ({
        universityId: String(school?.universityId || ""),
        schoolName: String(school?.schoolName || ""),
        schoolNameZh: String(school?.schoolNameZh || ""),
        country: String(school?.country || ""),
        city: String(school?.city || ""),
        stateOrProvince: String(school?.stateOrProvince || ""),
        qsRank: Number(school?.qsRank) || null,
        qsRankingYear: Number(school?.qsRankingYear) || null,
        programCount: Number(school?.programCount) || 0,
        tuitionMin: Number(school?.tuitionMin) || null,
        tuitionMax: Number(school?.tuitionMax) || null,
        tuitionCurrency: String(school?.tuitionCurrency || ""),
        topDisciplines: Array.isArray(school?.topDisciplines) ? school.topDisciplines.slice(0, 4) : [],
        officialWebsite: String(school?.officialWebsite || ""),
        savedAt: isoNow(),
      });

      const savedSearchLabel = (payload = {}) => {
        const primary = [payload.country, payload.degree, payload.major, payload.specialization]
          .filter(Boolean)
          .join(" / ");
        const free = String(payload.freeText || "").trim();
        const label = primary || free || "未命名搜索";
        const suffix = [payload.gpaProfile, payload.languageProfile].filter(Boolean).join(" · ");
        return suffix ? `${label} · ${suffix}` : label;
      };

      const compactDateTime = (value) => {
        if (!value) return "";
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return "";
        return date.toLocaleString("zh-CN", {
          month: "2-digit",
          day: "2-digit",
          hour: "2-digit",
          minute: "2-digit",
        });
      };

      const isProgramFavorited = (programId) =>
        favoritePrograms.some((item) => String(item?.id || "") === String(programId || ""));

      const isSchoolFavorited = (universityId) =>
        favoriteSchools.some((item) => String(item?.universityId || "") === String(universityId || ""));

      const isProgramCompared = (programId) =>
        comparePrograms.some((item) => String(item?.id || "") === String(programId || ""));

      const setStatusSummary = ({
        verifiedCount = 0,
        candidateCount = 0,
        blockedCount = 0,
        expansionEnabled = false,
        expansionAttempted = false,
        universityCount = 0,
      } = {}) => {
        activeSearchStats = {
          verifiedCount: Number(verifiedCount) || 0,
          candidateCount: Number(candidateCount) || 0,
          blockedCount: Number(blockedCount) || 0,
          universityCount: Number(universityCount) || 0,
          expansionEnabled: Boolean(expansionEnabled),
          expansionAttempted: Boolean(expansionAttempted),
        };

        if (statusVerifiedNode instanceof HTMLElement) {
          statusVerifiedNode.textContent = String(verifiedCount || 0);
        }

        if (statusCandidateNode instanceof HTMLElement) {
          statusCandidateNode.textContent = String(candidateCount || 0);
        }

        if (statusBlockedNode instanceof HTMLElement) {
          statusBlockedNode.textContent = String(blockedCount || 0);
        }

        if (statusCandidateNoteNode instanceof HTMLElement) {
          if (!expansionEnabled) {
            statusCandidateNoteNode.textContent = "当前环境还没接全网扩搜 API，所以候选结果暂时不会放量。";
          } else if (!expansionAttempted) {
            statusCandidateNoteNode.textContent = "这轮还没有触发全网扩搜，先看已核验项目与学校池。";
          } else if (activeSearchGuidance?.candidateQualitySummary) {
            statusCandidateNoteNode.textContent = activeSearchGuidance.candidateQualitySummary;
          } else if (candidateCount > 0) {
            statusCandidateNoteNode.textContent = "这些结果来自全网筛出的疑似官网页，会同步进入后台审核。";
          } else {
            statusCandidateNoteNode.textContent = "这轮已尝试扩搜，但还没有筛出更高质量的候选官网页。";
          }
        }

        if (statusBlockedNoteNode instanceof HTMLElement) {
          statusBlockedNoteNode.textContent =
            blockedCount > 0
              ? "这些结果曾被管理员判定不符合推荐标准，所以这轮会被自动避开。"
              : "管理员判定不合格的结果会自动跳过。";
        }
      };

      const intentLabelMap = {
        country: "国家",
        degree: "学位",
        major: "专业方向",
        specialization: "细分方向",
        budgetTier: "预算",
        intake: "入学季",
        gpaProfile: "GPA",
        languageProfile: "语言",
        snapshotQuality: "门槛质量",
      };

      const hideIntentExplanation = () => {
        if (intentPanel instanceof HTMLElement) {
          intentPanel.hidden = true;
        }

        if (intentChipsNode instanceof HTMLElement) {
          intentChipsNode.innerHTML = "";
        }

        if (intentActionsNode instanceof HTMLElement) {
          intentActionsNode.innerHTML = "";
        }
      };

      const hideExpansionSuggestion = () => {
        if (expansionPanel instanceof HTMLElement) {
          expansionPanel.hidden = true;
        }

        if (expansionActionsNode instanceof HTMLElement) {
          expansionActionsNode.innerHTML = "";
        }
      };

      const hideSearchQuality = () => {
        activeSearchGuidance = null;

        if (qualityPanel instanceof HTMLElement) {
          qualityPanel.hidden = true;
        }

        if (qualityTitleNode instanceof HTMLElement) {
          qualityTitleNode.textContent = "这轮结果是这样排出来的";
        }

        if (qualitySummaryNode instanceof HTMLElement) {
          qualitySummaryNode.textContent = "";
        }

        if (qualityRankingSignalsNode instanceof HTMLElement) {
          qualityRankingSignalsNode.innerHTML = "";
        }

        if (qualityIntentSignalsNode instanceof HTMLElement) {
          qualityIntentSignalsNode.innerHTML = "";
        }

        if (qualityCandidateSummaryNode instanceof HTMLElement) {
          qualityCandidateSummaryNode.textContent = "";
        }

        if (qualityNextStepsNode instanceof HTMLElement) {
          qualityNextStepsNode.innerHTML = "";
        }
      };

      const hasAdvancedIntentFilters = (payload = {}) =>
        Boolean(
          payload?.specialization ||
            payload?.budgetTier ||
            payload?.intake ||
            payload?.gpaProfile ||
            payload?.languageProfile ||
            payload?.snapshotQuality ||
            (payload?.fitMode && payload.fitMode !== "prefer")
        );

      const buildIntentActions = (payload = {}) => {
        const actions = [];
        const broaderMajors = Array.isArray(majorExpansionMap[payload?.major])
          ? majorExpansionMap[payload.major].filter((major) => major && major !== payload.major).slice(0, 2)
          : [];

        if (payload?.specialization) {
          actions.push({
            type: "clear-specialization",
            label: "去掉细分方向",
          });
        }

        broaderMajors.forEach((major) => {
          actions.push({
            type: "expand-major",
            label: `改为更宽的 ${major}`,
            value: major,
          });
        });

        if (payload?.freeText) {
          actions.push({
            type: "clear-free-text",
            label: "清空一句话需求",
          });
        }

        if (hasAdvancedIntentFilters(payload)) {
          actions.push({
            type: "relax-search",
            label: "放宽这轮搜索",
          });
        }

        if (payload?.country && payload?.degree && (payload?.major || hasAdvancedIntentFilters(payload))) {
          actions.push({
            type: "country-degree-only",
            label: "只保留国家和学位",
          });
        }

        return actions;
      };

      const buildExpansionActions = (payload = {}) =>
        buildIntentActions(payload).filter((action) => action.type !== "clear-free-text");

      const buildIntentRemovalValue = (key, payload = {}) =>
        payload?.freeText && inferredIntentKeys.has(key) ? intentSuppressValue : "";

      const shouldSuggestExpansion = (payload = {}, stats = {}) => {
        if (payload?.universityId) return false;

        const verifiedCount = Number(stats?.verifiedCount) || 0;
        const universityCount = Number(stats?.universityCount) || 0;

        if (!payload?.major && !payload?.specialization && !payload?.freeText) {
          return false;
        }

        return verifiedCount === 0 || verifiedCount <= 8 || universityCount <= 6;
      };

      const renderExpansionSuggestion = (payload = {}, stats = {}) => {
        if (
          !(expansionPanel instanceof HTMLElement) ||
          !(expansionTitleNode instanceof HTMLElement) ||
          !(expansionSummaryNode instanceof HTMLElement) ||
          !(expansionActionsNode instanceof HTMLElement)
        ) {
          return;
        }

        if (!shouldSuggestExpansion(payload, stats)) {
          hideExpansionSuggestion();
          return;
        }

        const verifiedCount = Number(stats?.verifiedCount) || 0;
        const universityCount = Number(stats?.universityCount) || 0;
        const candidateCount = Number(stats?.candidateCount) || 0;
        const actions = buildExpansionActions(payload);

        if (!actions.length) {
          hideExpansionSuggestion();
          return;
        }

        expansionPanel.hidden = false;
        expansionTitleNode.textContent =
          verifiedCount === 0 ? "当前还没筛到正式结果，建议这样放宽" : "当前结果偏少，建议这样扩大院校池";
        expansionSummaryNode.textContent =
          verifiedCount === 0
            ? candidateCount > 0
              ? `这轮还没有正式项目，但已经找到 ${candidateCount} 条候选官网页。你也可以先按下面的方式放宽搜索，再看看正式结果。`
              : "这轮还没有筛到正式项目。通常先放宽细分方向、专业大类或背景限制，会更容易拿到更大的项目池。"
            : `当前先返回了 ${verifiedCount} 个正式项目、${universityCount} 所学校。你可以先试试下面这些常见放宽方式，通常能更快拿到更大的候选池。`;
        expansionActionsNode.innerHTML = actions
          .map(
            (action) =>
              `<button type="button" class="school-match-expansion-action" data-intent-action="${escapeHtml(action.type)}"${action.value ? ` data-intent-value="${escapeHtml(action.value)}"` : ""}>${escapeHtml(action.label)}</button>`
          )
          .join("");
      };

      const renderIntentExplanation = (payload = {}) => {
        if (
          !(intentPanel instanceof HTMLElement) ||
          !(intentChipsNode instanceof HTMLElement) ||
          !(intentActionsNode instanceof HTMLElement)
        ) {
          return;
        }

        const entries = [
          payload.country ? { key: "country", value: payload.country } : null,
          payload.degree ? { key: "degree", value: payload.degree } : null,
          payload.major ? { key: "major", value: payload.major } : null,
          payload.specialization ? { key: "specialization", value: payload.specialization } : null,
          payload.budgetTier ? { key: "budgetTier", value: payload.budgetTier } : null,
          payload.intake ? { key: "intake", value: payload.intake } : null,
          payload.gpaProfile ? { key: "gpaProfile", value: payload.gpaProfile } : null,
          payload.languageProfile ? { key: "languageProfile", value: payload.languageProfile } : null,
          payload.snapshotQuality ? { key: "snapshotQuality", value: payload.snapshotQuality } : null,
        ].filter(Boolean);

        if (!entries.length && !payload?.freeText) {
          hideIntentExplanation();
          return;
        }

        intentPanel.hidden = false;
        if (intentSummaryNode instanceof HTMLElement) {
          intentSummaryNode.textContent = payload?.freeText
            ? "系统已结合你的一句话需求和当前筛选器，识别出下面这些条件；你可以直接点下方条件移除，或用快捷动作把搜索放宽到更大的相关方向。"
            : "当前这轮搜索使用的是下面这些结构化条件；你可以直接点下方条件移除，或用快捷动作快速放宽到更宽的相关方向。";
        }

        const chips = [];

        if (payload?.freeText) {
          chips.push(
            `<span class="school-match-intent-chip school-match-intent-chip--free">原始需求：${escapeHtml(payload.freeText)}</span>`
          );
        }

        entries.forEach((entry) => {
          chips.push(
            `<button type="button" class="school-match-intent-chip school-match-intent-chip--interactive" data-intent-remove="${escapeHtml(entry.key)}" aria-label="移除${escapeHtml(intentLabelMap[entry.key] || entry.key)}条件"><strong>${escapeHtml(intentLabelMap[entry.key] || entry.key)}</strong>${escapeHtml(entry.value)}<span class="school-match-intent-chip-remove" aria-hidden="true">×</span></button>`
          );
        });

        intentChipsNode.innerHTML = chips.join("");

        const actions = buildIntentActions(payload);
        intentActionsNode.innerHTML = actions.length
          ? actions
              .map(
                (action) =>
                  `<button type="button" class="school-match-intent-action" data-intent-action="${escapeHtml(action.type)}"${action.value ? ` data-intent-value="${escapeHtml(action.value)}"` : ""}>${escapeHtml(action.label)}</button>`
              )
              .join("")
          : "";
      };

      const renderSearchQuality = (guidance, stats = {}) => {
        if (
          !(qualityPanel instanceof HTMLElement) ||
          !(qualityTitleNode instanceof HTMLElement) ||
          !(qualitySummaryNode instanceof HTMLElement) ||
          !(qualityRankingSignalsNode instanceof HTMLElement) ||
          !(qualityIntentSignalsNode instanceof HTMLElement) ||
          !(qualityCandidateSummaryNode instanceof HTMLElement) ||
          !(qualityNextStepsNode instanceof HTMLElement)
        ) {
          return;
        }

        if (!guidance || typeof guidance !== "object") {
          hideSearchQuality();
          return;
        }

        activeSearchGuidance = guidance;
        qualityPanel.hidden = false;

        const verifiedCount = Number(stats?.verifiedCount) || 0;
        qualityTitleNode.textContent =
          verifiedCount > 0 ? "这轮结果是这样排出来的" : "这轮为什么结果偏少";
        qualitySummaryNode.textContent =
          String(guidance.failureReason || "").trim() ||
          "系统会优先看专业匹配、门槛完整度和官网可核验度。";
        qualityRankingSignalsNode.innerHTML = Array.isArray(guidance.rankingSignals)
          ? guidance.rankingSignals
              .filter(Boolean)
              .map((item) => `<span>${escapeHtml(item)}</span>`)
              .join("")
          : "";
        qualityIntentSignalsNode.innerHTML = Array.isArray(guidance.intentSignals)
          ? guidance.intentSignals
              .filter(Boolean)
              .map((item) => `<span>${escapeHtml(item)}</span>`)
              .join("")
          : "";
        qualityCandidateSummaryNode.textContent = String(guidance.candidateQualitySummary || "").trim();
        qualityNextStepsNode.innerHTML = Array.isArray(guidance.nextSteps)
          ? guidance.nextSteps
              .filter(Boolean)
              .map((item) => `<li>${escapeHtml(item)}</li>`)
              .join("")
          : "";
      };

      const applyResolvedQueryToControls = (payload = {}) => {
        if (freeTextInput instanceof HTMLInputElement) {
          freeTextInput.value = payload?.freeText || "";
        }

        if (countrySelect instanceof HTMLSelectElement) {
          countrySelect.value = payload?.country || "";
        }

        if (degreeSelect instanceof HTMLSelectElement) {
          degreeSelect.value = payload?.degree || "";
        }

        if (majorSelect instanceof HTMLSelectElement) {
          majorSelect.value = payload?.major || "";
        }

        updateSpecializationOptions(payload?.specialization || "");

        if (budgetSelect instanceof HTMLSelectElement) {
          budgetSelect.value = payload?.budgetTier || "";
        }

        if (intakeSelect instanceof HTMLSelectElement) {
          intakeSelect.value = payload?.intake || "";
        }

        if (gpaSelect instanceof HTMLSelectElement) {
          gpaSelect.value = payload?.gpaProfile || "";
        }

        if (languageSelect instanceof HTMLSelectElement) {
          languageSelect.value = payload?.languageProfile || "";
        }

        if (fitModeSelect instanceof HTMLSelectElement) {
          fitModeSelect.value = payload?.fitMode || "prefer";
        }

        if (snapshotQualitySelect instanceof HTMLSelectElement) {
          snapshotQualitySelect.value = payload?.snapshotQuality || "";
        }
      };

      const locationLabel = (program) =>
        [program.city, program.stateOrProvince].filter(Boolean).join(", ");

      const tuitionLabel = (program) => {
        if (!program.tuitionAmount) {
          return "";
        }

        const rawValue = Number(program.tuitionAmount);
        const amount = Number.isFinite(rawValue)
          ? new Intl.NumberFormat("en-US").format(rawValue)
          : String(program.tuitionAmount);

        return program.tuitionCurrency
          ? `学费：${program.tuitionCurrency} ${amount}`
          : `学费：${amount}`;
      };

      const rankingLabel = (program) => {
        const rank = Number(program.qsRank);
        if (!Number.isFinite(rank) || rank <= 0) {
          return "";
        }

        return program.qsRankingYear
          ? `QS ${escapeHtml(program.qsRankingYear)}：#${escapeHtml(rank)}`
          : `QS：#${escapeHtml(rank)}`;
      };

      const admissionsSnapshotStatusLabel = (snapshot) => {
        const status = snapshot?.extractionStatus;
        if (status === "ok") return "门槛：已入库";
        if (status === "partial") return "门槛：部分字段";
        if (status === "unavailable") return "门槛：待补抓";
        return "";
      };

      const admissionsSnapshotLabel = (program) =>
        admissionsSnapshotStatusLabel(program?.admissionsSnapshot);

      const formatCurrencyNumber = (value) => {
        const numeric = Number(value);
        if (!Number.isFinite(numeric) || numeric <= 0) {
          return "";
        }

        return new Intl.NumberFormat("en-US").format(Math.round(numeric));
      };

      const schoolRankingLabel = (school) => {
        const rank = Number(school?.qsRank);
        if (!Number.isFinite(rank) || rank <= 0) {
          return "";
        }

        return school.qsRankingYear
          ? `QS ${school.qsRankingYear}：#${rank}`
          : `QS：#${rank}`;
      };

      const schoolTuitionLabel = (school) => {
        const min = Number(school?.tuitionMin);
        const max = Number(school?.tuitionMax);
        const count = Number(school?.tuitionProjectCount) || 0;
        const currency = school?.tuitionCurrency || "USD";

        if (!count || !Number.isFinite(min) || min <= 0) {
          return "";
        }

        if (!Number.isFinite(max) || max <= 0 || min === max) {
          return `学费样本：${currency} ${formatCurrencyNumber(min)} 起`;
        }

        return `学费样本：${currency} ${formatCurrencyNumber(min)} - ${formatCurrencyNumber(max)}`;
      };

      const programCardLookup = (programId) =>
        activeVerifiedResults.find((item) => String(item?.id || "") === String(programId || "")) ||
        baseVerifiedResults.find((item) => String(item?.id || "") === String(programId || "")) ||
        favoritePrograms.find((item) => String(item?.id || "") === String(programId || ""));

      const buildConsultSummaryText = () => {
        const topPrograms = activeVerifiedResults.slice(0, 5);
        const favoriteProgramNames = favoritePrograms
          .slice(0, 5)
          .map((item) => `${item.schoolNameZh || item.schoolName} · ${item.programName}`);
        const favoriteSchoolNames = favoriteSchools
          .slice(0, 5)
          .map((item) => item.schoolNameZh || item.schoolName);
        const compareNames = comparePrograms
          .slice(0, 4)
          .map((item) => `${item.schoolNameZh || item.schoolName} · ${item.programName}`);
        const filters = [
          activeSearchPayload.freeText ? `原始需求：${activeSearchPayload.freeText}` : "",
          activeSearchPayload.country ? `国家：${activeSearchPayload.country}` : "",
          activeSearchPayload.degree ? `学位：${activeSearchPayload.degree}` : "",
          activeSearchPayload.major ? `专业方向：${activeSearchPayload.major}` : "",
          activeSearchPayload.specialization ? `细分方向：${activeSearchPayload.specialization}` : "",
          activeSearchPayload.gpaProfile ? `GPA：${activeSearchPayload.gpaProfile}` : "",
          activeSearchPayload.languageProfile ? `语言：${activeSearchPayload.languageProfile}` : "",
          activeSearchPayload.intake ? `入学季：${activeSearchPayload.intake}` : "",
          activeSearchPayload.budgetTier ? `预算：${activeSearchPayload.budgetTier}` : "",
        ].filter(Boolean);

        const resultLines = topPrograms.length
          ? topPrograms.map((item, index) => {
              const reasons = buildProgramReasonChips(item, activeSearchPayload);
              return `${index + 1}. ${item.schoolNameZh || item.schoolName}｜${item.programName}${reasons.length ? `（${reasons.join(" / ")}）` : ""}`;
            })
          : ["当前还没有已核验正式项目，可先看后台候选结果或继续放宽方向。"];

        return [
          "院校搜索咨询摘要",
          "",
          `生成时间：${new Date().toLocaleString("zh-CN")}`,
          activeSearchSessionId ? `搜索会话：${activeSearchSessionId}` : "",
          "",
          "一、当前搜索条件",
          ...(filters.length ? filters.map((item) => `- ${item}`) : ["- 当前尚未设置结构化筛选条件"]),
          "",
          "二、结果概况",
          `- 已核验项目：${activeSearchStats.verifiedCount || activeVerifiedResults.length}`,
          `- 学校池：${activeSearchStats.universityCount || activeUniversityCount}`,
          `- 全网候选官网页：${activeSearchStats.candidateCount || baseCandidateResults.length}`,
          `- 后台已规避：${activeSearchStats.blockedCount || 0}`,
          "",
          "三、当前优先推荐项目",
          ...resultLines,
          "",
          "四、用户已收藏内容",
          `- 收藏学校：${favoriteSchoolNames.length ? favoriteSchoolNames.join("、") : "暂无"}`,
          `- 收藏项目：${favoriteProgramNames.length ? favoriteProgramNames.join("；") : "暂无"}`,
          `- 当前对比项目：${compareNames.length ? compareNames.join("；") : "暂无"}`,
          "",
          "五、建议顾问跟进",
          "- 先确认用户是否接受当前国家 / 专业方向的放宽范围。",
          "- 优先围绕前 3 个正式项目确认预算、入学季和背景匹配度。",
          "- 如果正式项目仍偏少，可继续查看全网候选官网页并人工补库。",
        ]
          .filter(Boolean)
          .join("\n");
      };

      const renderConsultSummary = () => {
        if (!(consultSummaryPanel instanceof HTMLElement) || !(consultSummaryText instanceof HTMLTextAreaElement)) {
          return;
        }

        const summary = buildConsultSummaryText();
        consultSummaryText.value = summary;
        consultSummaryPanel.hidden = false;
      };

      const compareTableHtml = (items) => {
        if (!Array.isArray(items) || !items.length) {
          return `
            <div class="school-toolbox-empty">
              <strong>还没有加入对比的项目</strong>
              <p>在项目卡片上点“加入对比”，最多可同时放 4 个项目。</p>
            </div>
          `;
        }

        const rows = [
          { label: "学校", values: items.map((item) => item.schoolNameZh || item.schoolName) },
          { label: "英文校名", values: items.map((item) => item.schoolNameZh && item.schoolNameZh !== item.schoolName ? item.schoolName : "") },
          { label: "项目", values: items.map((item) => item.programName) },
          { label: "国家", values: items.map((item) => item.country) },
          { label: "学位", values: items.map((item) => item.degree) },
          { label: "专业方向", values: items.map((item) => item.discipline) },
          { label: "QS", values: items.map((item) => rankingLabel(item)) },
          { label: "学费", values: items.map((item) => tuitionLabel(item)) },
          { label: "学制", values: items.map((item) => item.duration) },
          { label: "入学季", values: items.map((item) => item.intake) },
          { label: "门槛状态", values: items.map((item) => admissionsSnapshotLabel(item)) },
        ];

        return `
          <table>
            <thead>
              <tr>
                <th>对比项</th>
                ${items
                  .map(
                    (item) => `<th>${escapeHtml(item.schoolNameZh || item.schoolName)}<div class="school-toolbox-compare-title">${escapeHtml(item.programName)}</div></th>`
                  )
                  .join("")}
              </tr>
            </thead>
            <tbody>
              ${rows
                .map(
                  (row) => `
                    <tr>
                      <th>${escapeHtml(row.label)}</th>
                      ${row.values
                        .map((value) => `<td>${escapeHtml(value || "—")}</td>`)
                        .join("")}
                    </tr>
                  `
                )
                .join("")}
            </tbody>
          </table>
        `;
      };

      const renderComparePanel = () => {
        if (!(comparePanel instanceof HTMLElement) || !(compareTableNode instanceof HTMLElement)) {
          return;
        }

        comparePanel.hidden = comparePrograms.length === 0;
        compareTableNode.innerHTML = compareTableHtml(comparePrograms);
      };

      const favoriteSchoolItemHtml = (item) => `
        <article class="school-toolbox-item">
          <div class="school-toolbox-item-head">
            <strong>${escapeHtml(item.schoolNameZh || item.schoolName)}</strong>
            <span>${escapeHtml(compactDateTime(item.savedAt))}</span>
          </div>
          <p>${escapeHtml([item.country, [item.city, item.stateOrProvince].filter(Boolean).join(", ")].filter(Boolean).join(" / ") || "已收藏学校")}</p>
          <div class="school-toolbox-item-actions">
            ${item.officialWebsite ? `<a href="${escapeHtml(item.officialWebsite)}" target="_blank" rel="noreferrer">打开官网</a>` : ""}
            <button type="button" data-toolbox-action="remove-school-favorite" data-university-id="${escapeHtml(item.universityId)}">移除</button>
          </div>
        </article>
      `;

      const favoriteProgramItemHtml = (item) => `
        <article class="school-toolbox-item">
          <div class="school-toolbox-item-head">
            <strong>${escapeHtml(item.schoolNameZh || item.schoolName)}</strong>
            <span>${escapeHtml(compactDateTime(item.savedAt))}</span>
          </div>
          <p>${escapeHtml(item.programName)}</p>
          <div class="school-toolbox-item-meta">
            <span>${escapeHtml(item.country || "")}</span>
            <span>${escapeHtml(item.degree || "")}</span>
            <span>${escapeHtml(item.discipline || "")}</span>
          </div>
          <div class="school-toolbox-item-actions">
            ${item.overviewUrl ? `<a href="${escapeHtml(item.overviewUrl)}" target="_blank" rel="noreferrer">打开项目页</a>` : ""}
            <button type="button" data-toolbox-action="toggle-compare" data-program-id="${escapeHtml(item.id)}">${isProgramCompared(item.id) ? "移出对比" : "加入对比"}</button>
            <button type="button" data-toolbox-action="remove-program-favorite" data-program-id="${escapeHtml(item.id)}">移除</button>
          </div>
        </article>
      `;

      const savedSearchItemHtml = (item) => `
        <article class="school-toolbox-item">
          <div class="school-toolbox-item-head">
            <strong>${escapeHtml(item.label || "未命名搜索")}</strong>
            <span>${escapeHtml(compactDateTime(item.createdAt))}</span>
          </div>
          <p>${escapeHtml(item.freeText || "使用结构化条件保存")}</p>
          <div class="school-toolbox-item-meta">
            ${[
              item.country,
              item.degree,
              item.major,
              item.specialization,
            ]
              .filter(Boolean)
              .map((value) => `<span>${escapeHtml(value)}</span>`)
              .join("")}
          </div>
          <div class="school-toolbox-item-actions">
            <button type="button" data-toolbox-action="apply-saved-search" data-saved-search-id="${escapeHtml(item.id)}">重新搜索</button>
            <button type="button" data-toolbox-action="remove-saved-search" data-saved-search-id="${escapeHtml(item.id)}">删除</button>
          </div>
        </article>
      `;

      const renderToolboxLists = () => {
        if (favoriteSchoolsCountNode instanceof HTMLElement) {
          favoriteSchoolsCountNode.textContent = String(favoriteSchools.length);
        }
        if (favoriteProgramsCountNode instanceof HTMLElement) {
          favoriteProgramsCountNode.textContent = String(favoritePrograms.length);
        }
        if (compareCountNode instanceof HTMLElement) {
          compareCountNode.textContent = String(comparePrograms.length);
        }
        if (savedSearchCountNode instanceof HTMLElement) {
          savedSearchCountNode.textContent = String(savedSearches.length);
        }

        if (favoriteSchoolsListNode instanceof HTMLElement) {
          favoriteSchoolsListNode.innerHTML = favoriteSchools.length
            ? favoriteSchools.map(favoriteSchoolItemHtml).join("")
            : `<div class="school-toolbox-empty"><strong>还没有收藏学校</strong><p>先点开某所学校，再点“收藏这所学校”。</p></div>`;
        }

        if (favoriteProgramsListNode instanceof HTMLElement) {
          favoriteProgramsListNode.innerHTML = favoritePrograms.length
            ? favoritePrograms.map(favoriteProgramItemHtml).join("")
            : `<div class="school-toolbox-empty"><strong>还没有收藏项目</strong><p>在项目卡片上点“收藏项目”，后面导出和咨询会更方便。</p></div>`;
        }

        if (savedSearchesListNode instanceof HTMLElement) {
          savedSearchesListNode.innerHTML = savedSearches.length
            ? savedSearches.map(savedSearchItemHtml).join("")
            : `<div class="school-toolbox-empty"><strong>还没有保存搜索</strong><p>把常用国家 / 专业组合先保存下来，下次可以一键重跑。</p></div>`;
        }

        renderComparePanel();
      };

      const syncUtilityActionStates = () => {
        root.querySelectorAll("[data-program-favorite-button]").forEach((node) => {
          if (!(node instanceof HTMLButtonElement)) return;
          const programId = node.getAttribute("data-program-favorite-button") || "";
          const active = isProgramFavorited(programId);
          node.textContent = active ? "已收藏项目" : "收藏项目";
          node.classList.toggle("is-active", active);
        });

        root.querySelectorAll("[data-program-compare-button]").forEach((node) => {
          if (!(node instanceof HTMLButtonElement)) return;
          const programId = node.getAttribute("data-program-compare-button") || "";
          const active = isProgramCompared(programId);
          node.textContent = active ? "移出对比" : "加入对比";
          node.classList.toggle("is-active", active);
        });

        if (schoolSummaryFavoriteButton instanceof HTMLButtonElement && selectedSchoolSummary) {
          const active = isSchoolFavorited(selectedSchoolSummary.universityId);
          schoolSummaryFavoriteButton.hidden = false;
          schoolSummaryFavoriteButton.textContent = active ? "已收藏这所学校" : "收藏这所学校";
          schoolSummaryFavoriteButton.classList.toggle("is-active", active);
        }
      };

      const persistFavorites = () => {
        writeStorageValue(FAVORITES_STORAGE_KEY, {
          schools: favoriteSchools,
          programs: favoritePrograms,
        });
      };

      const persistSavedSearches = () => {
        writeStorageValue(SAVED_SEARCHES_STORAGE_KEY, savedSearches);
      };

      const persistComparePrograms = () => {
        writeStorageValue(COMPARE_STORAGE_KEY, comparePrograms);
      };

      const loadUtilityState = () => {
        const favoritePayload = readStorageValue(FAVORITES_STORAGE_KEY, {});
        if (favoritePayload && !Array.isArray(favoritePayload) && typeof favoritePayload === "object") {
          favoriteSchools = Array.isArray(favoritePayload.schools) ? favoritePayload.schools : [];
          favoritePrograms = Array.isArray(favoritePayload.programs) ? favoritePayload.programs : [];
        }

        const savedSearchPayload = readStorageValue(SAVED_SEARCHES_STORAGE_KEY, []);
        const comparePayload = readStorageValue(COMPARE_STORAGE_KEY, []);
        savedSearches = Array.isArray(savedSearchPayload) ? savedSearchPayload : [];
        comparePrograms = Array.isArray(comparePayload) ? comparePayload.slice(0, 4) : [];
        renderToolboxLists();
        syncUtilityActionStates();
      };

      const toggleProgramFavorite = (program) => {
        const snapshot = snapshotProgram(program);
        if (!snapshot.id) return;

        if (isProgramFavorited(snapshot.id)) {
          favoritePrograms = favoritePrograms.filter((item) => item.id !== snapshot.id);
          setStatus(`已从收藏项目中移除 ${snapshot.schoolNameZh || snapshot.schoolName} · ${snapshot.programName}`);
        } else {
          favoritePrograms = [snapshot, ...favoritePrograms.filter((item) => item.id !== snapshot.id)].slice(0, 24);
          setStatus(`已收藏项目：${snapshot.schoolNameZh || snapshot.schoolName} · ${snapshot.programName}`);
        }

        persistFavorites();
        renderToolboxLists();
        syncUtilityActionStates();
      };

      const toggleSchoolFavorite = (school) => {
        const snapshot = snapshotSchool(school);
        if (!snapshot.universityId) return;

        if (isSchoolFavorited(snapshot.universityId)) {
          favoriteSchools = favoriteSchools.filter((item) => item.universityId !== snapshot.universityId);
          setStatus(`已从收藏学校中移除 ${snapshot.schoolNameZh || snapshot.schoolName}`);
        } else {
          favoriteSchools = [snapshot, ...favoriteSchools.filter((item) => item.universityId !== snapshot.universityId)].slice(0, 24);
          setStatus(`已收藏学校：${snapshot.schoolNameZh || snapshot.schoolName}`);
        }

        persistFavorites();
        renderToolboxLists();
        syncUtilityActionStates();
      };

      const toggleCompareProgram = (program) => {
        const snapshot = snapshotProgram(program);
        if (!snapshot.id) return;

        if (isProgramCompared(snapshot.id)) {
          comparePrograms = comparePrograms.filter((item) => item.id !== snapshot.id);
          setStatus(`已从项目对比中移除 ${snapshot.programName}`);
        } else {
          if (comparePrograms.length >= 4) {
            setStatus("项目对比最多保留 4 个，请先移除一个再继续添加。");
            return;
          }

          comparePrograms = [...comparePrograms, snapshot];
          setStatus(`已加入项目对比：${snapshot.programName}`);
        }

        persistComparePrograms();
        renderToolboxLists();
        syncUtilityActionStates();
      };

      const saveCurrentSearch = () => {
        const payload = collectPayload();
        if (
          !payload.freeText &&
          !payload.country &&
          !payload.degree &&
          !payload.major &&
          !payload.specialization &&
          !payload.budgetTier &&
          !payload.intake &&
          !payload.gpaProfile &&
          !payload.languageProfile
        ) {
          setStatus("先设置一组搜索条件，再保存当前搜索。");
          return;
        }

        const entry = {
          ...payload,
          id: `${Date.now()}`,
          label: savedSearchLabel(payload),
          createdAt: isoNow(),
        };
        savedSearches = [entry, ...savedSearches.filter((item) => item.id !== entry.id)].slice(0, 12);
        persistSavedSearches();
        renderToolboxLists();
        setStatus(`已保存搜索：${entry.label}`);
      };

      const exportCurrentResultsAsCsv = () => {
        if (!Array.isArray(activeVerifiedResults) || !activeVerifiedResults.length) {
          setStatus("当前还没有可导出的正式项目结果。");
          return;
        }

        const header = [
          "学校",
          "英文校名",
          "项目",
          "国家",
          "学位",
          "专业方向",
          "QS",
          "学费",
          "学制",
          "入学季",
          "项目页",
          "申请要求页",
        ];
        const rows = activeVerifiedResults.map((item) => [
          item.schoolNameZh || item.schoolName,
          item.schoolName,
          item.programName,
          item.country,
          item.degree,
          item.discipline,
          rankingLabel(item),
          tuitionLabel(item),
          item.duration,
          item.intake,
          item.overviewUrl,
          item.admissionsUrl,
        ]);
        const csv = [header, ...rows]
          .map((row) =>
            row
              .map((value) => `"${String(value || "").replaceAll('"', '""')}"`)
              .join(",")
          )
          .join("\n");
        downloadTextFile(csv, "study-abroad-search-results.csv", "text/csv;charset=utf-8");
        setStatus(`已导出 ${activeVerifiedResults.length} 条正式项目结果（CSV）。`);
      };

      const exportCurrentResultsAsJson = () => {
        if (!Array.isArray(activeVerifiedResults) || !activeVerifiedResults.length) {
          setStatus("当前还没有可导出的正式项目结果。");
          return;
        }

        const payload = {
          generatedAt: isoNow(),
          searchSessionId: activeSearchSessionId,
          query: activeSearchPayload,
          stats: activeSearchStats,
          results: activeVerifiedResults,
        };
        downloadTextFile(JSON.stringify(payload, null, 2), "study-abroad-search-results.json", "application/json;charset=utf-8");
        setStatus(`已导出 ${activeVerifiedResults.length} 条正式项目结果（JSON）。`);
      };

      const copyConsultSummary = async () => {
        if (!(consultSummaryText instanceof HTMLTextAreaElement) || !consultSummaryText.value.trim()) {
          setStatus("先生成咨询摘要，再复制给顾问。");
          return;
        }

        try {
          await navigator.clipboard.writeText(consultSummaryText.value);
          setStatus("咨询摘要已复制，可以直接发给顾问。");
        } catch {
          consultSummaryText.focus();
          consultSummaryText.select();
          setStatus("当前浏览器没有完成自动复制，请手动复制下方摘要内容。");
        }
      };

      const downloadConsultSummary = () => {
        if (!(consultSummaryText instanceof HTMLTextAreaElement) || !consultSummaryText.value.trim()) {
          setStatus("先生成咨询摘要，再下载。");
          return;
        }

        downloadTextFile(consultSummaryText.value, "study-abroad-consult-summary.txt");
        setStatus("咨询摘要已下载。");
      };

      const handoffConsultSummaryToContactForm = () => {
        const summary = buildConsultSummaryText().trim();
        if (!summary) {
          setStatus("先生成咨询摘要，再带入咨询表单。");
          return;
        }

        writeStorageValue(CONTACT_DRAFT_STORAGE_KEY, {
          source: "school-finder",
          summary,
          createdAt: isoNow(),
          appointmentType: "consultation",
          examType: "留学申请",
          preferredTime: "",
        });
        window.location.assign("/?prefill=school-finder#contact");
      };

      const applySavedSearch = (savedSearchId) => {
        const entry = savedSearches.find((item) => String(item?.id || "") === String(savedSearchId || ""));
        if (!entry) {
          setStatus("没有找到这条已保存搜索。");
          return;
        }

        const nextPayload = {
          freeText: entry.freeText || "",
          country: entry.country || "",
          degree: entry.degree || "",
          major: entry.major || "",
          specialization: entry.specialization || "",
          budgetTier: entry.budgetTier || "",
          intake: entry.intake || "",
          gpaProfile: entry.gpaProfile || "",
          languageProfile: entry.languageProfile || "",
          fitMode: entry.fitMode || "prefer",
          snapshotQuality: entry.snapshotQuality || "",
        };

        applyResolvedQueryToControls(nextPayload);
        setStatus(`正在重新搜索：${entry.label || "已保存搜索"}`);
        void runSearch(nextPayload);
      };

      const clearUtilityCollection = (type) => {
        if (type === "schools") {
          favoriteSchools = [];
          persistFavorites();
          renderToolboxLists();
          syncUtilityActionStates();
          setStatus("已清空收藏学校。");
          return;
        }

        if (type === "programs") {
          favoritePrograms = [];
          persistFavorites();
          renderToolboxLists();
          syncUtilityActionStates();
          setStatus("已清空收藏项目。");
          return;
        }

        if (type === "saved-searches") {
          savedSearches = [];
          persistSavedSearches();
          renderToolboxLists();
          setStatus("已清空保存的搜索条件。");
          return;
        }

        if (type === "compare") {
          comparePrograms = [];
          persistComparePrograms();
          renderToolboxLists();
          syncUtilityActionStates();
          setStatus("已清空项目对比。");
        }
      };

      const normalizeClientText = (value) =>
        String(value || "")
          .toLowerCase()
          .replace(/[()]/g, " ")
          .replace(/[.,/\\-]+/g, " ")
          .replace(/\s+/g, " ")
          .trim();

      const buildProgramReasonChips = (program, payload = {}) => {
        const reasons = [];
        const searchText = normalizeClientText(
          [
            program?.discipline,
            program?.programName,
            program?.summary,
            ...(Array.isArray(program?.tags) ? program.tags : []),
            ...(Array.isArray(program?.keywords) ? program.keywords : []),
          ].join(" ")
        );

        if (payload?.major && program?.discipline === payload.major) {
          reasons.push("专业大类直连");
        }

        if (
          payload?.specialization &&
          searchText.includes(normalizeClientText(payload.specialization))
        ) {
          reasons.push("细分方向相关");
        }

        if (payload?.country && program?.country === payload.country) {
          reasons.push(`${program.country}方向`);
        }

        if (payload?.budgetTier && program?.tuitionAmount) {
          reasons.push("已带学费样本");
        }

        if (payload?.intake && program?.intake) {
          reasons.push("已带入学季");
        }

        if (program?.admissionsSnapshot?.extractionStatus === "ok") {
          reasons.push("门槛已完整入库");
        } else if (program?.admissionsSnapshot?.extractionStatus === "partial") {
          reasons.push("门槛已补部分字段");
        } else if (program?.admissionsUrl) {
          reasons.push("可继续核对官方要求");
        }

        if ((payload?.gpaProfile || payload?.languageProfile) && program?.admissionsSnapshot?.extractedAt) {
          reasons.push("可结合背景预估");
        }

        if (program?.qsRank && Number(program.qsRank) > 0) {
          reasons.push("带QS排名");
        }

        return Array.from(new Set(reasons)).slice(0, 4);
      };

      const reasonChipsHtml = (program, payload = {}) => {
        const reasons = buildProgramReasonChips(program, payload);
        if (!reasons.length) {
          return "";
        }

        return `
          <div class="school-card-reasons">
            ${reasons.map((reason) => `<span>${escapeHtml(reason)}</span>`).join("")}
          </div>
        `;
      };

      const buildProgramSignalPills = (program, payload = {}) => {
        const searchText = normalizeClientText(
          [
            program?.discipline,
            program?.programName,
            program?.summary,
            ...(Array.isArray(program?.tags) ? program.tags : []),
            ...(Array.isArray(program?.keywords) ? program.keywords : []),
          ].join(" ")
        );
        const majorExact = Boolean(payload?.major && program?.discipline === payload.major);
        const specializationMatched = Boolean(
          payload?.specialization &&
            searchText.includes(normalizeClientText(payload.specialization))
        );
        const snapshotStatus = String(program?.admissionsSnapshot?.extractionStatus || "");
        const hasStructuredSnapshot = snapshotStatus === "ok";
        const hasPartialSnapshot = snapshotStatus === "partial";
        const hasAdmissionsSnapshot = Boolean(program?.admissionsSnapshot?.extractedAt);
        const hasAdmissionsUrl = Boolean(program?.admissionsUrl);
        const hasTuition = Number(program?.tuitionAmount) > 0;
        const hasRanking = Number(program?.qsRank) > 0;
        const hasFitInput = Boolean(payload?.gpaProfile || payload?.languageProfile);

        const fitLabel =
          majorExact && specializationMatched
            ? "适配 高"
            : majorExact || specializationMatched
              ? "适配 较高"
              : "适配 扩展";
        const fitTone =
          majorExact && specializationMatched
            ? "match"
            : majorExact || specializationMatched
              ? "review"
              : "soft";

        const readinessLabel =
          hasStructuredSnapshot && hasTuition && hasRanking
            ? "资料 完整"
            : hasStructuredSnapshot || hasPartialSnapshot || (hasTuition && hasAdmissionsUrl)
              ? "资料 较全"
              : "资料 待补";
        const readinessTone =
          hasStructuredSnapshot && hasTuition && hasRanking
            ? "match"
            : hasStructuredSnapshot || hasPartialSnapshot || (hasTuition && hasAdmissionsUrl)
              ? "review"
              : "soft";

        const actionLabel =
          hasFitInput && hasAdmissionsSnapshot
            ? "建议 先咨询"
            : hasStructuredSnapshot || hasPartialSnapshot
              ? "建议 看要求"
              : hasAdmissionsUrl
                ? "建议 核官网"
                : "建议 先收藏";
        const actionTone =
          hasFitInput && hasAdmissionsSnapshot
            ? "match"
            : hasStructuredSnapshot || hasPartialSnapshot || hasAdmissionsUrl
              ? "review"
              : "soft";

        return [
          { label: fitLabel, tone: fitTone },
          { label: readinessLabel, tone: readinessTone },
          { label: actionLabel, tone: actionTone },
        ];
      };

      const signalPillsHtml = (program, payload = {}) => {
        const signals = buildProgramSignalPills(program, payload);
        if (!signals.length) {
          return "";
        }

        return `
          <div class="school-card-signals">
            ${signals
              .map(
                (signal) =>
                  `<span class="school-card-signal school-card-signal--${escapeHtml(signal.tone)}">${escapeHtml(signal.label)}</span>`
              )
              .join("")}
          </div>
        `;
      };

      const currentSchoolRefiners = () => ({
        keyword:
          schoolKeywordInput instanceof HTMLInputElement
            ? schoolKeywordInput.value.trim().toLowerCase()
            : "",
        rank:
          schoolRankSelect instanceof HTMLSelectElement ? schoolRankSelect.value : "",
        tuition:
          schoolTuitionSelect instanceof HTMLSelectElement ? schoolTuitionSelect.value : "",
        availability:
          schoolAvailabilitySelect instanceof HTMLSelectElement
            ? schoolAvailabilitySelect.value
            : "",
      });

      const resetSchoolRefiners = () => {
        if (schoolKeywordInput instanceof HTMLInputElement) schoolKeywordInput.value = "";
        if (schoolRankSelect instanceof HTMLSelectElement) schoolRankSelect.value = "";
        if (schoolTuitionSelect instanceof HTMLSelectElement) schoolTuitionSelect.value = "";
        if (schoolAvailabilitySelect instanceof HTMLSelectElement) {
          schoolAvailabilitySelect.value = "";
        }
      };

      const hasActiveSchoolRefiners = () => {
        const filters = currentSchoolRefiners();
        return Boolean(filters.keyword || filters.rank || filters.tuition || filters.availability);
      };

      const matchesRankFilter = (school, rankFilter) => {
        if (!rankFilter) return true;

        const rank = Number(school?.qsRank);
        if (!Number.isFinite(rank) || rank <= 0) {
          return rankFilter === "ranked" ? false : false;
        }

        if (rankFilter === "ranked") return true;
        if (rankFilter === "top-50") return rank <= 50;
        if (rankFilter === "top-100") return rank <= 100;
        if (rankFilter === "top-200") return rank <= 200;
        return true;
      };

      const matchesTuitionFilter = (school, tuitionFilter) => {
        if (!tuitionFilter) return true;

        const min = Number(school?.tuitionMin);
        const max = Number(school?.tuitionMax);
        const hasTuition =
          (Number(school?.tuitionProjectCount) || 0) > 0 &&
          Number.isFinite(min) &&
          min > 0;

        if (tuitionFilter === "with-tuition") {
          return hasTuition;
        }

        if (!hasTuition) {
          return false;
        }

        if (tuitionFilter === "under-30000") {
          return min < 30000;
        }

        if (tuitionFilter === "30000-50000") {
          return min <= 50000 && (Number.isFinite(max) ? max >= 30000 : min >= 30000);
        }

        if (tuitionFilter === "50000-plus") {
          return (Number.isFinite(max) ? max : min) >= 50000;
        }

        return true;
      };

      const filterUniversityMatches = (items) => {
        const filters = currentSchoolRefiners();
        if (!Array.isArray(items) || !items.length) {
          return [];
        }

        return items.filter((school) => {
          const keywordMatched =
            !filters.keyword ||
            [
              school.schoolNameZh,
              school.schoolName,
              school.country,
              school.city,
              school.stateOrProvince,
              ...(school.topDisciplines || []),
            ]
              .join(" ")
              .toLowerCase()
              .includes(filters.keyword);

          if (!keywordMatched) return false;

          if (!matchesRankFilter(school, filters.rank)) return false;
          if (!matchesTuitionFilter(school, filters.tuition)) return false;

          if (filters.availability === "with-programs" && Number(school.programCount) <= 0) {
            return false;
          }

          if (filters.availability === "catalog-only" && Number(school.programCount) > 0) {
            return false;
          }

          return true;
        });
      };

      const hideSchoolSummary = () => {
        selectedSchoolSummary = null;
        if (schoolSummaryPanel instanceof HTMLElement) {
          schoolSummaryPanel.hidden = true;
        }
        if (schoolSummaryFavoriteButton instanceof HTMLButtonElement) {
          schoolSummaryFavoriteButton.hidden = true;
          schoolSummaryFavoriteButton.classList.remove("is-active");
        }
      };

      const renderSchoolSummary = (school) => {
        if (
          !(schoolSummaryPanel instanceof HTMLElement) ||
          !(schoolSummaryTitleNode instanceof HTMLElement) ||
          !(schoolSummarySubtitleNode instanceof HTMLElement) ||
          !(schoolSummaryFactsNode instanceof HTMLElement) ||
          !(schoolSummaryTagsNode instanceof HTMLElement) ||
          !(schoolSummaryNoteNode instanceof HTMLElement)
        ) {
          return;
        }

        if (!school) {
          hideSchoolSummary();
          return;
        }

        selectedSchoolSummary = school;
        schoolSummaryPanel.hidden = false;
        schoolSummaryTitleNode.textContent = school.schoolNameZh || school.schoolName;
        schoolSummarySubtitleNode.textContent =
          school.schoolNameZh && school.schoolNameZh !== school.schoolName
            ? school.schoolName
            : [school.country, [school.city, school.stateOrProvince].filter(Boolean).join(", ")]
                .filter(Boolean)
                .join(" / ");

        if (schoolSummaryLink instanceof HTMLAnchorElement) {
          schoolSummaryLink.href = school.officialWebsite || "#";
          schoolSummaryLink.style.display = school.officialWebsite ? "" : "none";
        }

        const factItems = [
          schoolRankingLabel(school),
          [school.country, [school.city, school.stateOrProvince].filter(Boolean).join(", ")]
            .filter(Boolean)
            .join(" / "),
          Number(school.programCount) > 0
            ? `${school.programCount} 个项目`
            : "已进入学校底库，项目层持续补充中",
          schoolTuitionLabel(school),
        ].filter(Boolean);

        schoolSummaryFactsNode.innerHTML = factItems
          .map((item) => `<span>${escapeHtml(item)}</span>`)
          .join("");

        const tags = [
          ...(school.topDisciplines || []),
          ...(school.featuredPrograms || []),
        ].filter(Boolean).slice(0, 5);

        schoolSummaryTagsNode.innerHTML = tags
          .map((item) => `<span>${escapeHtml(item)}</span>`)
          .join("");

        schoolSummaryNoteNode.textContent =
          Number(school.programCount) > 0
            ? "你现在看到的是这所学校当前已经补进项目库的项目结果，后面还可以继续点“查看要求摘要”读取官网招生页。"
            : "这所学校已经进入学校底库，但项目页和学费页还在继续补全。现在可以先打开学校官网做第一轮核对。";
        syncUtilityActionStates();
      };

      const cardHtml = (program) => {
        const facts = [
          rankingLabel(program) ? `<span>${rankingLabel(program)}</span>` : "",
          tuitionLabel(program) ? `<span>${escapeHtml(tuitionLabel(program))}</span>` : "",
          program.duration ? `<span>学制：${escapeHtml(program.duration)}</span>` : "",
          program.intake ? `<span>入学：${escapeHtml(program.intake)}</span>` : "",
          `<span data-program-admissions-status="${escapeHtml(program.id)}" ${
            admissionsSnapshotLabel(program) ? "" : "hidden"
          }>${escapeHtml(admissionsSnapshotLabel(program))}</span>`,
          `<span>核对：${escapeHtml(program.checkedAt)}</span>`,
        ]
          .filter(Boolean)
          .join("");

        const admissionsLink =
          program.admissionsUrl && program.admissionsUrl !== program.overviewUrl
            ? `<a href="${escapeHtml(program.admissionsUrl)}" target="_blank" rel="noreferrer">申请要求页</a>`
            : "";

        return `
          <article class="school-card" data-program-card="${escapeHtml(program.id)}">
            <div class="school-card-top">
              <div>
                <div class="school-card-meta">
                  <span>${escapeHtml(program.country)}</span>
                  ${locationLabel(program) ? `<span>${escapeHtml(locationLabel(program))}</span>` : ""}
                  <span>${escapeHtml(program.degree)}</span>
                </div>
                <h4>${escapeHtml(program.schoolNameZh || program.schoolName)}</h4>
                ${
                  program.schoolNameZh && program.schoolNameZh !== program.schoolName
                    ? `<div class="school-card-school-en">${escapeHtml(program.schoolName)}</div>`
                    : ""
                }
                <p class="school-card-program">${escapeHtml(program.programName)}</p>
              </div>
              <div class="school-card-discipline">${escapeHtml(program.discipline)}</div>
            </div>

            <p class="school-card-summary">${escapeHtml(program.summary)}</p>

            ${signalPillsHtml(program, activeSearchPayload)}

            ${reasonChipsHtml(program, activeSearchPayload)}

            <div class="school-card-tags">
              ${(program.tags || []).map((tag) => `<span>${escapeHtml(tag)}</span>`).join("")}
            </div>

            <div class="school-card-facts">${facts}</div>

            <div class="school-card-fit" data-program-fit="${escapeHtml(program.id)}" hidden></div>

            <div class="school-card-actions">
              <a href="${escapeHtml(program.officialWebsite || program.overviewUrl)}" target="_blank" rel="noreferrer">院校官网</a>
              <a href="${escapeHtml(program.overviewUrl)}" target="_blank" rel="noreferrer">项目页</a>
              ${admissionsLink}
              <button type="button" class="school-card-trigger" data-program-favorite-button="${escapeHtml(program.id)}">收藏项目</button>
              <button type="button" class="school-card-trigger" data-program-compare-button="${escapeHtml(program.id)}">加入对比</button>
              <button type="button" class="school-card-trigger" data-program-detail-button="${escapeHtml(program.id)}">查看要求摘要</button>
            </div>
          </article>
        `;
      };

      const hasFitPreviewInput = (payload) =>
        Boolean(payload?.gpaProfile || payload?.languageProfile);

      const hasCandidateExpansionInput = (payload) =>
        Boolean((payload?.country || payload?.freeText) && (payload?.degree || payload?.freeText) && !payload?.universityId);

      const fitBadgeLabel = (status) => {
        if (status === "match") return "匹配";
        if (status === "risk") return "偏紧";
        return "待核对";
      };

      const clearFitPreviews = () => {
        root.querySelectorAll("[data-program-fit]").forEach((node) => {
          if (!(node instanceof HTMLElement)) {
            return;
          }

          node.hidden = true;
          node.className = "school-card-fit";
          node.innerHTML = "";
        });
      };

      const fitPreviewHtml = (preview) => `
        <div class="school-card-fit-head">
          <strong>${escapeHtml(preview.headline || "当前背景待核对")}</strong>
          <span class="school-card-fit-badge school-card-fit-badge--${escapeHtml(preview.status || "review")}">
            ${escapeHtml(fitBadgeLabel(preview.status))}
          </span>
        </div>
        <ul class="school-card-fit-items">
          ${(Array.isArray(preview.details) ? preview.details : [])
            .slice(0, 3)
            .map((item) => `<li>${escapeHtml(item)}</li>`)
            .join("")}
        </ul>
      `;

      const renderFitPreviews = (previews) => {
        clearFitPreviews();

        if (!Array.isArray(previews) || !previews.length) {
          return;
        }

        previews.forEach((preview) => {
          const node = root.querySelector(
            `[data-program-fit="${CSS.escape(String(preview.programId || ""))}"]`
          );

          if (!(node instanceof HTMLElement)) {
            return;
          }

          node.hidden = false;
          node.className = `school-card-fit school-card-fit--${preview.status || "review"}`;
          node.innerHTML = fitPreviewHtml(preview);
        });
      };

      const hydrateFitPreviews = async (items, payload) => {
        fitPreviewToken += 1;
        const token = fitPreviewToken;
        clearFitPreviews();

        if (!hasFitPreviewInput(payload) || !Array.isArray(items) || !items.length) {
          return;
        }

        const programIds = items
          .filter((item) => item?.admissionsSnapshot?.extractedAt)
          .map((item) => String(item?.id || "").trim())
          .filter(Boolean)
          .slice(0, 4);

        if (!programIds.length) {
          return;
        }

        programIds.forEach((programId) => {
          const node = root.querySelector(
            `[data-program-fit="${CSS.escape(programId)}"]`
          );

          if (!(node instanceof HTMLElement)) {
            return;
          }

          node.hidden = false;
          node.className = "school-card-fit school-card-fit--review";
          node.innerHTML = `
            <div class="school-card-fit-head">
              <strong>正在比对招生要求</strong>
              <span class="school-card-fit-badge school-card-fit-badge--review">分析中</span>
            </div>
            <ul class="school-card-fit-items">
              <li>系统正在根据官网页提取 GPA、语言成绩和标化要求。</li>
            </ul>
          `;
        });

        try {
          const response = await fetch("/api/study-abroad/fit-preview", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              programIds,
              gpaProfile: payload.gpaProfile || "",
              languageProfile: payload.languageProfile || "",
            }),
          });

          const data = await response.json();
          if (token !== fitPreviewToken) {
            return;
          }

          if (!response.ok || !data?.ok) {
            throw new Error(data?.message || "暂时无法生成背景匹配预估。");
          }

          renderFitPreviews(data.previews);
        } catch (error) {
          if (token !== fitPreviewToken) {
            return;
          }

          programIds.forEach((programId) => {
            const node = root.querySelector(
              `[data-program-fit="${CSS.escape(programId)}"]`
            );

            if (!(node instanceof HTMLElement)) {
              return;
            }

            node.hidden = false;
            node.className = "school-card-fit school-card-fit--review";
            node.innerHTML = `
              <div class="school-card-fit-head">
                <strong>当前背景待核对</strong>
                <span class="school-card-fit-badge school-card-fit-badge--review">待核对</span>
              </div>
              <ul class="school-card-fit-items">
                <li>${escapeHtml(error instanceof Error ? error.message : "暂时无法生成背景匹配预估，请先查看要求摘要。")}</li>
              </ul>
            `;
          });
        }
      };

      const candidateCardHtml = (candidate) => `
        <article class="candidate-card">
          <div class="candidate-card-top">
            <div>
              <div class="candidate-card-site">${escapeHtml(candidate.displayLink || candidate.provider || "候选官网页")}</div>
              <h4>${escapeHtml(candidate.title)}</h4>
            </div>
            ${candidate.date ? `<span class="candidate-card-date">${escapeHtml(candidate.date)}</span>` : ""}
          </div>

          <div class="candidate-card-credibility">
            <span class="candidate-card-credibility-badge candidate-card-credibility-badge--${escapeHtml(candidate.credibilityLevel || "watch")}">${escapeHtml(candidate.credibilityLabel || "待核对")}</span>
            <span class="candidate-card-credibility-text">${escapeHtml(candidate.credibilityReason || "来源和内容仍建议后台继续核对。")}</span>
          </div>

          ${
            Array.isArray(candidate.relevanceSignals) && candidate.relevanceSignals.length
              ? `<div class="candidate-card-signals">${candidate.relevanceSignals
                  .filter(Boolean)
                  .map((item) => `<span>${escapeHtml(item)}</span>`)
                  .join("")}</div>`
              : ""
          }

          <p class="candidate-card-summary">${escapeHtml(
            String(
              candidate.snippet || "该页面已通过规则初筛，建议优先查看院校官网中的招生和申请说明。"
            ).slice(0, 280)
          )}</p>

          <div class="candidate-card-actions">
            <a href="${escapeHtml(candidate.link)}" target="_blank" rel="noreferrer">打开官网页</a>
          </div>
        </article>
      `;

      const schoolCardHtml = (school, selectedId) => {
        const isActive = school.universityId === selectedId;
        const meta = [
          school.country,
          [school.city, school.stateOrProvince].filter(Boolean).join(", "),
          school.qsRank && Number(school.qsRank) > 0
            ? `QS ${school.qsRankingYear || 2026}：#${school.qsRank}`
            : "",
          schoolTuitionLabel(school),
        ]
          .filter(Boolean)
          .map((item) => `<span>${escapeHtml(item)}</span>`)
          .join("");

        return `
          <button class="school-pool-card ${isActive ? "is-active" : ""}" type="button" data-university-id="${escapeHtml(school.universityId)}">
            <div class="school-pool-top">
              <strong>${escapeHtml(school.schoolNameZh || school.schoolName)}</strong>
              <span>${escapeHtml(school.programCount)} 个项目</span>
            </div>
            ${
              school.schoolNameZh && school.schoolNameZh !== school.schoolName
                ? `<div class="school-pool-school-en">${escapeHtml(school.schoolName)}</div>`
                : ""
            }
            <div class="school-pool-meta">${meta}</div>
            <p>${escapeHtml(
              (school.topDisciplines || []).join(" · ") ||
                (school.featuredPrograms || []).slice(0, 2).join(" / ") ||
                (Number(school.programCount) > 0
                  ? "点击后查看该校项目"
                  : "已进入学校底库，项目层持续补充中")
            )}</p>
          </button>
        `;
      };

      const hideDetailPanel = () => {
        activeDetailProgramId = "";

        if (detailPanel instanceof HTMLElement) {
          detailPanel.hidden = true;
        }

        if (detailTitleNode instanceof HTMLElement) {
          detailTitleNode.textContent = "官方招生要求摘要";
        }

        if (detailSubtitleNode instanceof HTMLElement) {
          detailSubtitleNode.textContent =
            "点击上方项目中的“查看要求摘要”后，这里会读取院校官网内容并展示关键信息。";
        }

        if (detailBodyNode instanceof HTMLElement) {
          detailBodyNode.innerHTML = "";
        }
      };

      const showDetailPanel = ({ title, subtitle, bodyHtml }) => {
        if (!(detailPanel instanceof HTMLElement) || !(detailBodyNode instanceof HTMLElement)) {
          return;
        }

        detailPanel.hidden = false;

        if (detailTitleNode instanceof HTMLElement) {
          detailTitleNode.textContent = title;
        }

        if (detailSubtitleNode instanceof HTMLElement) {
          detailSubtitleNode.textContent = subtitle;
        }

        detailBodyNode.innerHTML = bodyHtml;
        detailPanel.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      const requirementGroupHtml = (group) => `
        <section class="requirement-group">
          <h5>${escapeHtml(group.label)}</h5>
          <ul>
            ${(group.items || []).map((item) => `<li>${escapeHtml(item)}</li>`).join("")}
          </ul>
        </section>
      `;

      const admissionsSnapshotHtml = (profile) => {
        if (!profile || typeof profile !== "object") {
          return "";
        }

        const items = [
          profile.gpaMin
            ? `最低 GPA：${escapeHtml(Number(profile.gpaMin).toFixed(1))}/${escapeHtml(profile.gpaScale || "4.0")}`
            : "",
          profile.ieltsMin ? `IELTS：${escapeHtml(profile.ieltsMin)}` : "",
          profile.toeflMin ? `TOEFL：${escapeHtml(profile.toeflMin)}` : "",
          profile.duolingoMin ? `Duolingo：${escapeHtml(profile.duolingoMin)}` : "",
          profile.pteMin ? `PTE：${escapeHtml(profile.pteMin)}` : "",
          profile.greStatus && profile.greStatus !== "unknown"
            ? `GRE：${escapeHtml(
                profile.greStatus === "required"
                  ? "要求"
                  : profile.greStatus === "recommended"
                    ? "建议提交"
                    : "可选"
              )}`
            : "",
          profile.gmatStatus && profile.gmatStatus !== "unknown"
            ? `GMAT：${escapeHtml(
                profile.gmatStatus === "required"
                  ? "要求"
                  : profile.gmatStatus === "recommended"
                    ? "建议提交"
                    : "可选"
              )}`
            : "",
          profile.workExperienceYears
            ? `工作经验：${escapeHtml(profile.workExperienceYears)} 年+`
            : "",
        ].filter(Boolean);

        if (!items.length) {
          return "";
        }

        return `
          <section class="requirement-snapshot">
            <h5>结构化门槛快照</h5>
            <div class="requirement-snapshot-items">
              ${items.map((item) => `<span>${item}</span>`).join("")}
            </div>
          </section>
        `;
      };

      const detailHtml = (insight) => {
        const highlights = Array.isArray(insight?.highlights) ? insight.highlights : [];
        const groups = Array.isArray(insight?.requirementGroups) ? insight.requirementGroups : [];
        const links = [
          insight?.officialWebsite
            ? `<a href="${escapeHtml(insight.officialWebsite)}" target="_blank" rel="noreferrer">院校官网</a>`
            : "",
          insight?.overviewUrl
            ? `<a href="${escapeHtml(insight.overviewUrl)}" target="_blank" rel="noreferrer">项目页</a>`
            : "",
          insight?.admissionsUrl
            ? `<a href="${escapeHtml(insight.admissionsUrl)}" target="_blank" rel="noreferrer">招生要求页</a>`
            : "",
        ]
          .filter(Boolean)
          .join("");

        return `
          <div class="requirement-summary">${escapeHtml(insight?.summary || "暂未提取到可展示的招生要求摘要。")}</div>
          ${highlights.length ? `
            <div class="requirement-highlights">
              ${highlights.map((item) => `<span>${escapeHtml(item)}</span>`).join("")}
            </div>
          ` : ""}
          ${groups.length ? `
            <div class="requirement-grid">
              ${groups.map(requirementGroupHtml).join("")}
            </div>
          ` : `
            <div class="school-match-empty">
              <strong>暂未抽取到结构化字段</strong>
              <p>${escapeHtml(insight?.note || "建议直接打开官网查看最新招生要求。")}</p>
            </div>
          `}
          ${admissionsSnapshotHtml(insight?.admissionsProfile)}
          <div class="requirement-links">${links}</div>
          <div class="requirement-note">${escapeHtml(insight?.note || "")}</div>
        `;
      };

      const renderDetailLoading = (program) => {
        showDetailPanel({
          title: `${program.schoolName} · ${program.programName}`,
          subtitle: "正在读取官方招生页，请稍候…",
          bodyHtml: `
            <div class="requirement-loading">
              <strong>正在抓取官网内容</strong>
              <p>系统会优先读取项目招生页，再提取学术背景、语言成绩、材料要求等重点。</p>
            </div>
          `,
        });
      };

      const renderVerifiedResults = (items, emptyText) => {
        if (!verifiedResultsNode) {
          return;
        }

        if (!Array.isArray(items) || !items.length) {
          hideDetailPanel();
          verifiedResultsNode.innerHTML = `
            <div class="school-match-empty">
              <strong>这轮没有筛到合适结果</strong>
              <p>${escapeHtml(
                emptyText ||
                  "可以先放宽国家条件，或者改选更宽的专业方向，比如从“商业分析 / 数据”切到“商科 / 管理”。"
              )}</p>
            </div>
          `;
          return;
        }

        verifiedResultsNode.innerHTML = items.map(cardHtml).join("");
        syncUtilityActionStates();
      };

      const renderCandidateResults = (items) => {
        if (!(candidateSection instanceof HTMLElement) || !candidateResultsNode) {
          return;
        }

        if (!Array.isArray(items) || !items.length) {
          candidateSection.hidden = true;
          candidateResultsNode.innerHTML = "";

          if (candidateCountNode instanceof HTMLElement) {
            candidateCountNode.textContent = "";
          }

          return;
        }

        candidateSection.hidden = false;
        candidateResultsNode.innerHTML = items.map(candidateCardHtml).join("");

        if (candidateCountNode instanceof HTMLElement) {
          candidateCountNode.textContent = `${items.length} 条`;
        }
      };

      const renderUniversityMatches = (items, totalCount, selectedId) => {
        if (!(schoolsSection instanceof HTMLElement) || !schoolsResultsNode) {
          return;
        }

        const total = Number(totalCount) || 0;
        const filteredItems = filterUniversityMatches(items);
        const filteredCount = filteredItems.length;

        if (!Array.isArray(items) || !items.length) {
          schoolsSection.hidden = true;
          schoolsResultsNode.innerHTML = "";

          if (schoolsCountNode instanceof HTMLElement) {
            schoolsCountNode.textContent = "";
          }

          if (schoolsToolbar instanceof HTMLElement) {
            schoolsToolbar.hidden = true;
          }

          return;
        }

        schoolsSection.hidden = false;
        const visibleItems = filteredItems.slice(0, visibleSchoolCount);

        if (!filteredCount) {
          schoolsResultsNode.innerHTML = `
            <div class="school-match-empty">
              <strong>这轮学校池里没有符合二次筛选的院校</strong>
              <p>可以先放宽 QS、学费或项目状态条件，再继续筛学校。</p>
            </div>
          `;

          if (schoolsCountNode instanceof HTMLElement) {
            schoolsCountNode.textContent = total
              ? `筛出 0 / ${total} 所`
              : "0 所";
          }

          if (schoolsToolbar instanceof HTMLElement) {
            schoolsToolbar.hidden = true;
          }

          return;
        }

        const allCard = `
          <button class="school-pool-card ${selectedId ? "" : "is-active"}" type="button" data-university-id="">
            <div class="school-pool-top">
              <strong>全部院校</strong>
              <span>${escapeHtml(filteredCount)} / ${escapeHtml(total || filteredCount)} 所</span>
            </div>
            <p>先看这一轮命中的学校池，再点某所学校缩小下方项目结果。</p>
          </button>
        `;

        schoolsResultsNode.innerHTML =
          allCard + visibleItems.map((school) => schoolCardHtml(school, selectedId)).join("");

        if (schoolsCountNode instanceof HTMLElement) {
          if (hasActiveSchoolRefiners()) {
            schoolsCountNode.textContent =
              visibleItems.length < filteredCount
                ? `筛出 ${filteredCount} / ${total} 所，当前展示 ${visibleItems.length} 所`
                : `筛出 ${filteredCount} / ${total} 所`;
          } else {
            schoolsCountNode.textContent =
              total > visibleItems.length
                ? `展示 ${visibleItems.length} / ${total} 所`
                : `${visibleItems.length} 所`;
          }
        }

        if (schoolsToolbar instanceof HTMLElement && schoolsMoreButton instanceof HTMLButtonElement) {
          const hasMore = filteredItems.length > visibleItems.length;
          schoolsToolbar.hidden = !hasMore;
          schoolsMoreButton.hidden = !hasMore;
          schoolsMoreButton.textContent =
            visibleItems.length >= filteredItems.length
              ? "已展示全部院校"
              : `展开更多院校（剩余 ${filteredItems.length - visibleItems.length} 所）`;
        }
      };

      const openProgramDetails = async (programId) => {
        const program = activeVerifiedResults.find((item) => item.id === programId);
        if (!program) {
          return;
        }

        activeDetailProgramId = programId;

        if (detailCache.has(programId)) {
          const cached = detailCache.get(programId);
          showDetailPanel({
            title: `${program.schoolName} · ${program.programName}`,
            subtitle: cached?.sourceTitle
              ? `来源：${cached.sourceTitle}`
              : "来源：院校官网招生页",
            bodyHtml: detailHtml(cached),
          });
          return;
        }

        renderDetailLoading(program);

        try {
          const response = await fetch("/api/study-abroad/requirements", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              programId,
            }),
          });

          const data = await response.json();
          if (!response.ok || !data?.ok || !data?.insight) {
            throw new Error(data?.message || "暂时无法读取官方招生要求。");
          }

          detailCache.set(programId, data.insight);

          if (activeDetailProgramId !== programId) {
            return;
          }

          showDetailPanel({
            title: `${program.schoolName} · ${program.programName}`,
            subtitle: data.insight.sourceTitle
              ? `来源：${data.insight.sourceTitle}`
              : "来源：院校官网招生页",
            bodyHtml: detailHtml(data.insight),
          });
        } catch (error) {
          if (activeDetailProgramId !== programId) {
            return;
          }

          showDetailPanel({
            title: `${program.schoolName} · ${program.programName}`,
            subtitle: "来源：院校官网招生页",
            bodyHtml: `
              <div class="school-match-empty">
                <strong>暂时无法读取官方招生要求</strong>
                <p>${escapeHtml(error instanceof Error ? error.message : "请稍后重试，或直接打开官网核对。")}</p>
              </div>
              <div class="requirement-links">
                ${program.officialWebsite ? `<a href="${escapeHtml(program.officialWebsite)}" target="_blank" rel="noreferrer">院校官网</a>` : ""}
                <a href="${escapeHtml(program.overviewUrl)}" target="_blank" rel="noreferrer">项目页</a>
                ${program.admissionsUrl ? `<a href="${escapeHtml(program.admissionsUrl)}" target="_blank" rel="noreferrer">招生要求页</a>` : ""}
              </div>
            `,
          });
        }
      };

      const setStatus = (text) => {
        if (statusNode) {
          statusNode.textContent = text;
        }
      };

      const patchProgramsWithAdmissionsSnapshots = (items, updatesMap) => {
        if (!Array.isArray(items) || !items.length || !updatesMap.size) {
          return items;
        }

        return items.map((program) =>
          updatesMap.has(program.id)
            ? {
                ...program,
                admissionsSnapshot: updatesMap.get(program.id),
              }
            : program
        );
      };

      const updateAdmissionsStatusNodes = (updatedPrograms) => {
        if (!Array.isArray(updatedPrograms) || !updatedPrograms.length) {
          return;
        }

        updatedPrograms.forEach((item) => {
          const label = admissionsSnapshotStatusLabel(item?.admissionsSnapshot);
          root
            .querySelectorAll(
              `[data-program-admissions-status="${CSS.escape(String(item?.id || ""))}"]`
            )
            .forEach((node) => {
              if (!(node instanceof HTMLElement)) {
                return;
              }

              node.textContent = label;
              node.hidden = !label;
            });
        });
      };

      const refreshAdmissionsSnapshots = (updatedPrograms) => {
        if (!Array.isArray(updatedPrograms) || !updatedPrograms.length) {
          return;
        }

        const updatesMap = new Map(
          updatedPrograms
            .map((item) => [String(item?.id || "").trim(), item?.admissionsSnapshot ?? null])
            .filter(([programId]) => Boolean(programId))
        );

        activeVerifiedResults = patchProgramsWithAdmissionsSnapshots(
          activeVerifiedResults,
          updatesMap
        );
        baseVerifiedResults = patchProgramsWithAdmissionsSnapshots(
          baseVerifiedResults,
          updatesMap
        );

        updateAdmissionsStatusNodes(updatedPrograms);
      };

      const clearAdmissionsPrefetchSchedule = () => {
        if (!admissionsPrefetchTimer) {
          return;
        }

        window.clearTimeout(admissionsPrefetchTimer);
        admissionsPrefetchTimer = 0;
      };

      const clearCandidateExpansion = () => {
        candidateExpansionToken += 1;

        if (candidateExpansionController instanceof AbortController) {
          candidateExpansionController.abort();
        }

        candidateExpansionController = null;
      };

      const runAdmissionsPrefetch = async (items, payload, options = {}) => {
        const currentResults = Array.isArray(items) ? items : [];
        if (!currentResults.length) {
          return;
        }

        const candidates = currentResults
          .filter((program) => !program?.admissionsSnapshot?.extractedAt)
          .slice(0, 4);

        if (!candidates.length) {
          return;
        }

        admissionsPrefetchToken += 1;
        const token = admissionsPrefetchToken;

        try {
          const response = await fetch("/api/study-abroad/prefetch-admissions", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              country: payload?.country || "",
              degree: payload?.degree || "",
              major: payload?.major || "",
              specialization: payload?.specialization || "",
              maxPrograms: candidates.length,
              programIds: candidates.map((program) => program.id),
              waitForCompletion: false,
            }),
          });

          const data = await response.json();
          if (token !== admissionsPrefetchToken) {
            return;
          }

          if (!response.ok || !data?.ok) {
            return;
          }

          const updatedPrograms = Array.isArray(data.updatedPrograms) ? data.updatedPrograms : [];
          if (!updatedPrograms.length) {
            if (!options?.silentStatus && data?.message) {
              setStatus(`${statusNode?.textContent || ""} ${data.message}`.trim());
            }
            return;
          }

          refreshAdmissionsSnapshots(updatedPrograms);

          if (!options?.silentStatus) {
            const noteParts = [];
            if (Number(data.okCount) > 0) {
              noteParts.push(`${data.okCount} 个项目已补齐较完整门槛`);
            }
            if (Number(data.partialCount) > 0) {
              noteParts.push(`${data.partialCount} 个项目补到部分字段`);
            }

            if (noteParts.length) {
              setStatus(`${statusNode?.textContent || ""} 当前已在后台补抓：${noteParts.join("，")}。`.trim());
            }
          }

          if (hasFitPreviewInput(payload)) {
            hydrateFitPreviews(activeVerifiedResults, payload);
          }
        } catch {
          return;
        }
      };

      const scheduleAdmissionsPrefetch = (items, payload, options = {}) => {
        clearAdmissionsPrefetchSchedule();

        admissionsPrefetchTimer = window.setTimeout(() => {
          admissionsPrefetchTimer = 0;
          void runAdmissionsPrefetch(items, payload, options);
        }, 900);
      };

      const runCandidateExpansion = async (payload, statusText) => {
        if (!hasCandidateExpansionInput(payload)) {
          setStatusSummary({
            verifiedCount: Array.isArray(baseVerifiedResults) ? baseVerifiedResults.length : 0,
            universityCount: Number(baseUniversityCount) || 0,
            candidateCount: Array.isArray(baseCandidateResults) ? baseCandidateResults.length : 0,
            blockedCount: 0,
            expansionEnabled: false,
            expansionAttempted: false,
          });
          return;
        }

        clearCandidateExpansion();
        const token = candidateExpansionToken;
        const controller = new AbortController();
        candidateExpansionController = controller;
        setStatus(`${statusText} 正在后台补充候选官网页...`);
        const expansionPayload = {
          ...payload,
          searchSessionId: activeSearchSessionId || "",
        };

        try {
          const response = await fetch("/api/study-abroad/expand-candidates", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            signal: controller.signal,
            body: JSON.stringify(expansionPayload),
          });

          const data = await response.json();
          if (token !== candidateExpansionToken) {
            return;
          }

          if (!response.ok || !data?.ok) {
            throw new Error(data?.message || "候选官网页补充失败。");
          }

          const nextCandidateResults = Array.isArray(data.candidateResults)
            ? data.candidateResults
            : [];
          const nextSearchGuidance =
            data?.searchGuidance && typeof data.searchGuidance === "object"
              ? data.searchGuidance
              : null;
          const nextBlockedCount = Number(data.blockedResultCount) || 0;
          const nextSearchSessionId = String(data.searchSessionId || "").trim();
          if (nextSearchSessionId) {
            activeSearchSessionId = nextSearchSessionId;
          }
          baseCandidateResults = nextCandidateResults;

          if (!selectedUniversityId) {
            renderCandidateResults(nextCandidateResults);
          }

          setStatus(
            data.message ? `${statusText} ${data.message}`.trim() : statusText
          );
          renderSearchQuality(nextSearchGuidance, {
            verifiedCount: Array.isArray(baseVerifiedResults) ? baseVerifiedResults.length : 0,
            universityCount: Number(baseUniversityCount) || 0,
            candidateCount: nextCandidateResults.length,
          });
          setStatusSummary({
            verifiedCount: Array.isArray(baseVerifiedResults) ? baseVerifiedResults.length : 0,
            universityCount: Number(baseUniversityCount) || 0,
            candidateCount: nextCandidateResults.length,
            blockedCount: nextBlockedCount,
            expansionEnabled: Boolean(data.expansionEnabled),
            expansionAttempted: Boolean(data.expansionAttempted),
          });
        } catch (error) {
          if (error?.name === "AbortError" || token !== candidateExpansionToken) {
            return;
          }

          setStatus(statusText);
          setStatusSummary({
            verifiedCount: Array.isArray(baseVerifiedResults) ? baseVerifiedResults.length : 0,
            universityCount: Number(baseUniversityCount) || 0,
            candidateCount: Array.isArray(baseCandidateResults) ? baseCandidateResults.length : 0,
            blockedCount: 0,
            expansionEnabled: true,
            expansionAttempted: true,
          });
        } finally {
          if (candidateExpansionController === controller) {
            candidateExpansionController = null;
          }
        }
      };

      const setBusy = (busy) => {
        const label = busy
          ? selectedUniversityId
            ? "切换学校中..."
            : "搜索中..."
          : "开始搜索";

        if (searchButton instanceof HTMLButtonElement) {
          searchButton.disabled = busy;
          searchButton.textContent = label;
        }

        if (resetButton instanceof HTMLButtonElement) {
          resetButton.disabled = busy;
        }
      };

      const updateSpecializationOptions = (preserveValue = "") => {
        if (!(specializationSelect instanceof HTMLSelectElement)) {
          return;
        }

        const majorValue = majorSelect instanceof HTMLSelectElement ? majorSelect.value : "";
        const nextOptions = Array.isArray(specializationMap[majorValue])
          ? specializationMap[majorValue]
          : [];
        const nextValue = nextOptions.includes(preserveValue) ? preserveValue : "";

        if (!majorValue || !nextOptions.length) {
          specializationSelect.innerHTML = `<option value="">先选专业方向</option>`;
          specializationSelect.disabled = true;
          specializationSelect.value = "";
          return;
        }

        specializationSelect.innerHTML = [
          `<option value="">全部细分方向</option>`,
          ...nextOptions.map(
            (option) =>
              `<option value="${escapeHtml(option)}">${escapeHtml(option)}</option>`
          ),
        ].join("");
        specializationSelect.disabled = false;
        specializationSelect.value = nextValue;
      };

      const collectPayload = () => ({
        freeText: freeTextInput instanceof HTMLInputElement ? freeTextInput.value.trim() : "",
        country: countrySelect instanceof HTMLSelectElement ? countrySelect.value : "",
        degree: degreeSelect instanceof HTMLSelectElement ? degreeSelect.value : "",
        major: majorSelect instanceof HTMLSelectElement ? majorSelect.value : "",
        specialization:
          specializationSelect instanceof HTMLSelectElement
            ? specializationSelect.value
            : "",
        budgetTier: budgetSelect instanceof HTMLSelectElement ? budgetSelect.value : "",
        intake: intakeSelect instanceof HTMLSelectElement ? intakeSelect.value : "",
        gpaProfile: gpaSelect instanceof HTMLSelectElement ? gpaSelect.value : "",
        languageProfile:
          languageSelect instanceof HTMLSelectElement ? languageSelect.value : "",
        fitMode: fitModeSelect instanceof HTMLSelectElement ? fitModeSelect.value : "prefer",
        snapshotQuality:
          snapshotQualitySelect instanceof HTMLSelectElement
            ? snapshotQualitySelect.value
            : "",
      });

      const resetToFeatured = () => {
        admissionsPrefetchToken += 1;
        clearAdmissionsPrefetchSchedule();
        clearCandidateExpansion();
        if (freeTextInput instanceof HTMLInputElement) freeTextInput.value = "";
        if (countrySelect instanceof HTMLSelectElement) countrySelect.value = "";
        if (degreeSelect instanceof HTMLSelectElement) degreeSelect.value = "";
        if (majorSelect instanceof HTMLSelectElement) majorSelect.value = "";
        if (budgetSelect instanceof HTMLSelectElement) budgetSelect.value = "";
        if (intakeSelect instanceof HTMLSelectElement) intakeSelect.value = "";
        if (gpaSelect instanceof HTMLSelectElement) gpaSelect.value = "";
        if (languageSelect instanceof HTMLSelectElement) languageSelect.value = "";
        if (fitModeSelect instanceof HTMLSelectElement) fitModeSelect.value = "prefer";
        if (snapshotQualitySelect instanceof HTMLSelectElement) {
          snapshotQualitySelect.value = "";
        }
        updateSpecializationOptions("");
        resetSchoolRefiners();
        activeSearchSessionId = "";
        activeSearchPayload = {
          ...lastBasePayload,
        };
        selectedUniversityId = "";
        activeDetailProgramId = "";
        activeVerifiedResults = initialResults;
        activeUniversityCount = seedUniversityMatches.length;
        visibleSchoolCount = initialSchoolBatchSize;
        baseVerifiedResults = initialResults;
        baseUniversityMatches = seedUniversityMatches;
        baseUniversityCount = seedUniversityMatches.length;
        baseCandidateResults = [];
        baseStatusText =
          `当前底库共有 ${totalProgramCount} 个项目，当前展示 ${initialResults.length} 个优先样例。先选学位类型、专业方向、细分方向和学生背景，再点击“开始搜索”获取已核验结果。`;
        lastBasePayload = {
          freeText: "",
          country: "",
          major: "",
          specialization: "",
          degree: "",
          budgetTier: "",
          intake: "",
          gpaProfile: "",
          languageProfile: "",
          fitMode: "prefer",
          snapshotQuality: "",
        };
        lastEmptyText =
          "可以先放宽国家条件，或者改选更宽的专业方向，比如从“商业分析 / 数据”切到“商科 / 管理”。";
        setStatusSummary({
          verifiedCount: initialResults.length,
          universityCount: seedUniversityMatches.length,
          candidateCount: 0,
          blockedCount: 0,
          expansionEnabled: false,
          expansionAttempted: false,
        });

        setStatus(baseStatusText);
        renderVerifiedResults(initialResults);
        renderUniversityMatches(seedUniversityMatches, seedUniversityMatches.length, "");
        renderCandidateResults([]);
        hideExpansionSuggestion();
        hideIntentExplanation();
        hideSearchQuality();
        fitPreviewToken += 1;
        clearFitPreviews();
        hideDetailPanel();
        hideSchoolSummary();
      };

      const runSearch = async (overridePayload = {}, options = {}) => {
        admissionsPrefetchToken += 1;
        clearAdmissionsPrefetchSchedule();
        clearCandidateExpansion();
        const payload = {
          ...collectPayload(),
          ...overridePayload,
        };
        const fromSchoolFilter = Boolean(options?.fromSchoolFilter);

        if (
          !payload.freeText &&
          !payload.country &&
          !payload.major &&
          !payload.specialization &&
          !payload.degree &&
          !payload.budgetTier &&
          !payload.intake &&
          !payload.universityId
        ) {
          resetToFeatured();
          return;
        }

        setBusy(true);
        setStatus(
          fromSchoolFilter
            ? "正在切换学校并缩小项目范围..."
            : "正在搜索已核验项目..."
        );

        try {
          const response = await fetch("/api/study-abroad/search", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const data = await response.json();

          if (!response.ok || !data?.ok) {
            throw new Error(data?.message || "搜索失败");
          }

          const nextVerifiedResults = Array.isArray(data.verifiedResults) ? data.verifiedResults : [];
          const nextUniversityMatches = Array.isArray(data.universityMatches)
            ? data.universityMatches
            : [];
          const nextUniversityCount =
            Number(data.totalUniversityCount) || nextUniversityMatches.length;
          const nextCandidateResults = Array.isArray(data.candidateResults)
            ? data.candidateResults
            : [];
          const nextStatus =
            data.message ||
            `已找到 ${Array.isArray(data.verifiedResults) ? data.verifiedResults.length : 0} 条结果。`;
          const resolvedQuery =
            data?.resolvedQuery && typeof data.resolvedQuery === "object"
              ? data.resolvedQuery
              : payload;
          const nextSearchGuidance =
            data?.searchGuidance && typeof data.searchGuidance === "object"
              ? data.searchGuidance
              : null;
          const nextSearchSessionId = String(data.searchSessionId || "").trim();
          const nextBlockedCount = Number(data.blockedResultCount) || 0;

          activeDetailProgramId = "";
          lastEmptyText =
            String(nextSearchGuidance?.failureReason || "").trim() ||
            (nextCandidateResults.length
              ? "当前没有找到完全匹配的已核验项目，可以先参考下方全网候选官网页。"
              : "当前没有找到完全匹配的已核验项目。建议先放宽国家或专业方向。");

          if (fromSchoolFilter) {
            activeSearchPayload = {
              ...resolvedQuery,
            };
            applyResolvedQueryToControls(resolvedQuery);
            renderIntentExplanation(resolvedQuery);
            renderSearchQuality(nextSearchGuidance, {
              verifiedCount: nextVerifiedResults.length,
              universityCount: 1,
              candidateCount: 0,
            });
            selectedUniversityId = String(payload.universityId || "");
            activeVerifiedResults = nextVerifiedResults;
            const selectedSchool =
              baseUniversityMatches.find((item) => item.universityId === selectedUniversityId) || null;
            setStatus(
              nextVerifiedResults.length
                ? `已切换到当前学校，找到 ${nextVerifiedResults.length} 个项目。`
                : "这所学校已经进入学校底库，但项目层还在继续补充。可以切回全部院校，或继续缩小专业方向。"
            );
            renderVerifiedResults(activeVerifiedResults, lastEmptyText);
            hydrateFitPreviews(activeVerifiedResults, payload);
            renderUniversityMatches(baseUniversityMatches, baseUniversityCount, selectedUniversityId);
            renderCandidateResults([]);
            hideExpansionSuggestion();
            setStatusSummary({
              verifiedCount: nextVerifiedResults.length,
              universityCount: 1,
              candidateCount: 0,
              blockedCount: nextBlockedCount,
              expansionEnabled: Boolean(data.expansionEnabled),
              expansionAttempted: false,
            });
            hideDetailPanel();
            renderSchoolSummary(selectedSchool);
            scheduleAdmissionsPrefetch(activeVerifiedResults, payload, {
              silentStatus: true,
            });
            return;
          }

          activeSearchSessionId = nextSearchSessionId;
          selectedUniversityId = "";
          resetSchoolRefiners();
          applyResolvedQueryToControls(resolvedQuery);
          activeVerifiedResults = nextVerifiedResults;
          activeUniversityCount = nextUniversityCount;
          visibleSchoolCount = initialSchoolBatchSize;
          baseVerifiedResults = nextVerifiedResults;
          baseUniversityMatches = nextUniversityMatches;
          baseUniversityCount = nextUniversityCount;
          baseCandidateResults = nextCandidateResults;
          baseStatusText = nextStatus;
          lastBasePayload = {
            freeText: resolvedQuery.freeText || "",
            country: resolvedQuery.country || "",
            major: resolvedQuery.major || "",
            specialization: resolvedQuery.specialization || "",
            degree: resolvedQuery.degree || "",
            budgetTier: resolvedQuery.budgetTier || "",
            intake: resolvedQuery.intake || "",
            gpaProfile: resolvedQuery.gpaProfile || "",
            languageProfile: resolvedQuery.languageProfile || "",
            fitMode: resolvedQuery.fitMode || "prefer",
            snapshotQuality: resolvedQuery.snapshotQuality || "",
          };
          activeSearchPayload = {
            ...lastBasePayload,
          };

          setStatus(baseStatusText);
          renderVerifiedResults(baseVerifiedResults, lastEmptyText);
          hydrateFitPreviews(baseVerifiedResults, lastBasePayload);
          renderUniversityMatches(baseUniversityMatches, baseUniversityCount, "");
          renderCandidateResults(baseCandidateResults);
          renderExpansionSuggestion(lastBasePayload, {
            verifiedCount: nextVerifiedResults.length,
            universityCount: nextUniversityCount,
            candidateCount: nextCandidateResults.length,
          });
          renderIntentExplanation(lastBasePayload);
          renderSearchQuality(nextSearchGuidance, {
            verifiedCount: nextVerifiedResults.length,
            universityCount: nextUniversityCount,
            candidateCount: nextCandidateResults.length,
          });
          setStatusSummary({
            verifiedCount: nextVerifiedResults.length,
            universityCount: nextUniversityCount,
            candidateCount: nextCandidateResults.length,
            blockedCount: nextBlockedCount,
            expansionEnabled: Boolean(data.expansionEnabled),
            expansionAttempted: Boolean(data.expansionAttempted),
          });
          hideDetailPanel();
          hideSchoolSummary();
          scheduleAdmissionsPrefetch(baseVerifiedResults, lastBasePayload);
          void runCandidateExpansion(lastBasePayload, baseStatusText);
        } catch (error) {
          activeSearchSessionId = "";
          setStatus(error instanceof Error ? error.message : "搜索失败，请稍后重试。");
          renderVerifiedResults([], "接口暂时不可用，请稍后重试。");
          renderUniversityMatches([], 0, "");
          renderCandidateResults([]);
          hideExpansionSuggestion();
          hideIntentExplanation();
          hideSearchQuality();
          setStatusSummary({
            verifiedCount: 0,
            universityCount: 0,
            candidateCount: 0,
            blockedCount: 0,
            expansionEnabled: false,
            expansionAttempted: false,
          });
          fitPreviewToken += 1;
          admissionsPrefetchToken += 1;
          clearFitPreviews();
          hideDetailPanel();
          hideSchoolSummary();
        } finally {
          setBusy(false);
        }
      };

      const rerunWithIntentPayload = (nextPayload = {}) => {
        selectedUniversityId = "";
        hideDetailPanel();
        hideSchoolSummary();
        return runSearch({
          ...collectPayload(),
          ...nextPayload,
          universityId: "",
        });
      };

      const handleGuidanceAction = (target) => {
        const actionType = target.getAttribute("data-intent-action");
        if (!actionType) {
          return false;
        }

        if (actionType === "clear-specialization") {
          const currentPayload = collectPayload();
          void rerunWithIntentPayload({
            ...currentPayload,
            specialization: buildIntentRemovalValue("specialization", currentPayload),
          });
          return true;
        }

        if (actionType === "clear-free-text") {
          void rerunWithIntentPayload({
            ...collectPayload(),
            freeText: "",
          });
          return true;
        }

        if (actionType === "expand-major") {
          const currentPayload = collectPayload();
          const targetMajor = String(target.getAttribute("data-intent-value") || "").trim();
          if (!targetMajor) {
            return true;
          }

          void rerunWithIntentPayload({
            ...currentPayload,
            major: targetMajor,
            specialization: buildIntentRemovalValue("specialization", currentPayload),
          });
          return true;
        }

        if (actionType === "relax-search") {
          const currentPayload = collectPayload();
          void rerunWithIntentPayload({
            ...currentPayload,
            specialization: buildIntentRemovalValue("specialization", currentPayload),
            budgetTier: "",
            intake: "",
            gpaProfile: "",
            languageProfile: "",
            fitMode: "prefer",
            snapshotQuality: "",
          });
          return true;
        }

        if (actionType === "country-degree-only") {
          const currentPayload = collectPayload();
          void rerunWithIntentPayload({
            ...currentPayload,
            major: buildIntentRemovalValue("major", currentPayload),
            specialization: buildIntentRemovalValue("specialization", currentPayload),
            budgetTier: "",
            intake: "",
            gpaProfile: "",
            languageProfile: "",
            fitMode: "prefer",
            snapshotQuality: "",
          });
          return true;
        }

        return false;
      };

      const applySchoolRefiners = () => {
        selectedUniversityId = "";
        activeVerifiedResults = baseVerifiedResults;
        setStatus(
          hasActiveSchoolRefiners()
            ? `${baseStatusText} 当前已按学校名、排名、学费或项目状态做二次筛选。`
            : baseStatusText
        );
        renderUniversityMatches(baseUniversityMatches, baseUniversityCount, "");
        renderVerifiedResults(baseVerifiedResults, lastEmptyText);
        hydrateFitPreviews(baseVerifiedResults, lastBasePayload);
        renderCandidateResults(baseCandidateResults);
        renderExpansionSuggestion(lastBasePayload, {
          verifiedCount: baseVerifiedResults.length,
          universityCount: baseUniversityCount,
          candidateCount: baseCandidateResults.length,
        });
        hideDetailPanel();
        hideSchoolSummary();
      };

      if (searchButton instanceof HTMLButtonElement) {
        searchButton.addEventListener("click", runSearch);
      }

      if (majorSelect instanceof HTMLSelectElement) {
        majorSelect.addEventListener("change", () => {
          updateSpecializationOptions("");
        });
      }

      if (resetButton instanceof HTMLButtonElement) {
        resetButton.addEventListener("click", resetToFeatured);
      }

      if (intentPanel instanceof HTMLElement) {
        intentPanel.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target.closest("button") : null;

          if (!(target instanceof HTMLElement)) {
            return;
          }

          const removeKey = target.getAttribute("data-intent-remove");
          if (removeKey) {
            const currentPayload = collectPayload();
            const nextPayload = {
              ...currentPayload,
              [removeKey]: buildIntentRemovalValue(removeKey, currentPayload),
            };

            if (removeKey === "major") {
              nextPayload.specialization = buildIntentRemovalValue("specialization", currentPayload);
            }

            void rerunWithIntentPayload(nextPayload);
            return;
          }

          handleGuidanceAction(target);
        });
      }

      if (expansionPanel instanceof HTMLElement) {
        expansionPanel.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target.closest("button") : null;
          if (!(target instanceof HTMLElement)) {
            return;
          }

          handleGuidanceAction(target);
        });
      }

      if (schoolKeywordInput instanceof HTMLInputElement) {
        schoolKeywordInput.addEventListener("input", applySchoolRefiners);
      }

      if (schoolRankSelect instanceof HTMLSelectElement) {
        schoolRankSelect.addEventListener("change", applySchoolRefiners);
      }

      if (schoolTuitionSelect instanceof HTMLSelectElement) {
        schoolTuitionSelect.addEventListener("change", applySchoolRefiners);
      }

      if (schoolAvailabilitySelect instanceof HTMLSelectElement) {
        schoolAvailabilitySelect.addEventListener("change", applySchoolRefiners);
      }

      if (verifiedResultsNode instanceof HTMLElement) {
        verifiedResultsNode.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target.closest("button") : null;

          if (!(target instanceof HTMLElement)) {
            return;
          }

          const favoriteProgramId = target.getAttribute("data-program-favorite-button") || "";
          if (favoriteProgramId) {
            const program = programCardLookup(favoriteProgramId);
            if (program) {
              toggleProgramFavorite(program);
            }
            return;
          }

          const compareProgramId = target.getAttribute("data-program-compare-button") || "";
          if (compareProgramId) {
            const program = programCardLookup(compareProgramId);
            if (program) {
              toggleCompareProgram(program);
            }
            return;
          }

          const detailProgramId = target.getAttribute("data-program-detail-button") || "";
          if (!detailProgramId) {
            return;
          }

          openProgramDetails(detailProgramId);
        });
      }

      if (schoolsResultsNode instanceof HTMLElement) {
        schoolsResultsNode.addEventListener("click", (event) => {
          const target = event.target instanceof Element
            ? event.target.closest("[data-university-id]")
            : null;

          if (!(target instanceof HTMLElement)) {
            return;
          }

          const nextUniversityId = target.getAttribute("data-university-id") || "";
          selectedUniversityId = nextUniversityId;

          if (!nextUniversityId) {
            activeVerifiedResults = baseVerifiedResults;
            selectedUniversityId = "";
            setStatus(baseStatusText);
            renderUniversityMatches(baseUniversityMatches, baseUniversityCount, "");
            renderVerifiedResults(baseVerifiedResults, lastEmptyText);
            hydrateFitPreviews(baseVerifiedResults, lastBasePayload);
            renderCandidateResults(baseCandidateResults);
            renderExpansionSuggestion(lastBasePayload, {
              verifiedCount: baseVerifiedResults.length,
              universityCount: baseUniversityCount,
              candidateCount: baseCandidateResults.length,
            });
            hideDetailPanel();
            hideSchoolSummary();
            return;
          }

          const selectedSchool =
            baseUniversityMatches.find((item) => item.universityId === nextUniversityId) || null;
          renderUniversityMatches(baseUniversityMatches, baseUniversityCount, selectedUniversityId);
          renderSchoolSummary(selectedSchool);
          runSearch(
            {
              ...lastBasePayload,
              universityId: nextUniversityId,
            },
            { fromSchoolFilter: true }
          );
        });
      }

      if (schoolsMoreButton instanceof HTMLButtonElement) {
        schoolsMoreButton.addEventListener("click", () => {
          visibleSchoolCount += initialSchoolBatchSize;
          renderUniversityMatches(baseUniversityMatches, baseUniversityCount, selectedUniversityId);
        });
      }

      if (detailCloseButton instanceof HTMLButtonElement) {
        detailCloseButton.addEventListener("click", hideDetailPanel);
      }

      if (schoolSummaryFavoriteButton instanceof HTMLButtonElement) {
        schoolSummaryFavoriteButton.addEventListener("click", () => {
          if (selectedSchoolSummary) {
            toggleSchoolFavorite(selectedSchoolSummary);
          }
        });
      }

      if (saveSearchButton instanceof HTMLButtonElement) {
        saveSearchButton.addEventListener("click", saveCurrentSearch);
      }

      if (exportCsvButton instanceof HTMLButtonElement) {
        exportCsvButton.addEventListener("click", exportCurrentResultsAsCsv);
      }

      if (exportJsonButton instanceof HTMLButtonElement) {
        exportJsonButton.addEventListener("click", exportCurrentResultsAsJson);
      }

      if (generateSummaryButton instanceof HTMLButtonElement) {
        generateSummaryButton.addEventListener("click", () => {
          renderConsultSummary();
          setStatus("咨询摘要已生成，你可以直接复制给顾问。");
        });
      }

      if (copySummaryButton instanceof HTMLButtonElement) {
        copySummaryButton.addEventListener("click", () => {
          void copyConsultSummary();
        });
      }

      if (downloadSummaryButton instanceof HTMLButtonElement) {
        downloadSummaryButton.addEventListener("click", downloadConsultSummary);
      }

      if (handoffContactButton instanceof HTMLButtonElement) {
        handoffContactButton.addEventListener("click", handoffConsultSummaryToContactForm);
      }

      if (clearFavoriteSchoolsButton instanceof HTMLButtonElement) {
        clearFavoriteSchoolsButton.addEventListener("click", () => clearUtilityCollection("schools"));
      }

      if (clearFavoriteProgramsButton instanceof HTMLButtonElement) {
        clearFavoriteProgramsButton.addEventListener("click", () => clearUtilityCollection("programs"));
      }

      if (clearSavedSearchesButton instanceof HTMLButtonElement) {
        clearSavedSearchesButton.addEventListener("click", () => clearUtilityCollection("saved-searches"));
      }

      if (clearCompareButton instanceof HTMLButtonElement) {
        clearCompareButton.addEventListener("click", () => clearUtilityCollection("compare"));
      }

      if (utilitySection instanceof HTMLElement) {
        utilitySection.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target.closest("button") : null;
          if (!(target instanceof HTMLElement)) {
            return;
          }

          const action = target.getAttribute("data-toolbox-action");
          if (!action) {
            return;
          }

          if (action === "remove-school-favorite") {
            const universityId = target.getAttribute("data-university-id") || "";
            favoriteSchools = favoriteSchools.filter((item) => item.universityId !== universityId);
            persistFavorites();
            renderToolboxLists();
            syncUtilityActionStates();
            setStatus("已移除收藏学校。");
            return;
          }

          if (action === "remove-program-favorite") {
            const programId = target.getAttribute("data-program-id") || "";
            favoritePrograms = favoritePrograms.filter((item) => item.id !== programId);
            persistFavorites();
            renderToolboxLists();
            syncUtilityActionStates();
            setStatus("已移除收藏项目。");
            return;
          }

          if (action === "remove-saved-search") {
            const savedSearchId = target.getAttribute("data-saved-search-id") || "";
            savedSearches = savedSearches.filter((item) => item.id !== savedSearchId);
            persistSavedSearches();
            renderToolboxLists();
            setStatus("已删除这条已保存搜索。");
            return;
          }

          if (action === "apply-saved-search") {
            const savedSearchId = target.getAttribute("data-saved-search-id") || "";
            applySavedSearch(savedSearchId);
            return;
          }

          if (action === "toggle-compare") {
            const programId = target.getAttribute("data-program-id") || "";
            const program = programCardLookup(programId);
            if (program) {
              toggleCompareProgram(program);
            }
          }
        });
      }

      renderUniversityMatches(seedUniversityMatches, seedUniversityMatches.length, "");
      updateSpecializationOptions("");
      clearFitPreviews();
      loadUtilityState();
      syncUtilityActionStates();
      });
    })();
  </script>
</section>
