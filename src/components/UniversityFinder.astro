---
import {
  POPULAR_MAJOR_HINTS,
  STUDY_ABROAD_COUNTRIES,
  STUDY_ABROAD_DATA_UPDATED_AT,
  STUDY_ABROAD_PROGRAMS,
  type StudyAbroadProgram,
} from "../lib/study-abroad-programs";

type Props = {
  anchorId?: string;
  compact?: boolean;
};

const { anchorId = "school-match", compact = false } = Astro.props as Props;

const finderId = `school-match-${Math.random().toString(36).slice(2, 10)}`;
const initialResults = STUDY_ABROAD_PROGRAMS.slice(0, compact ? 4 : 6);

const sameLink = (program: StudyAbroadProgram) =>
  Boolean(program.admissionsUrl) && program.admissionsUrl === program.overviewUrl;
---

<section
  class:list={["school-match", compact && "school-match--compact"]}
  id={anchorId}
  data-school-match={finderId}
>
  <div class="school-match-head">
    <div>
      <div class="section-kicker">Official School Finder</div>
      <h3 class="school-match-title">先填条件，再点击开始搜索</h3>
      <p class="school-match-desc">
        搜索会优先返回已核验的官方项目；如果结果不够，系统会把候选官网页送进后台审核，不直接把未核验页面推给学生。
      </p>
    </div>

    <div class="school-match-source">
      <strong>数据说明</strong>
      <p>
        当前为精选官方项目库，覆盖美英加澳、中国香港和新加坡的热门方向。项目链接均来自院校官网，最近核对日期
        {STUDY_ABROAD_DATA_UPDATED_AT}。
      </p>
    </div>
  </div>

  <div class="school-match-controls">
    <label class="school-match-field">
      <span>意向国家</span>
      <select data-role="country">
        <option value="">全部国家 / 地区</option>
        {STUDY_ABROAD_COUNTRIES.map((country) => (
          <option value={country}>{country}</option>
        ))}
      </select>
    </label>

    <label class="school-match-field">
      <span>意向专业</span>
      <input
        data-role="major"
        type="text"
        inputmode="search"
        placeholder="例如 计算机、金融、市场营销、教育、商业分析"
      />
    </label>

    <label class="school-match-field">
      <span>学位类型</span>
      <select data-role="degree">
        <option value="">全部</option>
        <option value="硕士">硕士</option>
        <option value="MBA">MBA</option>
      </select>
    </label>
  </div>

  <div class="school-match-hints">
    <span>热门方向</span>
    <div class="school-match-chip-row">
      {POPULAR_MAJOR_HINTS.map((hint) => (
        <button class="school-match-chip" type="button" data-major-hint={hint}>
          {hint}
        </button>
      ))}
    </div>
  </div>

  <div class="school-match-toolbar">
    <button class="btn" type="button" data-role="search-button">
      开始搜索
    </button>
    <button class="btn btn-ghost" type="button" data-role="reset-button">
      恢复精选
    </button>
  </div>

  <div class="school-match-status" data-role="status">
    当前展示 {initialResults.length} 个精选项目。填好国家和专业后，点击“开始搜索”获取已核验结果。
  </div>

  <div class="school-match-results" data-role="results">
    {initialResults.map((program) => (
      <article class="school-card">
        <div class="school-card-top">
          <div>
            <div class="school-card-meta">
              <span>{program.country}</span>
              <span>{program.city}</span>
              <span>{program.degree}</span>
            </div>
            <h4>{program.schoolName}</h4>
            <p class="school-card-program">{program.programName}</p>
          </div>
          <div class="school-card-discipline">{program.discipline}</div>
        </div>

        <p class="school-card-summary">{program.summary}</p>

        <div class="school-card-tags">
          {program.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>

        <div class="school-card-facts">
          {program.duration ? <span>学制：{program.duration}</span> : null}
          {program.intake ? <span>入学：{program.intake}</span> : null}
          <span>核对：{program.checkedAt}</span>
        </div>

        <div class="school-card-actions">
          <a href={program.overviewUrl} target="_blank" rel="noreferrer">
            招生简介
          </a>
          {!sameLink(program) && program.admissionsUrl ? (
            <a href={program.admissionsUrl} target="_blank" rel="noreferrer">
              申请要求
            </a>
          ) : null}
        </div>
      </article>
    ))}
  </div>

  <script type="application/json" id={`${finderId}-data`}>
    {JSON.stringify(initialResults)}
  </script>

  <script is:inline define:vars={{ finderId }}>
    const root = document.querySelector(`[data-school-match="${finderId}"]`);
    const dataNode = document.getElementById(`${finderId}-data`);

    if (root && dataNode) {
      const initialResults = JSON.parse(dataNode.textContent || "[]");
      const countrySelect = root.querySelector('[data-role="country"]');
      const majorInput = root.querySelector('[data-role="major"]');
      const degreeSelect = root.querySelector('[data-role="degree"]');
      const searchButton = root.querySelector('[data-role="search-button"]');
      const resetButton = root.querySelector('[data-role="reset-button"]');
      const statusNode = root.querySelector('[data-role="status"]');
      const resultsNode = root.querySelector('[data-role="results"]');
      const hintButtons = Array.from(root.querySelectorAll("[data-major-hint]"));

      const escapeHtml = (value) =>
        String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");

      const cardHtml = (program) => {
        const facts = [
          program.duration ? `<span>学制：${escapeHtml(program.duration)}</span>` : "",
          program.intake ? `<span>入学：${escapeHtml(program.intake)}</span>` : "",
          `<span>核对：${escapeHtml(program.checkedAt)}</span>`,
        ]
          .filter(Boolean)
          .join("");

        const admissionsLink =
          program.admissionsUrl && program.admissionsUrl !== program.overviewUrl
            ? `<a href="${escapeHtml(program.admissionsUrl)}" target="_blank" rel="noreferrer">申请要求</a>`
            : "";

        return `
          <article class="school-card">
            <div class="school-card-top">
              <div>
                <div class="school-card-meta">
                  <span>${escapeHtml(program.country)}</span>
                  <span>${escapeHtml(program.city)}</span>
                  <span>${escapeHtml(program.degree)}</span>
                </div>
                <h4>${escapeHtml(program.schoolName)}</h4>
                <p class="school-card-program">${escapeHtml(program.programName)}</p>
              </div>
              <div class="school-card-discipline">${escapeHtml(program.discipline)}</div>
            </div>

            <p class="school-card-summary">${escapeHtml(program.summary)}</p>

            <div class="school-card-tags">
              ${(program.tags || []).map((tag) => `<span>${escapeHtml(tag)}</span>`).join("")}
            </div>

            <div class="school-card-facts">${facts}</div>

            <div class="school-card-actions">
              <a href="${escapeHtml(program.overviewUrl)}" target="_blank" rel="noreferrer">招生简介</a>
              ${admissionsLink}
            </div>
          </article>
        `;
      };

      const renderResults = (items, emptyText) => {
        if (!resultsNode) {
          return;
        }

        if (!Array.isArray(items) || !items.length) {
          resultsNode.innerHTML = `
            <div class="school-match-empty">
              <strong>这轮没有筛到合适结果</strong>
              <p>${escapeHtml(
                emptyText ||
                  "可以先缩短国家条件，或者把专业从“量化金融”“人机交互”放宽到“金融”“计算机 / AI”。"
              )}</p>
            </div>
          `;
          return;
        }

        resultsNode.innerHTML = items.map(cardHtml).join("");
      };

      const setStatus = (text) => {
        if (statusNode) {
          statusNode.textContent = text;
        }
      };

      const setBusy = (busy) => {
        const label = busy ? "搜索中..." : "开始搜索";

        if (searchButton instanceof HTMLButtonElement) {
          searchButton.disabled = busy;
          searchButton.textContent = label;
        }

        if (resetButton instanceof HTMLButtonElement) {
          resetButton.disabled = busy;
        }
      };

      const collectPayload = () => ({
        country: countrySelect instanceof HTMLSelectElement ? countrySelect.value : "",
        major: majorInput instanceof HTMLInputElement ? majorInput.value.trim() : "",
        degree: degreeSelect instanceof HTMLSelectElement ? degreeSelect.value : "",
      });

      const resetToFeatured = () => {
        if (countrySelect instanceof HTMLSelectElement) countrySelect.value = "";
        if (majorInput instanceof HTMLInputElement) majorInput.value = "";
        if (degreeSelect instanceof HTMLSelectElement) degreeSelect.value = "";

        setStatus(
          `当前展示 ${initialResults.length} 个精选项目。填好国家和专业后，点击“开始搜索”获取已核验结果。`
        );
        renderResults(initialResults);
      };

      const runSearch = async () => {
        const payload = collectPayload();

        if (!payload.country && !payload.major && !payload.degree) {
          resetToFeatured();
          return;
        }

        setBusy(true);
        setStatus("正在搜索已核验项目，并评估是否需要补充官网候选结果...");

        try {
          const response = await fetch("/api/study-abroad/search", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const data = await response.json();

          if (!response.ok || !data?.ok) {
            throw new Error(data?.message || "搜索失败");
          }

          setStatus(
            data.message || `已找到 ${Array.isArray(data.verifiedResults) ? data.verifiedResults.length : 0} 条结果。`
          );
          renderResults(
            Array.isArray(data.verifiedResults) ? data.verifiedResults : [],
            "当前没有找到完全匹配的已核验项目。建议先放宽国家或专业方向。"
          );
        } catch (error) {
          setStatus(error instanceof Error ? error.message : "搜索失败，请稍后重试。");
          renderResults([], "接口暂时不可用，请稍后重试。");
        } finally {
          setBusy(false);
        }
      };

      if (searchButton instanceof HTMLButtonElement) {
        searchButton.addEventListener("click", runSearch);
      }

      if (resetButton instanceof HTMLButtonElement) {
        resetButton.addEventListener("click", resetToFeatured);
      }

      if (majorInput instanceof HTMLInputElement) {
        majorInput.addEventListener("keydown", (event) => {
          if (event.key === "Enter") {
            event.preventDefault();
            runSearch();
          }
        });
      }

      hintButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const hint = button.getAttribute("data-major-hint");

          if (!(majorInput instanceof HTMLInputElement) || !hint) {
            return;
          }

          majorInput.value = hint;
          majorInput.focus();
        });
      });
    }
  </script>
</section>
