      let lastBasePayload = {
        freeText: "",
        country: "",
        major: "",
        specialization: "",
        degree: "",
        budgetTier: "",
        intake: "",
        gpaProfile: "",
        languageProfile: "",
        fitMode: "prefer",
        snapshotQuality: "",
      };
      let activeSearchPayload = {
        ...lastBasePayload,
      };
      let activeSearchSessionId = "";
