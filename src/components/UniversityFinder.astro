---
import {
  STUDY_ABROAD_MAJOR_GROUPS,
  STUDY_ABROAD_MAJOR_EXPANSIONS,
  STUDY_ABROAD_MAJOR_SPECIALIZATIONS,
  STUDY_ABROAD_DATA_UPDATED_AT,
  STUDY_ABROAD_PROGRAMS,
} from "../lib/study-abroad-programs";
import {
  readStudyAbroadFinderCountries,
  type StudyAbroadFinderProgram,
} from "../lib/study-abroad-catalog-store";
import { getStudyAbroadUniversityNameZh } from "../lib/study-abroad-university-names";

type Props = {
  anchorId?: string;
  compact?: boolean;
  totalPrograms?: number;
};

const { anchorId = "school-match", compact = false, totalPrograms = 0 } = Astro.props as Props;

const countryOptions: string[] = await readStudyAbroadFinderCountries();
const finderId = `school-match-${Math.random().toString(36).slice(2, 10)}`;

const safeOrigin = (input: string) => {
  try {
    return new URL(input).origin;
  } catch {
    return "";
  }
};

const safeHost = (input: string) => {
  try {
    return new URL(input).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
};

const buildSeedFinderPrograms = (limit: number): StudyAbroadFinderProgram[] =>
  STUDY_ABROAD_PROGRAMS.slice(0, limit).map((program) => ({
    id: program.id,
    universityId: `${program.country}-${program.schoolName}`
      .toLowerCase()
      .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
      .replace(/^-+|-+$/g, ""),
    schoolName: program.schoolName,
    schoolNameZh: getStudyAbroadUniversityNameZh(program.schoolName),
    country: program.country,
    city: program.city,
    stateOrProvince: "",
    programName: program.programName,
    degree: program.degree,
    discipline: program.discipline,
    summary: program.summary,
    duration: program.duration,
    intake: program.intake,
    tuitionAmount: "",
    tuitionCurrency: "",
    tuitionNotes: "",
    overviewUrl: program.overviewUrl,
    admissionsUrl: program.admissionsUrl,
    tuitionUrl: "",
    keywords: program.keywords,
    tags: program.tags,
    sourceIds: ["curated-manual"],
    checkedAt: program.checkedAt,
    priority: program.priority,
    officialWebsite: safeOrigin(program.overviewUrl),
    websiteDomain: safeHost(program.overviewUrl),
    qsRank: null,
    qsRankingYear: null,
    rankingSource: "",
    admissionsSnapshot: null,
  }));

const initialResults = buildSeedFinderPrograms(compact ? 4 : 6);
const seedResults = initialResults;
const latestCheckedAt =
  initialResults.reduce(
    (latest, program) => (program.checkedAt > latest ? program.checkedAt : latest),
    ""
  ) || STUDY_ABROAD_DATA_UPDATED_AT;

const sameLink = (program: StudyAbroadFinderProgram) =>
  Boolean(program.admissionsUrl) && program.admissionsUrl === program.overviewUrl;

const locationLabel = (program: Pick<StudyAbroadFinderProgram, "city" | "stateOrProvince">) =>
  [program.city, program.stateOrProvince].filter(Boolean).join(", ");

const tuitionLabel = (
  program: Pick<StudyAbroadFinderProgram, "tuitionAmount" | "tuitionCurrency">
) => {
  if (!program.tuitionAmount) return "";

  const rawValue = Number(program.tuitionAmount);
  const amount = Number.isFinite(rawValue)
    ? new Intl.NumberFormat("en-US").format(rawValue)
    : program.tuitionAmount;

  return program.tuitionCurrency
    ? `学费：${program.tuitionCurrency} ${amount}`
    : `学费：${amount}`;
};

const rankingLabel = (
  program: Pick<StudyAbroadFinderProgram, "qsRank" | "qsRankingYear">
) => {
  if (!program.qsRank || program.qsRank <= 0) return "";
  return program.qsRankingYear
    ? `QS ${program.qsRankingYear}：#${program.qsRank}`
    : `QS：#${program.qsRank}`;
};

const admissionsSnapshotLabel = (
  program: Pick<StudyAbroadFinderProgram, "admissionsSnapshot">
) => {
  const status = program.admissionsSnapshot?.extractionStatus;
  if (status === "ok") return "门槛：已入库";
  if (status === "partial") return "门槛：部分字段";
  if (status === "unavailable") return "门槛：待补抓";
  return "";
};

const buildUniversityMatches = (programs: StudyAbroadFinderProgram[]) => {
  const map = new Map<
    string,
    {
      universityId: string;
      schoolName: string;
      schoolNameZh: string;
      country: string;
      city: string;
      stateOrProvince: string;
      qsRank: number | null;
      qsRankingYear: number | null;
      programCount: number;
      topDisciplines: string[];
      featuredPrograms: string[];
      tuitionProjectCount: number;
      tuitionMin: number | null;
      tuitionMax: number | null;
      tuitionCurrency: string;
    }
  >();

  programs.forEach((program) => {
    const key = program.universityId || program.schoolName;
    const current = map.get(key);

    if (!current) {
      map.set(key, {
        universityId: key,
        schoolName: program.schoolName,
        schoolNameZh: program.schoolNameZh || "",
        country: program.country,
        city: program.city,
        stateOrProvince: program.stateOrProvince,
        qsRank: program.qsRank ?? null,
        qsRankingYear: program.qsRankingYear ?? null,
        programCount: 1,
        topDisciplines: [program.discipline].filter(Boolean),
        featuredPrograms: [program.programName].filter(Boolean),
        tuitionProjectCount:
          Number.isFinite(Number(program.tuitionAmount)) && Number(program.tuitionAmount) > 0 ? 1 : 0,
        tuitionMin:
          Number.isFinite(Number(program.tuitionAmount)) && Number(program.tuitionAmount) > 0
            ? Number(program.tuitionAmount)
            : null,
        tuitionMax:
          Number.isFinite(Number(program.tuitionAmount)) && Number(program.tuitionAmount) > 0
            ? Number(program.tuitionAmount)
            : null,
        tuitionCurrency:
          Number.isFinite(Number(program.tuitionAmount)) && Number(program.tuitionAmount) > 0
            ? program.tuitionCurrency || ""
            : "",
      });
      return;
    }

    current.programCount += 1;

    if ((!current.qsRank || current.qsRank <= 0) && program.qsRank && program.qsRank > 0) {
      current.qsRank = program.qsRank;
      current.qsRankingYear = program.qsRankingYear;
    }

    if (program.discipline && !current.topDisciplines.includes(program.discipline)) {
      current.topDisciplines = [...current.topDisciplines, program.discipline].slice(0, 3);
    }

    if (program.programName && !current.featuredPrograms.includes(program.programName)) {
      current.featuredPrograms = [...current.featuredPrograms, program.programName].slice(0, 2);
    }

    if (!current.schoolNameZh && program.schoolNameZh) {
      current.schoolNameZh = program.schoolNameZh;
    }

    const tuitionAmount = Number(program.tuitionAmount);
    if (Number.isFinite(tuitionAmount) && tuitionAmount > 0) {
      current.tuitionProjectCount += 1;
      current.tuitionMin =
        current.tuitionMin === null ? tuitionAmount : Math.min(current.tuitionMin, tuitionAmount);
      current.tuitionMax =
        current.tuitionMax === null ? tuitionAmount : Math.max(current.tuitionMax, tuitionAmount);

      if (!current.tuitionCurrency && program.tuitionCurrency) {
        current.tuitionCurrency = program.tuitionCurrency;
      }
    }
  });

  return Array.from(map.values()).sort((left, right) => {
    const leftRank = left.qsRank && left.qsRank > 0 ? left.qsRank : 999999;
    const rightRank = right.qsRank && right.qsRank > 0 ? right.qsRank : 999999;

    if (leftRank !== rightRank) {
      return leftRank - rightRank;
    }

    if (left.programCount !== right.programCount) {
      return right.programCount - left.programCount;
    }

    return left.schoolName.localeCompare(right.schoolName, "en-US");
  });
};

const initialUniversityMatches = buildUniversityMatches(initialResults);
const INITIAL_VISIBLE_SCHOOL_COUNT = compact ? 10 : 24;
const schoolMatchClientConfig = {
  seedResults,
  totalPrograms,
  initialUniversityMatches,
  initialVisibleSchoolCount: INITIAL_VISIBLE_SCHOOL_COUNT,
  specializationOptionsByMajor: STUDY_ABROAD_MAJOR_SPECIALIZATIONS,
  majorExpansionHints: STUDY_ABROAD_MAJOR_EXPANSIONS,
};
---

<section
  class:list={["school-match", compact && "school-match--compact"]}
  id={anchorId}
  data-school-match={finderId}
>
  <div class="school-match-head">
    <div>
      <div class="section-kicker">Official School Finder</div>
      <h3 class="school-match-title">先填条件，再点击开始搜索</h3>
      <p class="school-match-desc">
        搜索会先返回已核验的官方项目，再展示院校官网与项目页；你还可以继续点开“查看要求摘要”，系统会尝试从官方招生页里提取招生要求重点。
      </p>
    </div>

    <div class="school-match-source">
      <strong>数据说明</strong>
      <p>
        当前项目底库已同步 {totalPrograms} 个项目，覆盖 {countryOptions.length} 个国家 / 地区。项目链接均来自院校官网或美国官方项目数据，最近核对日期
        {latestCheckedAt || STUDY_ABROAD_DATA_UPDATED_AT}。
      </p>
    </div>
  </div>

  <div class="school-match-metrics">
    <article class="school-match-metric">
      <span>国家 / 地区</span>
      <strong>{countryOptions.length}</strong>
      <p>先定国家，再缩学校池和项目池。</p>
    </article>
    <article class="school-match-metric">
      <span>项目底库</span>
      <strong>{totalPrograms}</strong>
      <p>优先返回已核验项目，再补全网候选官网页。</p>
    </article>
    <article class="school-match-metric">
      <span>最近核对</span>
      <strong>{latestCheckedAt || STUDY_ABROAD_DATA_UPDATED_AT}</strong>
      <p>门槛字段会持续补抓并写回底库。</p>
    </article>
  </div>

  <div class="school-match-search-shell">
    <section class="school-match-search-card">
      <div class="school-match-search-head">
        <div>
          <div class="school-match-panel-kicker">Step 1</div>
          <h4>基础筛选</h4>
          <p>你可以直接写一句需求，或继续按国家、学位和方向细筛。</p>
        </div>
      </div>

      <div class="school-match-controls">
        <label class="school-match-field school-match-field--full">
          <span>一句话需求</span>
          <input
            data-role="free-text"
            type="text"
            inputmode="search"
            placeholder="例如：英国一年制商科硕士，GPA 3.5，偏商业分析"
          />
        </label>

        <label class="school-match-field">
          <span>意向国家</span>
          <select data-role="country">
            <option value="">全部国家 / 地区</option>
            {countryOptions.map((country) => (
              <option value={country}>{country}</option>
            ))}
          </select>
        </label>

        <label class="school-match-field">
          <span>学位类型</span>
          <select data-role="degree">
            <option value="">全部</option>
            <option value="本科">本科</option>
            <option value="硕士">硕士</option>
            <option value="博士">博士</option>
          </select>
        </label>

        <label class="school-match-field">
          <span>专业方向</span>
          <select data-role="major">
            <option value="">全部方向</option>
            {STUDY_ABROAD_MAJOR_GROUPS.map((group) => (
              <optgroup label={group.label}>
                {group.options.map((option) => (
                  <option value={option}>{option}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>

        <label class="school-match-field">
          <span>细分方向</span>
          <select data-role="specialization" disabled>
            <option value="">先选专业方向</option>
          </select>
        </label>
      </div>
    </section>

    <section class="school-match-search-card">
      <div class="school-match-search-head">
        <div>
          <div class="school-match-panel-kicker">Step 2</div>
          <h4>申请背景</h4>
          <p>预算和入学季会硬筛，GPA 和语言会先参与排序与背景判断。</p>
        </div>
      </div>

      <div class="school-match-profile">
        <label class="school-match-field">
          <span>预算上限</span>
          <select data-role="budget">
            <option value="">全部预算</option>
            <option value="under-30000">USD 30,000 以内</option>
            <option value="under-50000">USD 50,000 以内</option>
            <option value="under-70000">USD 70,000 以内</option>
            <option value="under-90000">USD 90,000 以内</option>
          </select>
        </label>

        <label class="school-match-field">
          <span>入学季</span>
          <select data-role="intake">
            <option value="">全部入学季</option>
            <option value="spring">春季</option>
            <option value="summer">夏季</option>
            <option value="fall">秋季</option>
            <option value="winter">冬季</option>
            <option value="rolling">滚动录取</option>
          </select>
        </label>

        <label class="school-match-field">
          <span>当前 GPA</span>
          <select data-role="gpa">
            <option value="">未填写</option>
            <option value="3.7+">3.7 及以上</option>
            <option value="3.5-3.69">3.5 - 3.69</option>
            <option value="3.3-3.49">3.3 - 3.49</option>
            <option value="3.0-3.29">3.0 - 3.29</option>
            <option value="under-3.0">3.0 以下</option>
          </select>
        </label>

        <label class="school-match-field">
          <span>语言成绩</span>
          <select data-role="language">
            <option value="">未填写</option>
            <option value="IELTS 6.5">IELTS 6.5</option>
            <option value="IELTS 7.0">IELTS 7.0</option>
            <option value="TOEFL 90">TOEFL 90</option>
            <option value="TOEFL 100">TOEFL 100</option>
            <option value="Duolingo 120">Duolingo 120</option>
            <option value="PTE 65">PTE 65</option>
          </select>
        </label>

        <label class="school-match-field">
          <span>背景策略</span>
          <select data-role="fit-mode">
            <option value="prefer">推荐排序</option>
            <option value="exclude-risk">排除明显偏紧</option>
            <option value="match-only">只看已确认匹配</option>
          </select>
        </label>

        <label class="school-match-field">
          <span>门槛质量</span>
          <select data-role="snapshot-quality">
            <option value="">全部项目</option>
            <option value="ready-only">只看门槛已入库</option>
            <option value="structured-only">只看有结构化门槛</option>
            <option value="synced-only">只看已同步门槛</option>
          </select>
        </label>
      </div>
    </section>
  </div>

  <div class="school-match-command-bar">
    <div class="school-match-toolbar">
      <button class="btn" type="button" data-role="search-button">
        开始搜索
      </button>
      <button class="btn btn-ghost" type="button" data-role="reset-button">
        恢复精选
      </button>
    </div>

    <div class="school-match-status" data-role="status">
      当前底库共有 {totalPrograms} 个项目，当前展示 {initialResults.length} 个优先样例。先选学位类型、专业方向、细分方向和学生背景，再点击“开始搜索”获取已核验结果。
    </div>

    <div class="school-match-status-grid" data-role="status-grid">
      <article class="school-match-status-card">
        <span>已核验项目</span>
        <strong data-role="status-verified">{initialResults.length}</strong>
        <p>优先展示可直接查看官网与要求摘要的正式结果。</p>
      </article>
      <article class="school-match-status-card">
        <span>全网候选官网页</span>
        <strong data-role="status-candidate">0</strong>
        <p data-role="status-candidate-note">未触发全网扩搜前，这里会保持为 0。</p>
      </article>
      <article class="school-match-status-card">
        <span>后台已规避</span>
        <strong data-role="status-blocked">0</strong>
        <p data-role="status-blocked-note">管理员判定不合格的结果会自动跳过。</p>
      </article>
    </div>

    <div class="school-match-expansion" data-role="expansion-panel" hidden>
      <div class="school-match-expansion-head">
        <strong data-role="expansion-title">当前结果偏少，建议这样放宽</strong>
        <p data-role="expansion-summary">
          系统会根据你当前的国家、学位和专业方向，给出几种最常见的放宽方式。
        </p>
      </div>
      <div class="school-match-expansion-actions" data-role="expansion-actions"></div>
    </div>

    <div class="school-match-intent" data-role="intent-panel" hidden>
      <div class="school-match-intent-head">
        <strong>系统识别到的搜索条件</strong>
        <p data-role="intent-summary">一句话需求会自动拆成国家、学位和方向，方便你继续微调。</p>
      </div>
      <div class="school-match-intent-chips" data-role="intent-chips"></div>
      <div class="school-match-intent-actions" data-role="intent-actions"></div>
    </div>

    <div class="school-match-quality" data-role="quality-panel" hidden>
      <div class="school-match-quality-head">
        <strong data-role="quality-title">这轮结果是这样排出来的</strong>
        <p data-role="quality-summary">系统会优先看专业匹配、门槛完整度和官网可核验度。</p>
      </div>
      <div class="school-match-quality-chips" data-role="quality-ranking-signals"></div>
      <div class="school-match-quality-chips school-match-quality-chips--soft" data-role="quality-intent-signals"></div>
      <div class="school-match-quality-note" data-role="quality-candidate-summary"></div>
      <ul class="school-match-quality-list" data-role="quality-next-steps"></ul>
    </div>

    <ul class="school-match-guidance school-match-guidance--inline">
      <li>预算和入学季只会筛掉已经补了对应字段的项目。</li>
      <li>GPA 和语言默认参与排序，严策略只作用于已抓到官网门槛的项目。</li>
      <li>前排缺失门槛的项目会继续在后台补抓，后续搜索会越来越完整。</li>
    </ul>
  </div>

  <div class="school-match-stack">
    <section class="school-match-block school-match-block--schools" data-role="schools-section">
      <div class="school-match-block-head">
        <div>
          <strong>学校池</strong>
          <p>先看命中的学校，再用排名、学费信息和项目状态继续缩小，最后点某所学校查看该校项目。</p>
        </div>
        <span class="school-match-badge" data-role="schools-count">
          {initialUniversityMatches.length} 所
        </span>
      </div>

      <div class="school-pool-refiners">
        <label class="school-match-field">
          <span>学校 / 城市关键词</span>
          <input
            data-role="school-keyword"
            type="text"
            inputmode="search"
            placeholder="例如 Boston、California、科技大学"
          />
        </label>

        <label class="school-match-field">
          <span>QS 排名</span>
          <select data-role="school-rank">
            <option value="">全部</option>
            <option value="top-50">QS 前 50</option>
            <option value="top-100">QS 前 100</option>
            <option value="top-200">QS 前 200</option>
            <option value="ranked">有 QS 排名</option>
          </select>
        </label>

        <label class="school-match-field">
          <span>学费信息</span>
          <select data-role="school-tuition">
            <option value="">全部</option>
            <option value="with-tuition">已补学费</option>
            <option value="under-30000">低于 USD 30,000</option>
            <option value="30000-50000">USD 30,000 - 50,000</option>
            <option value="50000-plus">USD 50,000+</option>
          </select>
        </label>

        <label class="school-match-field">
          <span>项目状态</span>
          <select data-role="school-availability">
            <option value="">全部</option>
            <option value="with-programs">已有项目层</option>
            <option value="catalog-only">仅学校底库</option>
          </select>
        </label>
      </div>

      <div class="school-pool" data-role="schools-results">
        <button class="school-pool-card is-active" type="button" data-university-id="">
          <div class="school-pool-top">
            <strong>全部院校</strong>
            <span>{initialResults.length} 个样例项目</span>
          </div>
          <p>先浏览当前优先样例，再输入国家或专业继续缩小。</p>
        </button>

        {initialUniversityMatches.map((school) => (
          <button class="school-pool-card" type="button" data-university-id={school.universityId}>
            <div class="school-pool-top">
              <strong>{school.schoolNameZh || school.schoolName}</strong>
              <span>{school.programCount} 个项目</span>
            </div>
            {school.schoolNameZh && school.schoolNameZh !== school.schoolName ? (
              <div class="school-pool-school-en">{school.schoolName}</div>
            ) : null}
            <div class="school-pool-meta">
              <span>{school.country}</span>
              {[school.city, school.stateOrProvince].filter(Boolean).join(", ") ? (
                <span>{[school.city, school.stateOrProvince].filter(Boolean).join(", ")}</span>
              ) : null}
              {school.qsRank && school.qsRank > 0 ? (
                <span>
                  QS {school.qsRankingYear || 2026}：#{school.qsRank}
                </span>
              ) : null}
              {school.tuitionProjectCount > 0 && school.tuitionMin ? (
                <span>
                  {school.tuitionCurrency || "USD"} {new Intl.NumberFormat("en-US").format(
                    Number(school.tuitionMin)
                  )}
                  {school.tuitionMax && Number(school.tuitionMax) > Number(school.tuitionMin)
                    ? ` - ${new Intl.NumberFormat("en-US").format(Number(school.tuitionMax))}`
                    : ""}{" "}
                  起
                </span>
              ) : null}
            </div>
            <p>
              {school.topDisciplines.join(" · ") ||
                (school.programCount > 0 ? "点击后查看该校项目" : "已进入学校底库，项目层持续补充中")}
            </p>
          </button>
        ))}
      </div>

      <div class="school-pool-toolbar" data-role="schools-toolbar">
        <button class="btn btn-ghost" type="button" data-role="schools-more" hidden>
          展开更多院校
        </button>
      </div>

      <div class="school-summary" data-role="school-summary" hidden>
        <div class="school-summary-head">
          <div>
            <div class="school-summary-kicker">School Snapshot</div>
            <h4 data-role="school-summary-title">院校概要</h4>
            <div class="school-summary-subtitle" data-role="school-summary-subtitle"></div>
